# 数据库配置
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_password_here
DB_NAME=your_database_name

# 微信小程序配置
WX_APPID=your_appid_here
WX_SECRET=your_appsecret_here

# 微信 API 地址
WX_API_BASE=http://api.weixin.qq.com

# 订阅消息后台任务（容器至少保留 1 个运行实例）
ENABLE_NOTIFICATION_SCHEDULER=1
NOTIFICATION_INTERVAL_SECONDS=60
WX_MINIPROGRAM_STATE=formal
WX_TEMPLATE_BLACKLIST=W9zXWifqlQNq3Gv0tE3WQZwJfvpV8HZ6R8ibU7wU1Ys
WX_TEMPLATE_LOTTERY_START=VsSKdYZduCzOk5WDINXNy0rkMX-MGcjFhg-KIgK_koY
WX_TEMPLATE_ACTIVITY_REMINDER=VYfqV2moc2_YVzFvcHUsSgKSg7gKiPklfXRoLJAx7EU
WX_TEMPLATE_PENDING_APPROVAL=XSdbgcKEQ30i8_FsciyuHbyfSXDy6VodbW-9cKqoIac

# 心知天气 API Key
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_FORECAST_DAYS=3

# 默认头像云存储 URL
DEFAULT_AVATAR=cloud://your-env-id.xxxx-your-env-id-xxxxxx/default-avatar.png

# Flask 配置
FLASK_DEBUG=1
