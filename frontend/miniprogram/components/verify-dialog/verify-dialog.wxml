<view class="custom-dialog" wx:if="{{show}}" catchtouchmove="preventTouchMove">
  <view class="dialog-mask"></view>
  <view class="dialog-container">
    <view class="dialog-title">验证问题</view>
    <image class="dialog-image" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/verify.png" mode="widthFix" />
    <view class="dialog-content">
      <view class="question">{{question || '兽妈准备宵夜是？'}}</view>
      <input 
        class="dialog-input" 
        type="text" 
        placeholder="请输入答案" 
        value="{{answer}}" 
        bindinput="onInput" 
        focus="{{autoFocus}}" 
        confirm-type="done" 
        bindconfirm="onConfirm"
        disabled="{{loading}}"
      />
      <view class="error-tip" wx:if="{{error}}">{{error}}</view>
    </view>
    <view class="dialog-buttons">
      <view class="dialog-btn dialog-btn-confirm" bindtap="onConfirm">
        {{loading ? '验证中...' : '确认'}}
      </view>
    </view>
  </view>
</view>
