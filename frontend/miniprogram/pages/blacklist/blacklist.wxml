<view class="container">
  <!-- 说明 -->
  <!-- <view class="tip-card">
    <van-icon name="warning-o" size="14px" color="#ff9800" />
    <text>被拉黑的用户无法使用小程序。解封后将重置答错次数，用户可重新答题验证，通过后恢复正常使用。</text>
  </view> -->

  <!-- 黑名单列表 -->
  <view class="list-section">
    <view class="section-header">
      <text class="section-title">黑名单用户（{{total}}人）</text>
    </view>

    <view wx:if="{{isLoading}}" class="loading-container">
      <van-loading size="40px" vertical>加载中...</van-loading>
    </view>

    <view wx:elif="{{userList.length === 0}}" class="empty-container">
      <van-icon name="passed" size="80" color="#ccc" />
      <text class="empty-text">暂无黑名单用户</text>
    </view>

    <view wx:else>
      <view wx:for="{{userList}}" wx:key="openId" class="user-card">
        <view class="card-main">
          <image class="user-avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill" lazy-load />
          <view class="user-info">
            <text class="user-name">{{item.nickName || '匿名用户'}}</text>
            <view class="user-meta">
              <text class="meta-item" wx:if="{{item.wechatId}}">微信号：{{item.wechatId}}</text>
              <text class="meta-item">答错次数：{{item.verifyAttempts || 0}}次</text>
            </view>
            <view wx:if="{{item.lastLoginTime && item.lastLoginTime !== '-'}}" class="user-time">
              <text class="time-label">最近登录：</text>
              <text class="time-value">{{item.lastLoginTime}}</text>
            </view>
            <view wx:if="{{item.createTime && item.createTime !== '-'}}" class="user-time">
              <text class="time-label">注册时间：</text>
              <text class="time-value">{{item.createTime}}</text>
            </view>
          </view>
        </view>

        <view class="card-bottom">
          <van-button 
            class="unblock-btn" 
            type="warning" 
            size="small" 
            loading="{{item.isUnblocking}}" 
            bindtap="onUnblock" 
            data-openid="{{item.openId}}"
          >
            解封
          </van-button>
        </view>
      </view>
    </view>
  </view>
</view>
