page {
  background-color: #e6f7ff;
}

.container {
  display: block;
  padding: 16px;
  padding-bottom: 40px;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  background-color: #fff7e6;
  border: 1px solid #ffe7ba;
  border-radius: 12px;
  padding: 12px 14px;
  margin-bottom: 16px;
  font-size: 13px;
  color: #d48806;
  line-height: 1.5;
}

/* 列表 */
.list-section {
  margin-bottom: 20px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding: 0 4px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
  position: relative;
  padding-left: 12px;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4px;
  bottom: 4px;
  width: 4px;
  background-color: #5faee3;
  border-radius: 4px;
}

/* 加载/空状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60px 0;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60px 0;
}

.empty-text {
  color: #7a9ec2;
  font-size: 14px;
  margin-top: 16px;
}

/* 用户卡片 */
.user-card {
  background-color: white;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-main {
  display: flex;
  gap: 12px;
  margin-bottom: 12px;
}

.user-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #e8f0f8;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 16px;
  font-weight: 600;
  color: #1e4d7c;
  display: block;
  margin-bottom: 6px;
  word-break: break-all;
}

.user-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 4px;
}

.meta-item {
  font-size: 13px;
  color: #7a9ec2;
}

.user-time {
  display: flex;
  align-items: center;
  font-size: 12px;
  color: #9fb8d4;
  margin-top: 4px;
}

.time-label {
  flex-shrink: 0;
}

.time-value {
  word-break: break-all;
}

/* 卡片底部 */
.card-bottom {
  display: flex;
  justify-content: flex-end;
  padding-top: 10px;
  border-top: 1px solid #e8f0f8;
}

.unblock-btn {
  border-radius: 8px !important;
  min-width: 80px;
}
