.lottery-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.lottery-popup { position: fixed; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 320px; background: #fff; border: 1px solid rgba(157, 191, 214, 0.3); border-radius: 20px; box-shadow: 0 14px 34px rgba(38, 78, 106, 0.2); z-index: 101; overflow: hidden; }
.popup-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #f0f0f0; }
.popup-title { font-size: 16px; font-weight: 600; color: #1e4d7c; }
.popup-body { padding: 24px 20px; text-align: center; }
.lottery-icon { font-size: 48px; margin-bottom: 12px; }
.lottery-tip { font-size: 16px; color: #333; font-weight: 500; display: block; margin-bottom: 4px; }
.lottery-name { font-size: 14px; color: #5faee3; display: block; margin-bottom: 8px; }
.time-info { font-size: 12px; color: #999; margin-bottom: 16px; }
.popup-prize-scroll { width: 100%; margin: -4px 0 14px; white-space: nowrap; }
.popup-prize-list { display: inline-flex; gap: 10px; }
.popup-prize-item { display: inline-flex; width: 70px; flex-direction: column; align-items: center; }
.popup-prize-image, .popup-prize-placeholder { width: 60px; height: 60px; border-radius: 12px; background: #eef7fd; }
.popup-prize-placeholder { display: flex; align-items: center; justify-content: center; font-size: 26px; }
.popup-prize-name, .popup-prize-count { overflow: hidden; width: 100%; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.popup-prize-name { margin-top: 5px; color: #315f83; font-size: 11px; font-weight: 600; }
.popup-prize-count { color: #9aabba; font-size: 10px; }
.password-input { border: 1px solid #d8e8f5; border-radius: 10px; padding: 10px 16px; font-size: 15px; text-align: center; margin-bottom: 8px; }
.error-tip { color: #ff6b6b; font-size: 12px; display: block; min-height: 16px; }
.attempts-tip { color: #ff8800; font-size: 12px; }
.popup-footer { padding: 0 20px 20px; }
.draw-btn, .close-btn { display: flex; height: 44px; padding: 0; align-items: center; justify-content: center; border: none; border-radius: 24px; box-sizing: border-box; font-size: 15px; line-height: 1; }
.draw-btn::after, .close-btn::after { display: none; }
.draw-btn { background: #5faee3; color: #fff; }
.close-btn { background: #f0f7ff; color: #5faee3; }
.drawing { padding: 40px 0; text-align: center; }
.spinner { width: 36px; height: 36px; border: 3px solid #e0e8f0; border-top: 3px solid #5faee3; border-radius: 50%; margin: 0 auto 12px; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.drawing-text { font-size: 14px; color: #999; }
.result-body { padding: 32px 20px; }
.result-prize-image { display: block; width: 128px; height: 128px; margin: 0 auto 14px; border-radius: 18px; box-shadow: 0 8px 20px rgba(46, 91, 122, 0.15); }
.result-icon { font-size: 56px; margin-bottom: 12px; }
.result-text { font-size: 22px; font-weight: 700; display: block; margin-bottom: 8px; }
.win-text { color: #ff6b6b; }
.lose-text { color: #999; }
.result-activity { font-size: 13px; color: #999; }
