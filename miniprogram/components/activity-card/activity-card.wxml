<view class="activity-card {{isEnded ? 'ended-card' : ''}} {{activity.is_official == 1 ? 'official-activity' : ''}}" bindtap="onClick">
  <text class="official-corner" wx:if="{{activity.is_official == 1}}">官方</text>
  <view class="card-left">
    <image 
      class="cover-image {{isEnded ? 'ended-cover' : ''}}" 
      src="{{activity.cover_url || ''}}" 
      mode="aspectFill"
      wx:if="{{activity.cover_url}}"
    />
    <view class="default-cover" wx:else>
      <van-icon name="photo-o" size="40" color="#ccc" />
    </view>
  </view>
  <view class="card-right">
    <view class="activity-name {{isEnded ? 'ended-name' : ''}} {{activity.is_official == 1 ? 'has-official-corner' : ''}}">
      {{activity.name}}
      <text wx:if="{{!_isEnded}}" class="status-badge {{activity.has_registered ? 'registered-badge' : _statusClass}}">{{_statusBadge}}</text>
      <text wx:else class="status-badge ended">{{_statusBadge}}</text>
    </view>
    <view class="info-row">
      <view class="info-item">
        <van-icon name="clock-o" />
        <text>{{_time}}</text>
      </view>
      <view class="info-item">
        <van-icon name="location-o" />
        <text>{{activity.location}}</text>
      </view>
    </view>
    <view class="info-row" wx:if="{{!_isEnded}}">
      <view class="info-item">
        <van-icon name="user-o" />
        <text class="remain-count {{_remainCount < 5 ? 'warning' : ''}}">{{_remainCount}}/{{_totalCount}} 剩余</text>
      </view>
      <text class="tag-difficulty">{{_difficulty}}</text>
    </view>
  </view>
</view>
