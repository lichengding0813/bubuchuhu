/* 活动卡片 */
.activity-card {
  display: flex;
  background-color: white;
  border-radius: 18px;
  margin-bottom: 14px;
  padding: 14px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
  position: relative;
}

.official-corner {
  position: absolute;
  top: 9px;
  right: 9px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 3px 8px 3px 4px;
  border: 1px solid rgba(95, 174, 227, 0.3);
  border-radius: 14px;
  color: #347ba9;
  background: rgba(245, 251, 255, 0.96);
  font-size: 11px;
  font-weight: 600;
  box-shadow: 0 3px 9px rgba(42, 113, 163, 0.1);
}

.official-mascot {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
}

.activity-name.has-official-corner {
  margin-right: 60px;
}

.ended-card {
  opacity: 0.75;
}

.card-left {
  flex: 0 0 80px;
  height: 80px;
  border-radius: 14px;
  background-color: #b7daf9;
  margin-right: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.ended-cover {
  filter: grayscale(30%);
}

.default-cover {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.activity-name {
  font-size: 16px;
  font-weight: 600;
  color: #134579;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.activity-title-text {
  flex: 1;
  min-width: 0;
}

.ended-name {
  color: #666;
}

.status-badge {
  display: inline-block;
  background-color: #ffe1c6;
  color: #b45200;
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 30px;
  font-weight: 500;
  margin-left: 8px;
  white-space: nowrap;
}

.status-badge.ongoing {
  background-color: #c7e3ff;
  color: #1f64a5;
}

.status-badge.registered-badge {
  background-color: #d9f5d9;
  color: #2e7d32;
}

.status-badge.closed {
  background-color: #ffcece;
  color: #b13e3e;
}

.status-badge.ended {
  background-color: #e8e8e8;
  color: #888;
}

.info-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  font-size: 12px;
  color: #5f7fa3;
  margin-bottom: 6px;
}

.info-item {
  display: flex;
  align-items: center;
  margin-right: 14px;
  margin-bottom: 4px;
}

.info-item van-icon {
  margin-right: 3px;
  font-size: 13px;
  color: #77b0e0;
}

.tag-difficulty {
  background-color: #e3f0ff;
  padding: 2px 10px;
  border-radius: 30px;
  font-size: 11px;
  color: #1e66a0;
  margin-right: 8px;
}

.remain-count {
  font-weight: 500;
  color: #2580c2;
}

.remain-count.warning {
  color: #ff6b6b;
  font-weight: 500;
}

.participant-count {
  color: #5f7fa3;
  font-weight: 500;
}
