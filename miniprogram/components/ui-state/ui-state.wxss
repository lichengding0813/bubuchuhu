.state { min-height: 340rpx; padding: 48rpx 24rpx; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #829bab; }
.compact { min-height: 160rpx; padding: 24rpx; }
.message { margin-top: 20rpx; font-size: 26rpx; line-height: 1.6; text-align: center; }
.retry { min-width: 160rpx; margin: 24rpx 0 0; padding: 0 28rpx; line-height: 72rpx; font-size: 26rpx; color: #fff; background: #4baadd; border-radius: 18rpx; }
.retry::after { border: 0; }
