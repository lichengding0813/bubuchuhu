/* 黑名单全屏遮罩 */
.blacklist-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 999;
  pointer-events: auto;
}

/* 弹窗样式 */
.custom-dialog {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.dialog-container {
  position: relative;
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(30, 110, 180, 0.3);
  z-index: 1001;
}

.dialog-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1e4d7c;
  text-align: center;
}

.dialog-content {
  padding: 0 32rpx 24rpx;
  align-items: center;
}

.plain-text {
  font-size: 28rpx;
  color: #2e5a8a;
  text-align: center;
  padding: 20rpx 0;
}

.dialog-buttons {
  display: flex;
  border-top: 2rpx solid #d9ecff;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.dialog-btn-confirm {
  color: #ffffff;
  background-color: #5faee3;
}

.dialog-btn-confirm:active {
  background-color: #4a9ad0;
}
