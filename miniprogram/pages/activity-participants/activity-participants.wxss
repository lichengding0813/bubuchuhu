/* pages/activity-participants/activity-participants.wxss */
page {
  background-color: #e6f7ff;
  height: 100%;
  overflow-y: auto;
}

.participants-container {
  padding-bottom: 30px;
}

/* 统计卡片区域 */
.stats-section {
  display: flex;
  padding: 32px 16px;
  gap: 12px;
  margin-bottom: 16px;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #ffffff 0%, #f5faff 100%);
  border-radius: 16px;
  padding: 16px;
  text-align: center;
  box-shadow: 0 4px 12px rgba(0, 110, 200, 0.08);
  border: 1px solid rgba(95, 174, 227, 0.2);
}

.stat-number {
  font-size: 28px;
  font-weight: bold;
  color: #5faee3;
  line-height: 1.2;
}

.stat-label {
  font-size: 13px;
  color: #7a9ec2;
  margin-top: 8px;
}

/* 列表区域 */
.list-section {
  padding: 0 16px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12px;
  padding: 0 4px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
  position: relative;
  padding-left: 12px;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4px;
  bottom: 4px;
  width: 4px;
  background-color: #5faee3;
  border-radius: 4px;
}

.total-badge {
  font-size: 13px;
  color: #5faee3;
  background-color: #e3f0ff;
  padding: 4px 12px;
  border-radius: 20px;
}

/* 加载/空状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60px 0;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
}

.empty-text {
  color: #7a9ec2;
  font-size: 14px;
  margin-top: 16px;
}

/* 人员卡片 */
.participant-card {
  background-color: white;
  border-radius: 18px;
  margin-bottom: 14px;
  padding: 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e8f0f8;
}

.user-info {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 12px;
}

.companion-badge {
  background-color: #e3f0ff;
  color: #5faee3;
  font-size: 12px;
  font-weight: 500;
  padding: 4px 10px;
  border-radius: 20px;
  white-space: nowrap;
}

.participant-card-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 8px;
}

.manage-btn {
  display: flex;
  height: 30px;
  align-items: center;
  justify-content: center;
  padding: 0 12px;
  border-radius: 15px;
  font-size: 12px;
  line-height: 1;
}

.manage-btn.cancel {
  color: #d45d5d;
  background: #fff2f2;
}

.manage-btn.restore {
  color: #2f79aa;
  background: #e9f5fc;
}

.manage-btn.disabled {
  opacity: 0.45;
}

.avatar van-icon {
  display: block;
  background-color: #f0f9ff;
  border-radius: 50%;
  padding: 4px;
}

.user-detail {
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 4px;
}

.nickname {
  font-size: 16px;
  font-weight: 600;
  color: #134579;
}

.join-time {
  font-size: 12px;
  color: #7a9ec2;
}

/* 卡片内容 */
.card-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.info-row {
  display: flex;
  align-items: center;
  font-size: 13px;
  color: #5f7fa3;
  gap: 8px;
}

.info-row van-icon {
  font-size: 14px;
  color: #77b0e0;
  width: 20px;
  flex-shrink: 0;
}

.info-row text {
  flex: 1;
  word-break: break-all;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20px 0;
  color: #7a9ec2;
  font-size: 14px;
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  overflow: hidden;
  background-color: #e3f0ff;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* ====== 已取消报名折叠区 ====== */
.cancelled-section {
  margin-top: 24px;
}

.cancelled-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background-color: #f5f5f5;
  border-radius: 12px;
  margin-bottom: 8px;
}

.cancelled-title {
  font-size: 14px;
  color: #999;
  font-weight: 500;
}

/* 已取消卡片样式 */
.cancelled-card {
  background-color: #fafafa;
  border: 1px dashed #d0d0d0;
  opacity: 0.75;
}

.cancelled-avatar {
  filter: grayscale(1);
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cancelled-nickname {
  color: #999 !important;
}

.cancelled-tag {
  font-size: 11px;
  color: #fff;
  background-color: #bbb;
  padding: 2px 8px;
  border-radius: 10px;
  white-space: nowrap;
}

.cancelled-time {
  color: #bbb !important;
}

.cancelled-info {
  color: #aaa !important;
}

.cancelled-info van-icon {
  color: #ccc !important;
}

.managed-cancelled-header {
  background: #edf5fa;
}

.managed-cancelled-title {
  color: #55758d;
}

.managed-cancelled-card {
  border-color: #bfd5e4;
  background: #f7fbfd;
  opacity: 1;
}

.managed-cancelled-tag {
  background: #7899af;
}
