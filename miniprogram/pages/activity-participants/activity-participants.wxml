<!-- 活动报名人员列表 -->
<view class="participants-container">
  <!-- 顶部统计卡片 -->
  <view class="stats-section">
    <view class="stat-card">
      <view class="stat-number">{{totalOccupied}}</view>
      <view class="stat-label">实际占用名额</view>
    </view>
    <view class="stat-card">
      <view class="stat-number">{{activeCount}}</view>
      <view class="stat-label">有效报名人数</view>
    </view>
  </view>

  <!-- 列表区域 -->
  <view class="list-section">
    <view class="section-header">
      <text class="section-title">报名人员列表</text>
      <view class="total-badge">共 {{totalOccupied}} 人（含同行）</view>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{isLoading}}" class="loading-container">
      <van-loading size="40px" vertical>加载中...</van-loading>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{activeParticipants.length === 0 && cancelledParticipants.length === 0}}" class="empty-container">
      <van-icon name="user-o" size="80" color="#ccc" />
      <text class="empty-text">暂无报名人员</text>
    </view>

    <view wx:else>
      <!-- 有效报名人员卡片 -->
      <view wx:for="{{activeParticipants}}" wx:key="id" class="participant-card">
        <view class="card-header">
          <view class="user-info">
            <view class="avatar">
              <image class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
            </view>
            <view class="user-detail">
              <text class="nickname">{{item.nickname || '未知用户'}}</text>
              <text class="join-time">报名时间：{{item.created_at_formatted}}</text>
            </view>
          </view>
          <view class="companion-badge" wx:if="{{item.companion_count > 0}}">
            +{{item.companion_count}}同行
          </view>
        </view>

        <view class="card-content">
          <view class="info-row" wx:if="{{item.companion_count > 0}}">
            <van-icon name="friends-o" />
            <text>同行人数：{{item.companion_count}}人（不含本人）</text>
          </view>
          <view class="info-row" wx:if="{{item.phone}}">
            <van-icon name="phone-o" />
            <text>手机号：{{item.phone}}</text>
          </view>
          <view class="info-row" wx:if="{{item.wechat_id}}">
            <van-icon name="wechat" />
            <text>微信号：{{item.wechat_id}}</text>
          </view>
          <view class="info-row" wx:if="{{item.travel_option}}">
            <van-icon name="flag-o" />
            <text>出行方式：{{item.travel_option_text}}</text>
          </view>
          <view class="info-row" wx:if="{{item.remark}}">
            <van-icon name="comment-o" />
            <text>备注：{{item.remark}}</text>
          </view>
        </view>
      </view>

      <!-- 已取消报名（折叠区） -->
      <view wx:if="{{cancelledParticipants.length > 0}}" class="cancelled-section">
        <view class="cancelled-header" bindtap="toggleCancelled">
          <text class="cancelled-title">已取消报名（{{cancelledParticipants.length}}人）</text>
          <van-icon name="{{showCancelled ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#999" />
        </view>

        <block wx:if="{{showCancelled}}">
          <view wx:for="{{cancelledParticipants}}" wx:key="id" class="participant-card cancelled-card">
            <view class="card-header">
              <view class="user-info">
                <view class="avatar cancelled-avatar">
                  <image class="avatar-image" src="{{item.avatarUrl}}" mode="aspectFill"></image>
                </view>
                <view class="user-detail">
                  <view class="nickname-row">
                    <text class="nickname cancelled-nickname">{{item.nickname || '未知用户'}}</text>
                    <text class="cancelled-tag">已取消</text>
                  </view>
                  <text class="join-time cancelled-time">报名时间：{{item.created_at_formatted}}</text>
                </view>
              </view>
            </view>

            <view class="card-content" wx:if="{{item.companion_count > 0 || item.phone || item.wechat_id || item.remark}}">
              <view class="info-row cancelled-info" wx:if="{{item.companion_count > 0}}">
                <van-icon name="friends-o" />
                <text>同行人数：{{item.companion_count}}人</text>
              </view>
              <view class="info-row cancelled-info" wx:if="{{item.phone}}">
                <van-icon name="phone-o" />
                <text>手机号：{{item.phone}}</text>
              </view>
              <view class="info-row cancelled-info" wx:if="{{item.wechat_id}}">
                <van-icon name="wechat" />
                <text>微信号：{{item.wechat_id}}</text>
              </view>
              <view class="info-row cancelled-info" wx:if="{{item.remark}}">
                <van-icon name="comment-o" />
                <text>备注：{{item.remark}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
