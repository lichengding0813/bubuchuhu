/* 审核详情复用用户详情页样式，后续两处视觉会保持同步。 */
@import "../details/details.wxss";

.audit-route-card {
  margin-bottom: 150rpx;
}

.bottom-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  gap: 16px;
  padding: 12px 16px;
  padding-bottom: calc(12px + constant(safe-area-inset-bottom));
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  border-top: 1px solid #dcecf7;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -4px 16px rgba(42, 97, 138, 0.08);
  box-sizing: border-box;
}

.audit-action {
  display: flex;
  height: 46px;
  flex: 1;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 24px;
  font-size: 16px;
  font-weight: 600;
  line-height: 1;
}

.audit-action--approve {
  color: #ffffff;
  background: linear-gradient(135deg, #62b3e8 0%, #327fbd 100%);
  box-shadow: 0 6px 14px rgba(50, 127, 189, 0.2);
}

.audit-action--reject {
  border: 1px solid #efb4b4;
  color: #d65b5b;
  background: #ffffff;
}

.audit-action--pressed {
  opacity: 0.82;
  transform: scale(0.99);
}

.audit-action--disabled {
  opacity: 0.55;
}

.reject-reason-section {
  margin: 16px;
  margin-bottom: 80px;
}

.reject-reason-card {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 16px;
  border: 1px solid #f3cccc;
  border-radius: 16px;
  background: #fff7f7;
}

.reject-reason-title,
.reject-reason-text {
  color: #c94f4f;
  font-size: 14px;
  line-height: 1.5;
}

.reject-reason-title {
  flex-shrink: 0;
  font-weight: 600;
}

.reject-reason-text {
  flex: 1;
}

.custom-dialog {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 35, 50, 0.48);
}

.dialog-container {
  position: relative;
  z-index: 1001;
  width: 600rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(30, 90, 130, 0.2);
}

.dialog-title {
  padding: 28rpx 32rpx 12rpx;
  color: #16466d;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.dialog-content {
  padding: 12rpx 32rpx 28rpx;
}

.reject-tip {
  margin-bottom: 16rpx;
  color: #5f7fa3;
  font-size: 27rpx;
}

.reject-textarea {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 2rpx solid #d7e9f5;
  border-radius: 18rpx;
  background: #f7fbfe;
  color: #1e3e60;
  font-size: 28rpx;
}

.char-count {
  margin-top: 8rpx;
  color: #91a9bb;
  font-size: 23rpx;
  text-align: right;
}

.dialog-buttons {
  display: flex;
  border-top: 2rpx solid #e2edf5;
}

.dialog-btn {
  display: flex;
  height: 92rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.dialog-btn-cancel {
  border-right: 2rpx solid #e2edf5;
  color: #7890a5;
  background: #ffffff;
}

.dialog-btn-confirm {
  color: #ffffff;
  background: linear-gradient(135deg, #62b3e8 0%, #327fbd 100%);
}
