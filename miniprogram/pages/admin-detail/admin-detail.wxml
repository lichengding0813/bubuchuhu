<view class="detail-container">
  <view class="cover-section">
    <image class="cover-image" src="{{activityDetail.cover}}" mode="aspectFill" bindtap="previewCoverImage" data-src="{{activityDetail.cover}}"></image>
    <view class="cover-tag" wx:if="{{activityDetail.status}}">{{activityDetail.status}}</view>
  </view>

  <view class="info-card">
    <view class="activity-title-row">
      <view class="activity-title activity-title-with-brand">
        <text class="activity-title-text">{{activityDetail.name}}</text>
      </view>
      <view class="official-title-badge official-chip" wx:if="{{activityDetail.isOfficial}}">
        <image class="official-mascot official-mascot--tiny" src="/images/official-badge.png" mode="aspectFit" />
        <text>官方</text>
      </view>
    </view>
    <view class="activity-meta">
      <view class="meta-item">
        <van-icon name="clock-o" />
        <text>{{activityDetail.time}}<text wx:if="{{activityDetail.endTime}}"> 至 {{activityDetail.endTime}}</text></text>
      </view>
      <view class="meta-item {{activityDetail.latitude != null ? 'clickable-location' : ''}}" bindtap="openActivityLocation">
        <van-icon name="location-o" />
        <text>{{activityDetail.location}}</text>
      </view>
    </view>
    <view class="insurance-badge">
      <van-icon name="certificate" />
      <text class="insurance-label">需要购买保险：</text>
      <text class="insurance-value {{activityDetail.is_force_insurance === 1 ? 'mandatory' : 'optional'}}">{{activityDetail.is_force_insurance === 1 ? '是' : '否'}}</text>
    </view>
    <view class="activity-weather-row" wx:if="{{weatherLoading || (weather.daily && weather.daily.length > 0)}}">
      <view class="activity-weather-loading" wx:if="{{weatherLoading}}">
        <van-loading size="16px">天气加载中...</van-loading>
      </view>
      <block wx:else>
        <view class="activity-weather-icon"><text class="weather-emoji">{{weather.daily[0].emoji}}</text></view>
        <view class="activity-weather-copy">
          <text class="activity-weather-label">{{weather.daily[0].dateLabel}} · {{weather.city}}</text>
          <text class="activity-weather-text">{{weather.daily[0].text_day}}</text>
        </view>
        <text class="activity-weather-temp">{{weather.daily[0].low}}℃ ~ {{weather.daily[0].high}}℃</text>
      </block>
    </view>
    <view class="activity-stats">
      <view class="stat-item"><text class="stat-label">难度</text><text class="stat-value">{{activityDetail.difficulty}}</text></view>
      <view class="stat-item"><text class="stat-label">里程</text><text class="stat-value">{{activityDetail.distance}}km</text></view>
      <view class="stat-item"><text class="stat-label">爬升</text><text class="stat-value">{{activityDetail.climb}}m</text></view>
      <view class="stat-item">
        <text class="stat-label">{{activityDetail.rawStatus === 4 ? '参与人数' : '剩余名额'}}</text>
        <text class="stat-value">{{activityDetail.rawStatus === 4 ? activityDetail.participantCount + '人' : activityDetail.remainCount + '/' + activityDetail.totalCount}}</text>
      </view>
    </view>
  </view>

  <view class="info-card">
    <view class="card-title">发起人信息</view>
    <view class="organizer-info">
      <view class="organizer-avatar-wrap">
        <view class="organizer-avatar"><image src="{{activityDetail.creatorAvatar}}" mode="aspectFill"></image></view>
        <image class="organizer-avatar-v" wx:if="{{activityDetail.isOfficial}}" src="/images/official-badge.png" mode="aspectFit" />
      </view>
      <view class="organizer-detail">
        <view class="organizer-name-row"><text class="organizer-name">{{activityDetail.organizer}}</text></view>
        <text class="organizer-wechat">微信号：{{activityDetail.wechat}}</text>
      </view>
    </view>
    <view class="qr-section" wx:if="{{activityDetail.groupQR}}">
      <view class="qr-item">
        <text class="qr-label">活动群（点击查看）</text>
        <image class="qr-image" src="{{activityDetail.groupQR}}" mode="aspectFill" bindtap="previewQRCode" data-url="{{activityDetail.groupQR}}"></image>
      </view>
    </view>
  </view>

  <view class="info-card">
    <view class="card-title">活动详情</view>
    <view class="travel-options">
      <view class="travel-tag" wx:for="{{activityDetail.travel}}" wx:key="*this">
        <text wx:if="{{item === 'bus'}}">🚌 大巴</text>
        <text wx:elif="{{item === 'train'}}">🚄 高铁</text>
        <text wx:elif="{{item === 'self'}}">🚗 自驾</text>
      </view>
    </view>
    <view class="detail-content"><text class="detail-text">{{activityDetail.description}}</text></view>
  </view>

  <view class="info-card audit-route-card">
    <view class="card-title">路线信息</view>
    <view class="route-info"><rich-text class="route-text" nodes="{{activityDetail.route}}"></rich-text></view>
    <view class="meeting-points-section" wx:if="{{activityDetail.meetingPoints && activityDetail.meetingPoints.length > 0}}">
      <view class="section-subtitle">集合点信息</view>
      <view class="meeting-points-list">
        <view class="meeting-point-item" wx:for="{{activityDetail.meetingPoints}}" wx:key="_key" wx:for-index="idx">
          <view class="meeting-point-order">集合点 {{idx + 1}}</view>
          <view class="meeting-point-detail">
            <view class="meeting-point-time"><van-icon name="clock-o" size="14px" /><text>{{item.meeting_time || item.time}}</text></view>
            <view class="meeting-point-location {{item.latitude != null ? 'clickable-location' : ''}}" bindtap="openMeetingLocation" data-index="{{idx}}">
              <van-icon name="location-o" size="14px" /><text>{{item.location}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="route-meta"><text>报名截止：{{activityDetail.deadline}}</text></view>
  </view>

  <view class="bottom-actions" wx:if="{{activityDetail.rawStatus === 0}}">
    <view class="audit-action audit-action--reject {{reviewing ? 'audit-action--disabled' : ''}}" hover-class="audit-action--pressed" aria-role="button" aria-label="驳回活动" bindtap="onRejectClick">驳回</view>
    <view class="audit-action audit-action--approve {{reviewing ? 'audit-action--disabled' : ''}}" hover-class="audit-action--pressed" aria-role="button" aria-label="通过活动" bindtap="onApproveClick">通过</view>
  </view>

  <view class="reject-reason-section" wx:elif="{{activityDetail.rawStatus === 2 && activityDetail.reject_reason}}">
    <view class="reject-reason-card">
      <van-icon name="warning-o" size="20" color="#d65b5b" />
      <text class="reject-reason-title">驳回原因：</text>
      <text class="reject-reason-text">{{activityDetail.reject_reason}}</text>
    </view>
  </view>

  <view class="custom-dialog" wx:if="{{showRejectDialog}}">
    <view class="dialog-mask" catchtouchmove="preventTouchMove"></view>
    <view class="dialog-container">
      <view class="dialog-title">驳回活动</view>
      <view class="dialog-content">
        <view class="reject-tip">请填写驳回原因：</view>
        <textarea class="reject-textarea" placeholder="请输入驳回原因（选填）" value="{{rejectReason}}" bindinput="onRejectReasonInput" maxlength="200" auto-focus />
        <view class="char-count">{{rejectReason.length}}/200</view>
      </view>
      <view class="dialog-buttons">
        <view class="dialog-btn dialog-btn-cancel" bindtap="cancelReject">取消</view>
        <view class="dialog-btn dialog-btn-confirm" bindtap="confirmReject">确认驳回</view>
      </view>
    </view>
  </view>
</view>
