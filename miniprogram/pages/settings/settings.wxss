/* pages/settings/settings.wxss */
page {
  background-color: #f0faff;
}

.settings-container {
  min-height: 100vh;
  padding-bottom: 30px;
  background-color: #f4f8fb;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  padding-top: calc(12px + constant(safe-area-inset-top));
  padding-top: calc(12px + env(safe-area-inset-top));
  background-color: #f4f8fb;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 0;
  color: #1e4d7c;
  font-size: 16px;
}

.back-btn van-icon {
  margin-right: 4px;
  font-size: 18px;
}

.nav-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
}

.placeholder {
  width: 60px;
}

/* 表单卡片 */
.form-card {
  background-color: white;
  border-radius: 20px;
  padding: 20px 16px;
  margin: 16px 16px 0 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: #1e4d7c;
  margin-bottom: 20px;
  padding-left: 8px;
  border-left: 4px solid #96c9ff;
}

/* 头像设置 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px 0;
}

.avatar-image {
  width: 100px;
  height: 100px;
  border-radius: 50px;
  background-color: #e3f0ff;
  border: 3px solid #96c9ff;
  margin-bottom: 12px;
}

.avatar-edit {
  display: flex;
  align-items: center;
  color: #5faee3;
  font-size: 14px;
  padding: 8px 16px;
  background-color: #f0f7ff;
  border-radius: 30px;
  border: 1px solid #96c9ff;
}

.avatar-edit van-icon {
  margin-right: 6px;
  font-size: 16px;
}

/* 表单项 */
.form-item {
  margin-bottom: 20px;
}

.form-item:last-child {
  margin-bottom: 0;
}

.item-label {
  font-size: 14px;
  color: #2e4d73;
  margin-bottom: 8px;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.required-star {
  color: #ff6b6b;
  margin-left: 4px;
  font-size: 14px;
}

/* 保存按钮 */
.submit-btn {
  margin: 30px 16px 20px 16px;
}

.submit-btn van-button {
  --button-primary-background-color: #96c9ff;
  --button-primary-border-color: #96c9ff;
  border-radius: 30px !important;
  height: 48px !important;
  line-height: 48px !important;
  font-weight: 500 !important;
}
