/* pages/admin-review/admin-review.wxss */
page {
  background-color: #e6f7ff;
  height: 100%;
  overflow-y: auto;
}

/* 统计卡片区域 */
.stats-section {
  display: flex;
  padding: 32px 16px;
  gap: 12px;
  margin-bottom: 16px;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #ffffff 0%, #f5faff 100%);
  border-radius: 16px;
  padding: 16px;
  text-align: center;
  box-shadow: 0 4px 12px rgba(0, 110, 200, 0.08);
  border: 1px solid rgba(95, 174, 227, 0.2);
}

.stat-number {
  font-size: 32px;
  font-weight: bold;
  color: #5faee3;
  line-height: 1.2;
}

.stat-label {
  font-size: 14px;
  color: #7a9ec2;
  margin-top: 8px;
}

/* 列表区域 */
.list-section {
  padding: 0 16px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding: 0 4px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
  position: relative;
  padding-left: 12px;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4px;
  bottom: 4px;
  width: 4px;
  background-color: #5faee3;
  border-radius: 4px;
}

.filter-tabs {
  display: flex;
  gap: 12px;
}

.tab {
  font-size: 14px;
  color: #7a9ec2;
  padding: 4px 8px;
  border-radius: 20px;
  transition: all 0.2s;
}

.tab.active {
  color: #5faee3;
  background-color: #e3f0ff;
  font-weight: 500;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60px 0;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
}

.empty-text {
  color: #7a9ec2;
  font-size: 14px;
  margin-top: 16px;
}

/* 活动卡片 */
.activity-card {
  background-color: white;
  border-radius: 18px;
  margin-bottom: 14px;
  padding: 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e8f0f8;
}

.activity-name {
  font-size: 16px;
  font-weight: 600;
  color: #134579;
  flex: 1;
}

.status-badge {
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
}

.status-badge.pending {
  background-color: #fff3e0;
  color: #ff9800;
}

.status-badge.all {
  background-color: #e8f5e9;
  color: #4caf50;
}

.card-content {
  margin-bottom: 16px;
}

.info-row {
  display: flex;
  align-items: flex-start;
  font-size: 13px;
  color: #5f7fa3;
  margin-bottom: 8px;
  line-height: 1.4;
}

.info-row van-icon {
  margin-right: 8px;
  font-size: 14px;
  color: #77b0e0;
  flex-shrink: 0;
  margin-top: 2px;
}

.description-text {
  flex: 1;
  word-break: break-all;
}

.card-footer {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  border-top: 1px solid #e8f0f8;
  padding-top: 12px;
}

.approve-btn, .reject-btn {
  padding: 8px 20px;
  border-radius: 24px;
  font-size: 14px;
  font-weight: 500;
  border: none;
  line-height: 1.2;
}

.approve-btn {
  background-color: #5faee3;
  color: white;
}

.approve-btn:active {
  background-color: #4a9ad0;
}

.reject-btn {
  background-color: #ffcdcd;
  color: #d32f2f;
}

.reject-btn:active {
  background-color: #ffb8b8;
}

.reject-reason {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #ff6b6b;
  background-color: #fff5f5;
  padding: 8px 12px;
  border-radius: 8px;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 20px 0;
  color: #7a9ec2;
  font-size: 14px;
}

/* ========== 驳回弹窗样式 ========== */
.custom-dialog {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.dialog-container {
  position: relative;
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(30, 110, 180, 0.3);
  z-index: 1001;
}

.dialog-image {
  width: 50%;
  height: auto;
  display: block;
  border-radius: 32rpx;
  margin: 20rpx auto 20rpx auto;
}

.dialog-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1e4d7c;
  text-align: center;
}

.dialog-content {
  padding: 0 32rpx 24rpx;
}

.question {
  font-size: 32rpx;
  color: #2e5a8a;
  margin-bottom: 24rpx;
  text-align: center;
  font-weight: 500;
}

.reject-tip {
  font-size: 28rpx;
  color: #2e5a8a;
  margin-bottom: 16rpx;
}

.reject-textarea {
  width: 100%;
  min-height: 160rpx;
  background-color: #f0f9ff;
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: #1e3e60;
  box-sizing: border-box;
  border: 2rpx solid #c0e0ff;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #7a9ec2;
  margin-top: 8rpx;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  background-color: #f0f9ff;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #1e3e60;
  box-sizing: border-box;
  border: 2rpx solid #c0e0ff;
}

.dialog-input:focus {
  border-color: #5faee3;
  background-color: #ffffff;
}

.error-tip {
  color: #ff6b6b;
  font-size: 26rpx;
  margin-top: 16rpx;
  text-align: center;
}

.plain-text {
  font-size: 28rpx;
  color: #2e5a8a;
  text-align: center;
  padding: 20rpx 0;
}

.dialog-buttons {
  display: flex;
  border-top: 2rpx solid #d9ecff;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  transition: background-color 0.2s;
  font-weight: 500;
}

.dialog-btn-cancel {
  color: #7f8c8d;
  border-right: 2rpx solid #d9ecff;
  background-color: #f9fcff;
}

.dialog-btn-cancel:active {
  background-color: #e6f0fa;
}

.dialog-btn-confirm {
  color: #ffffff;
  background-color: #5faee3;
}

.dialog-btn-confirm:active {
  background-color: #4a9ad0;
}


/* 在文件末尾添加 */

/* 查看详情按钮 */
.detail-btn {
  width: 100%;
  height: 36px;
  line-height: 36px;
  background: linear-gradient(135deg, #5faee3 0%, #4a9ad0 100%);
  color: white;
  border-radius: 30px;
  font-size: 14px;
  font-weight: 500;
  border: none;
}

.detail-btn:active {
  background: linear-gradient(135deg, #4a9ad0 0%, #3a8abe 100%);
}

/* 驳回原因底部区域 */
.reject-reason-footer {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid #e8f0f8;
}

.reject-reason {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #ff6b6b;
  background-color: #fff5f5;
  padding: 8px 12px;
  border-radius: 8px;
}


