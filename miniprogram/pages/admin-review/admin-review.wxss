}

.detail-btn:active {
  background: linear-gradient(135deg, #4a9ad0 0%, #3a8abe 100%);
}

/* 驳回原因区域 */
.reject-reason-section {
  margin: 12px 0 8px 0;
  padding: 10px 12px;
  background-color: #fff5f5;
  border-radius: 8px;
  border-left: 3px solid #ff6b6b;
}

.reject-reason {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 12px;
  line-height: 1.4;
}

.reject-reason van-icon {
  flex-shrink: 0;
  margin-top: 2px;
}

.reject-reason-label {
  flex-shrink: 0;
  color: #d32f2f;
  font-weight: 500;
}

.reject-reason-text {
  flex: 1;
  color: #d32f2f;
  word-break: break-all;
}

/* 状态徽章 - 已驳回 */
.status-badge.rejected {
  background-color: #ffcdcd;
  color: #d32f2f;
}

/* 卡片底部 */
.card-footer {
  margin-top: 8px;
}