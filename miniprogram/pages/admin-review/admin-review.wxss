page {
  min-height: 100%;
  background: #f4f8fb;
  color: #173f63;
}

.list-section {
  padding: 22px 16px 32px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding: 0 4px;
}

.section-title {
  position: relative;
  padding-left: 12px;
  color: #173f63;
  font-size: 18px;
  font-weight: 700;
}

.section-title::before {
  position: absolute;
  top: 4px;
  bottom: 4px;
  left: 0;
  width: 4px;
  border-radius: 4px;
  background: #5faee3;
  content: '';
}

.filter-tabs {
  display: flex;
  gap: 8px;
}

.tab {
  padding: 5px 10px;
  border-radius: 18px;
  color: #7a9ec2;
  font-size: 13px;
}

.tab.active {
  color: #3988c2;
  background: #e5f3fc;
  font-weight: 600;
}

.loading-container,
.empty-container {
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-container {
  padding: 60px 0;
}

.empty-container {
  flex-direction: column;
  padding: 80px 0;
}

.empty-text {
  margin-top: 16px;
  color: #7a9ec2;
  font-size: 14px;
}

.activity-card {
  margin-bottom: 14px;
  padding: 16px;
  border: 1px solid rgba(160, 200, 225, 0.35);
  border-radius: 18px;
  background: #ffffff;
  box-shadow: 0 6px 18px rgba(56, 111, 150, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e8f0f8;
}

.activity-name {
  min-width: 0;
  flex: 1;
  color: #134579;
  font-size: 16px;
  font-weight: 700;
}

.card-badges {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 6px;
  margin-left: 8px;
}

.official-badge {
  padding: 4px 10px;
  border-radius: 20px;
  color: #317daf;
  background: #edf7fd;
  font-size: 12px;
  font-weight: 600;
}

.status-badge {
  padding: 4px 11px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
}

.status-badge.pending {
  color: #d98717;
  background: #fff4e1;
}

.status-badge.all {
  color: #3e8dcc;
  background: #eaf5fc;
}

.status-badge.rejected {
  color: #c94f4f;
  background: #fff0f0;
}

.card-content {
  margin-bottom: 16px;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8px;
  color: #5f7fa3;
  font-size: 13px;
  line-height: 1.45;
}

.info-row van-icon {
  flex-shrink: 0;
  margin-top: 2px;
  margin-right: 8px;
  color: #77b0e0;
  font-size: 14px;
}

.description-text {
  flex: 1;
  word-break: break-all;
}

.reject-reason-section {
  margin: 12px 0 8px;
  padding: 10px 12px;
  border-left: 3px solid #e78181;
  border-radius: 8px;
  background: #fff7f7;
}

.reject-reason {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  color: #c94f4f;
  font-size: 12px;
  line-height: 1.45;
}

.reject-reason van-icon {
  flex-shrink: 0;
  margin-top: 2px;
}

.reject-reason-label {
  flex-shrink: 0;
  font-weight: 600;
}

.reject-reason-text {
  flex: 1;
  word-break: break-all;
}

.card-footer {
  display: flex;
  margin-top: 8px;
  padding-top: 12px;
  border-top: 1px solid #e8f0f8;
}

/* 使用 flex 居中，避免原生 button 在部分真机上文字基线下沉。 */
.detail-btn {
  display: flex;
  width: 100%;
  height: 42px;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 20px;
  border-radius: 24px;
  color: #ffffff;
  background: linear-gradient(135deg, #62b3e8 0%, #327fbd 100%);
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
}

.detail-btn--pressed {
  opacity: 0.86;
  transform: scale(0.99);
}

.load-more {
  padding: 18px 0 20px;
  color: #91a9bb;
  font-size: 13px;
  text-align: center;
}

.load-more-text {
  color: inherit;
  font-size: inherit;
}
