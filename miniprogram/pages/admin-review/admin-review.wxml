<!-- 活动列表 -->
<view class="list-section">
  <view class="section-header">
    <text class="section-title">{{currentTab === 'pending' ? '待审核活动' : '全部活动'}}</text>
    <view class="filter-tabs">
      <text class="tab {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">待审核</text>
      <text class="tab {{currentTab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">全部</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <van-loading size="40px" vertical>加载中...</van-loading>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{activityList.length === 0}}" class="empty-container">
    <van-icon name="todo-list-o" size="80" color="#ccc" />
    <text class="empty-text">暂无待审核活动</text>
  </view>

<!-- 活动卡片 -->
<view wx:for="{{activityList}}" wx:key="id" class="activity-card" bindtap="onActivityClick" data-id="{{item.id}}">
  <view class="card-header">
    <view class="activity-name activity-title-with-brand">
      <text class="activity-title-text">{{item.name}}</text>
    </view>
    <view class="card-badges">
      <view class="official-badge official-chip" wx:if="{{item.is_official == 1}}">
        <image class="official-mascot official-mascot--tiny" src="/images/official-badge.png" mode="aspectFit" />
        <text>官方</text>
      </view>
      <view class="status-badge {{item.status === 0 ? 'pending' : (item.status === 2 ? 'rejected' : 'all')}}">
        {{item.status === 0 ? '待审核' : (item.status === 2 ? '已驳回' : '已审核')}}
      </view>
    </view>
  </view>

  <view class="card-content">
    <view class="info-row">
      <van-icon name="user-o" />
      <text>发起人：{{item.creator_name || '未知'}}</text>
      <image class="official-mascot official-mascot--tiny" wx:if="{{item.is_official == 1}}" src="/images/official-badge.png" mode="aspectFit" />
    </view>
    <view class="info-row">
      <van-icon name="clock-o" />
      <text>活动时间：{{item.activity_time_formatted}}</text>
    </view>
    <view class="info-row">
      <van-icon name="location-o" />
      <text>地点：{{item.location}}</text>
    </view>
    <view class="info-row">
      <van-icon name="user-o" />
      <text>{{item.status === 4 ? '参与人数：' + item.participant_count : '报名人数：' + item.participant_count + '/' + item.max_participants}}</text>
    </view>
    <view class="info-row">
      <van-icon name="certificate" />
      <text>需要购买保险：{{item.is_force_insurance === 1 ? '是' : '否'}}</text>
    </view>
    <view class="info-row" wx:if="{{item.description}}">
      <van-icon name="description-o" />
      <text class="description-text">简介：{{item.description}}</text>
    </view>
  </view>

  <!-- 已驳回状态显示原因（在按钮上方） -->
  <view class="reject-reason-section" wx:if="{{item.status === 2 && item.reject_reason}}">
    <view class="reject-reason">
      <van-icon name="warning-o" size="14" color="#ff6b6b" />
      <text class="reject-reason-label">驳回原因：</text>
      <text class="reject-reason-text">{{item.reject_reason}}</text>
    </view>
  </view>
  
  <!-- 已驳回但没有驳回原因的情况 -->
  <view class="reject-reason-section" wx:elif="{{item.status === 2 && !item.reject_reason}}">
    <view class="reject-reason">
      <van-icon name="warning-o" size="14" color="#ff6b6b" />
      <text class="reject-reason-text">活动已被驳回，无具体原因</text>
    </view>
  </view>

  <!-- 底部查看详情按钮 -->
  <view class="card-footer">
    <view
      class="detail-btn"
      hover-class="detail-btn--pressed"
      aria-role="button"
      aria-label="查看活动详情"
      data-id="{{item.id}}"
      catchtap="onActivityClick"
    >查看详情</view>
  </view>
</view>

  <!-- 加载更多/没有更多 -->
  <view wx:if="{{!isLoading && activityList.length > 0}}" class="load-more">
    <text wx:if="{{hasMore}}" class="load-more-text">上拉加载更多</text>
    <text wx:else class="load-more-text">没有更多了</text>
  </view>
</view>
