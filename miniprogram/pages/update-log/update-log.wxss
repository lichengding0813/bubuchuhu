/* pages/update-log/update-log.wxss */
page {
  background-color: #e6f7ff;
  height: 100%;
  overflow-y: auto;
}

.container {
  padding: 32rpx 16rpx 60rpx;   /* 左右边距缩小 */
}

.page-header {
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}

/* 列表：居中布局 */
.update-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

/* 卡片：更宽，更大，居中 */
.update-card {
  width: 100%;
  background-color: white;
  border-radius: 40rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 130, 210, 0.08);
  border: 1rpx solid rgba(160, 200, 255, 0.4);
  box-sizing: border-box;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e8f0f8;
}

.version-badge {
  background-color: #e3f0ff;
  color: #5faee3;
  padding: 8rpx 28rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.version-date {
  font-size: 24rpx;
  color: #7a9ec2;
}

.change-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;   /* 增大行距，显得更长 */
}

.change-row {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  color: #5f7fa3;
  line-height: 1.5;
}

.change-icon {
  flex-shrink: 0;
  width: 36rpx;
  text-align: center;
}

.change-text {
  flex: 1;
  word-break: break-all;
  color: #2c5a8a;
}

.change-icon-emoji {
  width: 44rpx;
  flex-shrink: 0;
  font-size: 32rpx;
  text-align: center;
}