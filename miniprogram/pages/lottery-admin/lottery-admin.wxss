page {
  background: #f4f8fb;
}

.lottery-container {
  padding: 18px 16px 40px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.title {
  color: #163f5d;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.create-btn {
  overflow: hidden;
  flex-shrink: 0;
  border-radius: 18px !important;
  font-weight: 600 !important;
  --button-info-background-color: #4d9fd7;
  --button-info-border-color: #4d9fd7;
}

.empty {
  display: flex;
  min-height: 220px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1px solid rgba(157, 191, 214, 0.3);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 22px rgba(44, 89, 120, 0.06);
}

.empty-text {
  margin-top: 12px;
  color: #8ca2b2;
  font-size: 14px;
}

.lottery-card {
  padding: 17px 16px;
  margin-bottom: 14px;
  border: 1px solid rgba(157, 191, 214, 0.3);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 22px rgba(44, 89, 120, 0.075);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 12px;
  margin-bottom: 12px;
  border-bottom: 1px solid #edf3f8;
}

.card-title {
  flex: 1;
  min-width: 0;
  color: #173f5c;
  font-size: 16px;
  font-weight: 700;
}

.status-badge {
  flex-shrink: 0;
  padding: 4px 9px;
  border-radius: 14px;
  font-size: 10px;
  font-weight: 600;
}

.status-0 {
  color: #347ba9;
  background: #e1f2fd;
}

.status-1 {
  color: #35815a;
  background: #e2f5e9;
}

.status-2 {
  color: #7b8992;
  background: #edf0f2;
}

.card-body {
  color: #688498;
  font-size: 13px;
}

.info-row {
  margin-bottom: 6px;
  line-height: 1.45;
}

.prize-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.prize-item {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 5px 10px;
  border-radius: 12px;
  color: #4c83a8;
  background: #eaf5fc;
  font-size: 11px;
}

.prize-thumb {
  width: 24px;
  height: 24px;
  border-radius: 7px;
}

.prize-remain {
  margin-left: 4px;
  color: #b56625;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 12px;
  margin-top: 12px;
  border-top: 1px solid #edf3f8;
}

.record-btn {
  display: flex;
  height: 30px;
  align-items: center;
  justify-content: center;
  padding: 0 13px;
  border: 1px solid #7ab8df;
  border-radius: 15px;
  color: #3f91c9;
  background: #fff;
  font-size: 11px;
  font-weight: 600;
}

.form-container {
  min-height: 100%;
  padding: 24px 18px 40px;
  box-sizing: border-box;
  background: #f4f8fb;
}

.form-title {
  margin-bottom: 20px;
  color: #163f5d;
  font-size: 20px;
  font-weight: 700;
  text-align: left;
}

.form-item {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  margin-bottom: 7px;
  color: #315a76;
  font-size: 14px;
  font-weight: 600;
}

.form-hint {
  display: block;
  margin-top: 6px;
  color: #91a5b3;
  font-size: 11px;
}

.form-input,
.picker-value,
.prize-name-input,
.prize-qty-input {
  min-height: 44px;
  padding: 11px 12px;
  border: 1px solid #dbe8f1;
  border-radius: 14px;
  box-sizing: border-box;
  color: #214b69;
  background: #fff;
  font-size: 14px;
}

.form-row {
  display: flex;
  gap: 12px;
}

.datetime-picker-row {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
  gap: 9px;
}

.datetime-picker-row picker {
  min-width: 0;
}

.form-item.half {
  flex: 1;
  min-width: 0;
}

.prize-config {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  margin-bottom: 10px;
  border: 1px solid #e1ebf2;
  border-radius: 15px;
  background: #fff;
}

.prize-config-main,
.prize-image-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.prize-name-input {
  flex: 1;
  min-width: 0;
}

.prize-qty-input {
  width: 74px;
}

.prize-image-upload {
  display: flex;
  width: 72px;
  height: 58px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1px dashed #91c6e8;
  border-radius: 12px;
  color: #4d9fd7;
  background: #f1f9fe;
}

.prize-image-upload image {
  width: 100%;
  height: 100%;
}

.prize-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 3px;
  font-size: 9px;
}

.remove-prize-image {
  color: #ce6262;
  font-size: 11px;
}

.prize-image-tip {
  color: #91a5b3;
  font-size: 10px;
}

.add-prize-btn {
  padding: 9px 0;
  color: #4d9fd7;
  font-size: 14px;
  font-weight: 600;
}

.submit-btn {
  overflow: hidden;
  height: 48px !important;
  margin-top: 22px;
  border-radius: 24px !important;
  font-weight: 600 !important;
  --button-info-background-color: #4d9fd7;
  --button-info-border-color: #4d9fd7;
}

.immutable-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  margin-top: 18px;
  color: #8a9eac;
  font-size: 11px;
}

.records-container {
  display: flex;
  height: 100%;
  flex-direction: column;
  padding: 22px 18px 24px;
  box-sizing: border-box;
  background: #f4f8fb;
}

.records-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.records-title {
  color: #163f5d;
  font-size: 20px;
  font-weight: 700;
}

.records-activity {
  overflow: hidden;
  max-width: 280px;
  margin-top: 4px;
  color: #7891a4;
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.records-summary {
  display: flex;
  gap: 18px;
  padding: 11px 13px;
  margin: 15px 0 12px;
  border-radius: 12px;
  color: #4e7d9e;
  background: #eaf5fc;
  font-size: 12px;
  font-weight: 600;
}

.records-loading,
.records-empty {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #91a5b3;
  font-size: 13px;
}

.records-list {
  flex: 1;
  min-height: 0;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px;
  margin-bottom: 9px;
  border: 1px solid #e1ebf2;
  border-radius: 15px;
  background: #fff;
}

.record-avatar {
  display: flex;
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eaf3fa;
}

.record-avatar-empty {
  color: #7da9c8;
}

.record-user {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 2px;
}

.record-name,
.record-wechat,
.record-id {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-name {
  color: #214b69;
  font-size: 13px;
  font-weight: 600;
}

.record-wechat,
.record-id,
.record-time {
  color: #91a5b3;
  font-size: 9px;
}

.record-result {
  display: flex;
  max-width: 92px;
  flex-shrink: 0;
  align-items: center;
  gap: 5px;
  padding: 5px 8px;
  border-radius: 12px;
  color: #82929e;
  background: #eef1f3;
  font-size: 10px;
}

.record-result.winner {
  color: #bd6b25;
  background: #fff1df;
}

.record-result image {
  width: 24px;
  height: 24px;
  flex-shrink: 0;
  border-radius: 7px;
}
