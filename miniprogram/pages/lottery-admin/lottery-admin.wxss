page { background: #e6f7ff; }
.lottery-container { padding: 16px; }
.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.title { font-size: 18px; font-weight: 600; color: #1e4d7c; }
.create-btn { flex-shrink: 0; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 60px 0; }
.empty-text { color: #999; margin-top: 12px; font-size: 14px; }
.lottery-card { background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
.card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.card-title { font-size: 16px; font-weight: 500; color: #333; }
.status-badge { font-size: 12px; padding: 2px 8px; border-radius: 10px; }
.status-0 { background: #e3f0ff; color: #5faee3; }
.status-1 { background: #e8f5e9; color: #4caf50; }
.status-2 { background: #f5f5f5; color: #999; }
.card-body { font-size: 13px; color: #666; }
.info-row { margin-bottom: 4px; }
.prize-list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
.prize-item { background: #f0f7ff; padding: 4px 10px; border-radius: 6px; font-size: 12px; color: #5f7fa3; }
.prize-remain { margin-left: 4px; color: #ff8800; }
.card-footer { margin-top: 12px; display: flex; justify-content: flex-end; }

.form-container { padding: 20px; }
.form-title { font-size: 18px; font-weight: 600; color: #1e4d7c; margin-bottom: 16px; text-align: center; }
.form-item { margin-bottom: 16px; }
.form-label { font-size: 14px; color: #333; margin-bottom: 6px; display: block; }
.form-input { border: 1px solid #e0e8f0; border-radius: 8px; padding: 8px 12px; font-size: 14px; }
.picker-value { border: 1px solid #e0e8f0; border-radius: 8px; padding: 8px 12px; font-size: 14px; color: #333; }
.form-row { display: flex; gap: 12px; }
.form-item.half { flex: 1; }
.prize-config { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.prize-name-input { flex: 1; border: 1px solid #e0e8f0; border-radius: 8px; padding: 6px 10px; font-size: 13px; }
.prize-qty-input { width: 60px; border: 1px solid #e0e8f0; border-radius: 8px; padding: 6px 10px; font-size: 13px; }
.add-prize-btn { color: #5faee3; font-size: 14px; padding: 8px 0; }
.submit-btn { margin-top: 20px; }
