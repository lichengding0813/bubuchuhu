page {
  background: #f4f8fb;
}

.lottery-container {
  padding: 18px 16px 40px;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.title {
  color: #163f5d;
  font-size: 22px;
  font-weight: 700;
  letter-spacing: 0.2px;
}

.create-btn {
  overflow: hidden;
  flex-shrink: 0;
  border-radius: 18px !important;
  font-weight: 600 !important;
  --button-info-background-color: #4d9fd7;
  --button-info-border-color: #4d9fd7;
}

.empty {
  display: flex;
  min-height: 220px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border: 1px solid rgba(157, 191, 214, 0.3);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 22px rgba(44, 89, 120, 0.06);
}

.empty-text {
  margin-top: 12px;
  color: #8ca2b2;
  font-size: 14px;
}

.lottery-card {
  padding: 17px 16px;
  margin-bottom: 14px;
  border: 1px solid rgba(157, 191, 214, 0.3);
  border-radius: 20px;
  background: #fff;
  box-shadow: 0 8px 22px rgba(44, 89, 120, 0.075);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 12px;
  margin-bottom: 12px;
  border-bottom: 1px solid #edf3f8;
}

.card-title {
  flex: 1;
  min-width: 0;
  color: #173f5c;
  font-size: 16px;
  font-weight: 700;
}

.status-badge {
  flex-shrink: 0;
  padding: 4px 9px;
  border-radius: 14px;
  font-size: 10px;
  font-weight: 600;
}

.status-0 {
  color: #347ba9;
  background: #e1f2fd;
}

.status-1 {
  color: #35815a;
  background: #e2f5e9;
}

.status-2 {
  color: #7b8992;
  background: #edf0f2;
}

.card-body {
  color: #688498;
  font-size: 13px;
}

.info-row {
  margin-bottom: 6px;
  line-height: 1.45;
}

.prize-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.prize-item {
  padding: 5px 10px;
  border-radius: 12px;
  color: #4c83a8;
  background: #eaf5fc;
  font-size: 11px;
}

.prize-remain {
  margin-left: 4px;
  color: #b56625;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 12px;
  margin-top: 12px;
  border-top: 1px solid #edf3f8;
}

.form-container {
  min-height: 100%;
  padding: 24px 18px 40px;
  box-sizing: border-box;
  background: #f4f8fb;
}

.form-title {
  margin-bottom: 20px;
  color: #163f5d;
  font-size: 20px;
  font-weight: 700;
  text-align: left;
}

.form-item {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  margin-bottom: 7px;
  color: #315a76;
  font-size: 14px;
  font-weight: 600;
}

.form-input,
.picker-value,
.prize-name-input,
.prize-qty-input {
  min-height: 44px;
  padding: 11px 12px;
  border: 1px solid #dbe8f1;
  border-radius: 14px;
  box-sizing: border-box;
  color: #214b69;
  background: #fff;
  font-size: 14px;
}

.form-row {
  display: flex;
  gap: 12px;
}

.form-item.half {
  flex: 1;
  min-width: 0;
}

.prize-config {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 9px;
}

.prize-name-input {
  flex: 1;
  min-width: 0;
}

.prize-qty-input {
  width: 74px;
}

.add-prize-btn {
  padding: 9px 0;
  color: #4d9fd7;
  font-size: 14px;
  font-weight: 600;
}

.submit-btn {
  overflow: hidden;
  height: 48px !important;
  margin-top: 22px;
  border-radius: 24px !important;
  font-weight: 600 !important;
  --button-info-background-color: #4d9fd7;
  --button-info-border-color: #4d9fd7;
}
