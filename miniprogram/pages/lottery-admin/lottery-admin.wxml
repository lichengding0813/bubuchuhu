<view class="lottery-container">
  <view class="header">
    <text class="title">活动抽奖管理</text>
    <van-button size="small" type="info" custom-class="create-btn" bindtap="showCreateForm">创建抽奖</van-button>
  </view>

  <view wx:if="{{lotteryList.length === 0}}" class="empty">
    <van-icon name="gift-o" size="60" color="#ccc" />
    <text class="empty-text">暂无抽奖活动</text>
  </view>

  <view wx:for="{{lotteryList}}" wx:key="id" class="lottery-card">
    <view class="card-header">
      <view class="card-title activity-title-with-brand">
        <text class="activity-title-text">{{item.activity_name}}</text>
      </view>
      <view class="status-badge status-{{item.status}}">{{item.status === 0 ? '未开始' : item.status === 1 ? '进行中' : '已结束'}}</view>
    </view>
    <view class="card-body">
      <view class="info-row"><text>时间：{{item.start_time}} ~ {{item.end_time}}</text></view>
      <view class="info-row"><text>参与人数：{{item.draw_count}}</text></view>
      <view class="prize-list">
        <view wx:for="{{item.prizes}}" wx:for-item="prize" wx:key="id" class="prize-item">
          <image class="prize-thumb" wx:if="{{prize.image_url}}" src="{{prize.image_url}}" mode="aspectFill" />
          <text>{{prize.tier_name}}</text>
          <text class="prize-remain">{{prize.remaining}}/{{prize.quantity}}</text>
        </view>
      </view>
    </view>
    <view class="card-footer">
      <view class="record-btn" bindtap="onViewRecords" data-id="{{item.id}}" data-name="{{item.activity_name}}">查看记录</view>
      <van-button wx:if="{{item.status !== 2}}" size="small" type="danger" bindtap="onEndLottery" data-id="{{item.id}}">结束抽奖</van-button>
    </view>
  </view>
</view>

<!-- 创建抽奖弹窗 -->
<van-popup show="{{showForm}}" position="bottom" custom-style="border-radius:16px 16px 0 0;height:80vh;" bind:close="hideCreateForm">
  <view class="form-container">
    <view class="form-title">创建抽奖</view>
    
    <view class="form-item">
      <text class="form-label">选择官方活动</text>
      <picker mode="selector" range="{{activityOptions}}" range-key="name" bindchange="onActivityChange" value="{{activityIndex}}">
        <view class="picker-value">{{activityOptions[activityIndex] ? activityOptions[activityIndex].name : '请选择官方活动'}}</view>
      </picker>
      <text class="form-hint">仅显示尚无进行中抽奖的官方活动</text>
    </view>

    <view class="form-item">
      <text class="form-label">口令</text>
      <input class="form-input" placeholder="用户抽奖口令" value="{{formPassword}}" bindinput="onPasswordInput" />
    </view>

    <view class="form-item">
      <text class="form-label">开始时间（精确到分钟）</text>
      <view class="datetime-picker-row">
        <picker mode="date" bindchange="onStartDateChange" value="{{formStartDate}}">
          <view class="picker-value">{{formStartDate || '选择日期'}}</view>
        </picker>
        <picker mode="time" bindchange="onStartTimeChange" value="{{formStartTime}}">
          <view class="picker-value">{{formStartTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">结束时间（精确到分钟）</text>
      <view class="datetime-picker-row">
        <picker mode="date" bindchange="onEndDateChange" value="{{formEndDate}}">
          <view class="picker-value">{{formEndDate || '选择日期'}}</view>
        </picker>
        <picker mode="time" bindchange="onEndTimeChange" value="{{formEndTime}}">
          <view class="picker-value">{{formEndTime || '选择时间'}}</view>
        </picker>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">奖品配置</text>
      <view wx:for="{{prizeList}}" wx:key="index" class="prize-config">
        <view class="prize-config-main">
          <input class="prize-name-input" placeholder="档位名称" value="{{item.tier_name}}" data-index="{{index}}" bindinput="onPrizeNameInput" />
          <input class="prize-qty-input" type="number" placeholder="份数" value="{{item.quantity}}" data-index="{{index}}" bindinput="onPrizeQtyInput" />
          <van-icon name="delete-o" size="20" color="#ff6b6b" bindtap="removePrize" data-index="{{index}}" />
        </view>
        <view class="prize-image-row">
          <view class="prize-image-upload" bindtap="onPrizeImageTap" data-index="{{index}}">
            <image wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFill" />
            <view wx:else class="prize-image-placeholder">
              <van-loading wx:if="{{uploadingPrizeIndex === index}}" size="20px" />
              <block wx:else>
                <van-icon name="photograph" size="20px" />
                <text>上传奖品图</text>
              </block>
            </view>
          </view>
          <view class="remove-prize-image" wx:if="{{item.image_url}}" bindtap="onRemovePrizeImage" data-index="{{index}}">移除图片</view>
          <text class="prize-image-tip" wx:else>选填，中奖后会展示给用户</text>
        </view>
      </view>
      <view class="add-prize-btn" bindtap="addPrize">+ 添加奖品档位</view>
    </view>

    <view class="immutable-tip"><van-icon name="info-o" size="14px" /><text>发布后不可修改活动、时间、口令和奖品</text></view>
    <van-button type="info" block loading="{{submitting}}" disabled="{{submitting}}" bindtap="onCreateLottery" custom-class="submit-btn">发布官方活动抽奖</van-button>
  </view>
</van-popup>

<!-- 抽奖记录 -->
<van-popup show="{{showRecords}}" position="bottom" custom-style="border-radius:16px 16px 0 0;height:72vh;" bind:close="hideRecords">
  <view class="records-container">
    <view class="records-header">
      <view>
        <view class="records-title">抽奖记录</view>
        <view class="records-activity">{{recordInfo.activity_name}}</view>
      </view>
      <van-icon name="cross" size="20px" color="#8ca2b2" bindtap="hideRecords" />
    </view>
    <view class="records-summary">
      <text>参与 {{recordInfo.total}} 人</text>
      <text>中奖 {{recordInfo.winning_count}} 人</text>
    </view>
    <view class="records-loading" wx:if="{{recordsLoading}}"><van-loading size="24px">加载中...</van-loading></view>
    <view class="records-empty" wx:elif="{{recordInfo.list.length === 0}}">暂无抽奖记录</view>
    <scroll-view class="records-list" scroll-y wx:else>
      <view class="record-item" wx:for="{{recordInfo.list}}" wx:key="id">
        <image class="record-avatar" wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill" />
        <view class="record-avatar record-avatar-empty" wx:else><van-icon name="user-o" /></view>
        <view class="record-user">
          <text class="record-name">{{item.nickname}}</text>
          <text class="record-wechat" wx:if="{{item.wechat_id}}">微信号：{{item.wechat_id}}</text>
          <text class="record-id" wx:else>{{item.display_id}}</text>
          <text class="record-time">{{item.drawn_at}}</text>
        </view>
        <view class="record-result {{item.is_winner ? 'winner' : ''}}">
          <image wx:if="{{item.prize_image_url}}" src="{{item.prize_image_url}}" mode="aspectFill" />
          <text>{{item.prize_name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</van-popup>
