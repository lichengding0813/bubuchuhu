page { min-height: 100%; background: #f4f8fb; color: #173f5c; }
.admin-page { min-height: 100vh; padding: 20px 16px calc(44px + env(safe-area-inset-bottom)); box-sizing: border-box; }
.state-panel { min-height: 70vh; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #8299aa; }
.header, .card-header, .card-footer, .sheet-header, .section-head, .picker-value, .activity-row, .badge-basic, .switch-row { display: flex; align-items: center; }
.header, .card-footer, .sheet-header, .section-head, .picker-value, .switch-row { justify-content: space-between; }
.header { margin-bottom: 18px; }
.title { font-size: 23px; font-weight: 800; }
.primary-pill { display: flex; height: 34px; align-items: center; justify-content: center; padding: 0 15px; border-radius: 18px; color: #fff; background: #4d9fd7; box-shadow: 0 5px 14px rgba(77,159,215,.25); font-size: 12px; font-weight: 700; }
.retry-button { margin-top: 16px; }
.empty-card { padding: 42px 16px; border: 1px solid rgba(157,191,214,.3); border-radius: 22px; color: #91a5b3; background: #fff; text-align: center; font-size: 13px; }
.event-card { padding: 17px 16px 14px; margin-bottom: 14px; border: 1px solid rgba(157,191,214,.3); border-radius: 22px; background: #fff; box-shadow: 0 8px 22px rgba(44,89,120,.075); }
.card-header { gap: 10px; }
.event-image { width: 48px; height: 48px; flex-shrink: 0; }
.card-copy { min-width: 0; flex: 1; }
.card-title { display: block; overflow: hidden; color: #173f5c; font-size: 17px; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.activity-name { display: -webkit-box; margin-top: 4px; overflow: hidden; color: #7c95a7; font-size: 11px; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.status-badge { flex-shrink: 0; padding: 4px 9px; border-radius: 12px; font-size: 10px; font-weight: 700; }
.status-badge.enabled { color: #35815a; background: #e2f5e9; }
.status-badge.disabled { color: #7b8992; background: #edf0f2; }
.card-footer { gap: 8px; padding-top: 12px; margin-top: 11px; border-top: 1px solid #edf3f8; }
.card-meta { color: #8299aa; font-size: 11px; }
.card-action { display: flex; height: 28px; align-items: center; justify-content: center; padding: 0 12px; border: 1px solid #acd4ec; border-radius: 15px; color: #418fc3; background: #fff; font-size: 10px; font-weight: 700; }
.section-head { margin: 26px 2px 12px; color: #173f5c; font-size: 16px; font-weight: 800; }
.section-head text:last-child { color: #91a5b3; font-size: 11px; font-weight: 400; }
.milestone-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 8px; }
.milestone-card { min-height: 76px; padding: 10px; display: flex; align-items: center; gap: 7px; border: 1px solid rgba(157,191,214,.3); border-radius: 16px; background: #fff; box-sizing: border-box; }
.milestone-card image { width: 44px; height: 44px; flex-shrink: 0; }
.milestone-card view { min-width: 0; }
.milestone-card text { display: block; }
.milestone-card text:first-child { color: #28536d; font-size: 12px; font-weight: 700; }
.milestone-card text:last-child { margin-top: 4px; color: #849aa8; font-size: 10px; }
.form-scroll { height: 100%; }
.form-container { min-height: 100%; padding: 24px 17px calc(42px + env(safe-area-inset-bottom)); box-sizing: border-box; background: #f4f8fb; }
.sheet-header { align-items: flex-start; margin-bottom: 18px; }
.form-title { color: #173f5c; font-size: 20px; font-weight: 800; }
.form-card { padding: 15px; margin-bottom: 20px; border: 1px solid rgba(157,191,214,.3); border-radius: 19px; background: #fff; box-shadow: 0 6px 18px rgba(44,89,120,.05); }
.form-item { margin-bottom: 14px; }
.form-label { display: block; margin-bottom: 7px; color: #315a76; font-size: 12px; font-weight: 700; }
.form-input, .picker-value, .form-textarea { width: 100%; box-sizing: border-box; border: 1px solid #dbe8f1; border-radius: 13px; color: #214b69; background: #fafdff; font-size: 13px; }
.form-input { height: 42px; padding: 0 12px; }
.picker-value { min-height: 42px; padding: 10px 12px; gap: 8px; }
.picker-value text { min-width: 0; flex: 1; }
.form-textarea { height: 90px; padding: 10px 12px; line-height: 1.5; }
.linked-activities { margin-top: 12px; }
.activity-row { gap: 8px; padding: 10px 0; border-bottom: 1px solid #edf3f7; }
.activity-row:last-child { border-bottom: 0; padding-bottom: 0; }
.activity-copy { flex: 1; min-width: 0; }
.activity-copy text:first-child { display: block; color: #315a76; font-size: 12px; line-height: 1.5; word-break: break-all; }
.activity-copy text:nth-child(2) { display: block; margin-top: 3px; color: #91a5b3; font-size: 10px; }
.remove-activity { display: flex; width: 32px; height: 32px; align-items: center; justify-content: center; flex-shrink: 0; }
.badge-basic { align-items: flex-start; gap: 12px; margin-bottom: 16px; }
.upload-box { position: relative; width: 82px; height: 82px; flex-shrink: 0; overflow: hidden; border: 1px dashed #91c6e8; border-radius: 14px; background: #f1f9fe; }
.upload-box image { width: 100%; height: 100%; }
.upload-empty { height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4px; color: #4d9fd7; font-size: 10px; }
.uploading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(241,249,253,.9); }
.badge-name-field { flex: 1; min-width: 0; padding-top: 7px; }
.switch-row { min-height: 38px; color: #315a76; font-size: 12px; }
.form-container .submit-button { display: flex; width: 100%; height: 47px; align-items: center; justify-content: center; padding: 0; border: 0; border-radius: 24px; color: #fff; background: linear-gradient(135deg,#69b9e8,#4298d2); font-size: 14px; font-weight: 700; line-height: 47px; }
.submit-button::after { display: none; }
.submit-button[disabled] { color: rgba(255,255,255,.75); background: #a8cce3; }
