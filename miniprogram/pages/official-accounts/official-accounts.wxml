<view class="container">
  <view class="search-card">
    <view class="search-bar">
      <van-icon name="search" size="17px" color="#8aa8c5" />
      <input class="search-input" value="{{keyword}}" placeholder="昵称、微信号或用户标识" bindinput="onKeywordInput" bindconfirm="onSearch" confirm-type="search" />
      <van-icon wx:if="{{keyword}}" name="clear" size="17px" color="#a5b7c8" bindtap="onClearSearch" />
      <view class="search-submit-btn {{isSearching ? 'loading' : ''}}" bindtap="onSearch">
        {{isSearching ? '搜索中' : '搜索'}}
      </view>
    </view>

    <view class="candidate-section" wx:if="{{hasSearched}}">
      <view class="sub-title">搜索结果</view>
      <ui-state loading="{{isSearching}}" error="{{searchError}}" empty="{{candidateList.length === 0}}" empty-text="没有可加入的用户" compact bind:retry="onSearch" />
      <view class="user-card compact" wx:for="{{candidateList}}" wx:key="openId">
        <view class="user-main">
          <image class="user-avatar" src="{{item.avatarUrl}}" mode="aspectFill" wx:if="{{item.avatarUrl}}" />
          <view class="user-avatar avatar-placeholder" wx:else><van-icon name="user-o" /></view>
          <view class="user-info">
            <text class="user-name">{{item.nickName || '匿名用户'}}</text>
            <text class="user-meta" wx:if="{{item.wechatId}}">微信号：{{item.wechatId}}</text>
            <text class="user-openid">{{item.displayOpenId}}</text>
          </view>
        </view>
        <view class="add-account-btn {{addingOpenId === item.openId ? 'loading' : ''}}" data-openid="{{item.openId}}" data-nickname="{{item.nickName}}" catchtap="onAdd">
          {{addingOpenId === item.openId ? '处理中' : '加入'}}
        </view>
      </view>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">官方账号（{{total}}人）</text>
  </view>

  <ui-state loading="{{isLoading}}" error="{{loadError}}" empty="{{accountList.length === 0}}" empty-text="暂无官方账号" icon="friends-o" bind:retry="loadAccounts" />
  <view wx:if="{{!isLoading && !loadError && accountList.length === 0}}" class="empty-container">
    <view class="bootstrap-btn" bindtap="onBootstrapCurrentAdmin">将我设为首个官方账号</view>
  </view>
  <view wx:if="{{!isLoading && !loadError}}">
    <view class="user-card" wx:for="{{accountList}}" wx:key="openId">
      <view class="user-main">
        <view class="avatar-wrap">
          <image class="user-avatar" src="{{item.avatarUrl}}" mode="aspectFill" wx:if="{{item.avatarUrl}}" />
          <view class="user-avatar avatar-placeholder" wx:else><van-icon name="user-o" /></view>
          <image class="avatar-v" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
        </view>
        <view class="user-info">
          <view class="name-row">
            <text class="user-name">{{item.nickName || '匿名用户'}}</text>
            <view class="official-label official-chip">
              <image class="official-mascot official-mascot--tiny" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
              <text>{{item.isAdmin === 1 ? '超级管理员' : '官方账号'}}</text>
            </view>
          </view>
          <text class="user-meta" wx:if="{{item.wechatId}}">微信号：{{item.wechatId}}</text>
          <text class="user-openid">{{item.displayOpenId}}</text>
        </view>
      </view>
      <view wx:if="{{item.isAdmin !== 1}}" class="remove-btn {{removingOpenId === item.openId ? 'loading' : ''}}" data-openid="{{item.openId}}" data-nickname="{{item.nickName}}" catchtap="onRemove">
        {{removingOpenId === item.openId ? '处理中' : '移出'}}
      </view>
    </view>
  </view>
</view>
