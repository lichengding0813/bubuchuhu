/* pages/review/review.wxss */
page {
  background-color: #f0faff;
}

.review-container {
  padding: 16px;
}

.review-header {
  margin-bottom: 20px;
}

.review-title {
  font-size: 20px;
  font-weight: 600;
  color: #1e4d7c;
  position: relative;
  padding-left: 12px;
}

.review-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4px;
  bottom: 4px;
  width: 4px;
  background-color: #5faee3;
  border-radius: 4px;
}

.review-card {
  display: flex;
  background-color: white;
  border-radius: 16px;
  margin-bottom: 16px;
  padding: 12px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.review-cover {
  flex: 0 0 100px;
  height: 100px;
  border-radius: 12px;
  background: linear-gradient(145deg, #b7daf9, #96c9ff);
  margin-right: 12px;
}

.review-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.review-name {
  font-size: 16px;
  font-weight: 600;
  color: #134579;
  margin-bottom: 8px;
}

.review-meta {
  font-size: 13px;
  color: #5f7fa3;
  margin-bottom: 8px;
}

.review-stats {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: #77b0e0;
}