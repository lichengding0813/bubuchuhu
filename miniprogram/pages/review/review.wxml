<!-- pages/review/review.wxml - 列表页增加新建入口 -->
<view class="review-container">
  <!-- 管理员新建按钮 -->
  <view class="admin-add-btn" wx:if="{{isAdmin}}" bindtap="onAddReview">
    <van-icon name="plus" size="48" color="#fff" />
  </view>

  <view 
    wx:for="{{reviewList}}" 
    wx:key="index" 
    class="review-card"
    data-id="{{item.id}}"
    bindtap="onReviewClick"
  >
    <view class="review-cover"><image class="review-cover" src="{{item.cover}}" mode="aspectFill" /></view>
    <view class="review-info">
      <text class="review-name">{{item.name}}</text>
      <view class="review-meta">
        <text>{{item.time}} · {{item.location}}</text>
      </view>
      <view class="review-stats">
        <text>{{item.participants}}人参与</text>
      </view>
    </view>
  </view>
</view>

<!-- ========== 黑名单全屏遮罩 + 锁定弹窗 ========== -->
<view class="blacklist-mask" wx:if="{{isBlacklisted}}" catchtouchmove="preventTouchMove" bindtap="onMaskTap"></view>
<view class="custom-dialog" wx:if="{{showLockedDialog}}">
  <view class="dialog-mask" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-container">
    <view class="dialog-title">账户已锁定</view>
    <view class="dialog-content">
      <view class="plain-text">由于多次验证失败，您的账户已被锁定。</view>
    </view>
    <view class="dialog-buttons">
      <view class="dialog-btn dialog-btn-confirm" bindtap="onLockedConfirm">知道了</view>
    </view>
  </view>
</view>