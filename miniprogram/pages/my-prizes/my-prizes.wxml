<view class="page-container">
  <view class="hero-card">
    <view class="hero-icon"><van-icon name="gift-o" size="29px" color="#fff" /></view>
    <view><text class="hero-title">我的奖品</text><text class="hero-subtitle">中奖后凭核销码领取，记得留意有效期</text></view>
  </view>

  <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-list">
      <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" data-value="all" bindtap="onFilterTap">全部 {{counts.all}}</view>
      <view class="filter-item {{currentFilter === 'pending' ? 'active' : ''}}" data-value="pending" bindtap="onFilterTap">待领取 {{counts.pending}}</view>
      <view class="filter-item {{currentFilter === 'redeemed' ? 'active' : ''}}" data-value="redeemed" bindtap="onFilterTap">已领取 {{counts.redeemed}}</view>
      <view class="filter-item {{currentFilter === 'expired' ? 'active' : ''}}" data-value="expired" bindtap="onFilterTap">已过期 {{counts.expired}}</view>
    </view>
  </scroll-view>

  <view class="loading" wx:if="{{loading}}"><van-loading size="25px">加载中...</van-loading></view>
  <view class="empty" wx:elif="{{visiblePrizes.length === 0}}"><van-icon name="gift-o" size="54px" color="#bed2e1" /><text>这里还没有奖品</text></view>
  <view wx:else>
    <view class="prize-card status-{{item.redemption_status}}" wx:for="{{visiblePrizes}}" wx:key="record_id">
      <view class="prize-header">
        <image class="prize-image" wx:if="{{item.prize_image_url}}" src="{{item.prize_image_url}}" mode="aspectFill" />
        <view class="prize-image placeholder" wx:else>🎁</view>
        <view class="prize-main"><text class="prize-name">{{item.prize_name}}</text><text class="lottery-name">{{item.lottery_name}}</text></view>
        <view class="status-tag">{{item.redemption_label}}</view>
      </view>
      <view class="activity-link" data-id="{{item.activity_id}}" bindtap="goToActivity"><text>{{item.activity_name}}</text><van-icon name="arrow" size="12px" /></view>
      <view class="claim-info">
        <text wx:if="{{item.claim_instructions}}">{{item.claim_instructions}}</text>
        <text wx:if="{{item.pickup_location}}">领奖地点：{{item.pickup_location}}</text>
        <text>有效期至：{{item.valid_until}}</text>
        <text wx:if="{{item.redeemed_at}}">核销时间：{{item.redeemed_at}}</text>
      </view>
      <view class="code-card" wx:if="{{item.redemption_status === 0}}" data-code="{{item.redeem_code}}" bindtap="copyCode">
        <view><text class="code-label">现场核销码</text><text class="code-value">{{item.redeem_code}}</text></view>
        <text class="copy">复制</text>
      </view>
    </view>
  </view>
</view>
