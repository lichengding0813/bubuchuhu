<view class="admin-page">
  <view wx:if="{{isLoading}}" class="state-panel">
    <van-loading size="34px" vertical>加载中</van-loading>
  </view>

  <view wx:elif="{{loadError}}" class="state-panel">
    <text class="state-title">暂时无法加载配置</text>
    <text class="state-copy">{{loadError}}</text>
    <view class="primary compact" bindtap="onRetry">重新加载</view>
  </view>

  <block wx:elif="{{editorMode === 'wall'}}">
    <view class="editor-header">
      <view class="back-link" bindtap="onCloseEditor">取消</view>
      <text>{{wallForm.id ? '编辑墙面' : '新建墙面'}}</text>
    </view>

    <view class="form-card">
      <text class="form-label">墙面名称</text>
      <input class="form-input" maxlength="60" value="{{wallForm.title}}" placeholder="例如：步步出沪 · 飘带墙 03" bindinput="onWallTitleInput" />
      <text class="form-label">墙面文案</text>
      <input class="form-input no-margin" maxlength="120" value="{{wallForm.subtitle}}" placeholder="选填" bindinput="onWallSubtitleInput" />
    </view>

    <view class="form-card">
      <view class="section-title-row">
        <view><text class="section-title">选择飘带</text><text class="section-count">{{selectedRibbonIds.length}}/4</text></view>
        <view class="mini-add" bindtap="onAddRibbonFromWall"><van-icon name="plus" /> 上传添加</view>
      </view>
      <view class="asset-grid ribbon-grid">
        <view wx:for="{{selectableRibbons}}" wx:key="id" class="asset-card {{item.selected ? 'selected' : ''}} {{item.is_active ? '' : 'disabled'}}" data-id="{{item.id}}" bindtap="onToggleWallRibbon">
          <image class="ribbon-thumb" src="{{item.image_url}}" mode="aspectFill" />
          <text class="asset-name">{{item.name}}</text>
          <text wx:if="{{item.assignedWallTitle}}" class="assigned-wall">{{item.assignedWallTitle}}</text>
          <view class="asset-edit" data-id="{{item.id}}" catchtap="onEditRibbonFromWall">编辑</view>
          <view wx:if="{{item.selected}}" class="selected-mark">✓</view>
        </view>
      </view>
    </view>

    <view class="form-card">
      <view class="section-title-row">
        <view><text class="section-title">选择挂件</text><text class="section-count">{{selectedCharmIds.length}}/3</text></view>
        <view class="mini-add" bindtap="onAddCharmFromWall"><van-icon name="plus" /> 上传添加</view>
      </view>
      <view class="asset-grid charm-grid">
        <view wx:for="{{selectableCharms}}" wx:key="id" class="asset-card charm-card {{item.selected ? 'selected' : ''}} {{item.is_active ? '' : 'disabled'}}" data-id="{{item.id}}" bindtap="onToggleWallCharm">
          <image class="charm-thumb" src="{{item.image_url}}" mode="aspectFit" />
          <text class="asset-name">{{item.name}}</text>
          <view class="asset-edit" data-id="{{item.id}}" catchtap="onEditCharmFromWall">编辑</view>
          <view wx:if="{{item.selected}}" class="selected-mark">✓</view>
        </view>
      </view>
    </view>

    <view class="form-card preview-card">
      <view class="section-title-row">
        <text class="section-title">预览顺序</text>
        <text class="section-count">{{previewItems.length}} 项</text>
      </view>
      <text wx:if="{{previewItems.length === 0}}" class="empty-hint">选择飘带和挂件后，在这里统一排序</text>
      <view wx:for="{{previewItems}}" wx:key="key" class="preview-row">
        <text class="selected-order">{{index + 1}}</text>
        <image class="preview-thumb {{item.type}}" src="{{item.image_url}}" mode="aspectFit" />
        <view class="preview-copy"><text>{{item.name}}</text><text>{{item.typeLabel}}</text></view>
        <view class="order-actions">
          <text class="order-btn {{index === 0 ? 'disabled' : ''}}" data-index="{{index}}" data-direction="-1" bindtap="onMovePreviewItem">上移</text>
          <text class="order-btn {{index === previewItems.length - 1 ? 'disabled' : ''}}" data-index="{{index}}" data-direction="1" bindtap="onMovePreviewItem">下移</text>
        </view>
      </view>
    </view>

    <view class="bottom-save">
      <view class="primary {{isSaving ? 'disabled' : ''}}" bindtap="onSaveWall">{{isSaving ? '保存中…' : '保存墙面'}}</view>
    </view>
  </block>

  <block wx:elif="{{editorMode === 'ribbon'}}">
    <view class="editor-header"><view class="back-link" bindtap="onCloseEditor">返回</view><text>{{ribbonForm.id ? '编辑飘带' : '新增飘带'}}</text></view>
    <view class="form-card asset-form-card">
      <view class="upload-box ribbon-upload" bindtap="onChooseRibbonImage">
        <image wx:if="{{ribbonForm.image_url}}" src="{{ribbonForm.image_url}}" mode="scaleToFill" />
        <view wx:else class="upload-placeholder"><van-icon name="photograph" size="28px" color="#5e9fc4" /><text>上传 1:10 图片</text></view>
        <text wx:if="{{isUploading}}" class="uploading">上传中…</text>
      </view>
      <text class="form-label">飘带名称</text>
      <input class="form-input" maxlength="100" value="{{ribbonForm.name}}" placeholder="系列｜款名" bindinput="onRibbonNameInput" />
      <text class="form-label">说明</text>
      <textarea class="form-textarea" maxlength="500" value="{{ribbonForm.description}}" placeholder="选填" bindinput="onRibbonDescriptionInput"></textarea>
      <view class="switch-line"><text>启用这条飘带</text><switch checked="{{ribbonForm.is_active === 1}}" color="#4baadd" bindchange="onRibbonActiveChange" /></view>
    </view>
    <view class="bottom-save"><view class="primary {{isSaving || isUploading ? 'disabled' : ''}}" bindtap="onSaveRibbon">{{isSaving ? '保存中…' : '保存飘带'}}</view></view>
  </block>

  <block wx:elif="{{editorMode === 'charm'}}">
    <view class="editor-header"><view class="back-link" bindtap="onCloseEditor">返回</view><text>{{charmForm.id ? '编辑挂件' : '新增挂件'}}</text></view>
    <view class="form-card asset-form-card">
      <view class="upload-box charm-upload" bindtap="onChooseCharmImage">
        <image wx:if="{{charmForm.image_url}}" src="{{charmForm.image_url}}" mode="aspectFit" />
        <view wx:else class="upload-placeholder"><van-icon name="photograph" size="28px" color="#5e9fc4" /><text>上传方形图片</text></view>
        <text wx:if="{{isUploading}}" class="uploading">上传中…</text>
      </view>
      <text class="form-label">挂件名称</text>
      <input class="form-input" maxlength="100" value="{{charmForm.name}}" placeholder="例如：粉色球" bindinput="onCharmNameInput" />
      <text class="form-label">说明</text>
      <textarea class="form-textarea" maxlength="500" value="{{charmForm.description}}" placeholder="选填" bindinput="onCharmDescriptionInput"></textarea>
      <view class="switch-line"><text>启用这个挂件</text><switch checked="{{charmForm.is_active === 1}}" color="#4baadd" bindchange="onCharmActiveChange" /></view>
    </view>
    <view class="bottom-save"><view class="primary {{isSaving || isUploading ? 'disabled' : ''}}" bindtap="onSaveCharm">{{isSaving ? '保存中…' : '保存挂件'}}</view></view>
  </block>

  <block wx:else>
    <view class="top-actions">
      <view class="primary new-wall" bindtap="onAddWall"><van-icon name="plus" /> 新建墙面</view>
      <view class="asset-actions">
        <view class="secondary" bindtap="onAddRibbon"><van-icon name="plus" /> 新增飘带</view>
        <view class="secondary" bindtap="onAddCharm"><van-icon name="plus" /> 新增挂件</view>
      </view>
    </view>

    <view class="section-head"><text>墙面</text><text>{{walls.length}}</text></view>
    <view wx:if="{{walls.length === 0}}" class="empty-card">暂无墙面</view>
    <view wx:for="{{walls}}" wx:key="id" wx:for-item="wall" class="wall-list-card">
      <view class="wall-list-top"><view class="wall-list-copy"><text class="wall-list-title">{{wall.title}}</text><text class="wall-list-subtitle">{{wall.subtitle || '未填写墙面文案'}}</text></view></view>
      <view class="mini-layout">
        <image wx:for="{{wall.ribbons}}" wx:key="id" wx:for-item="ribbon" class="mini-ribbon" src="{{ribbon.image_url}}" mode="scaleToFill" />
        <image wx:for="{{wall.charms}}" wx:key="id" wx:for-item="charm" class="mini-charm" src="{{charm.image_url}}" mode="aspectFit" />
      </view>
      <view class="card-footer"><text>{{wall.ribbonCount}} 条飘带 · {{wall.charmCount}} 个挂件</text><view class="edit-link" data-id="{{wall.id}}" bindtap="onEditWall"><van-icon name="setting-o" /> 配置</view></view>
    </view>

    <view class="section-head asset-head"><text>飘带素材库</text><text>{{ribbons.length}}</text></view>
    <view wx:if="{{ribbons.length === 0}}" class="empty-card">暂无飘带</view>
    <view wx:for="{{ribbons}}" wx:key="id" class="library-row {{item.is_active ? '' : 'inactive'}}" data-id="{{item.id}}" bindtap="onEditRibbon">
      <image class="library-ribbon" src="{{item.image_url}}" mode="aspectFill" /><view class="library-copy"><text>{{item.name}}</text><text>{{item.is_active ? '已启用' : '已停用'}}</text></view><van-icon name="arrow" color="#87a2b2" />
    </view>

    <view class="section-head asset-head"><text>挂件素材库</text><text>{{charms.length}}</text></view>
    <view wx:if="{{charms.length === 0}}" class="empty-card">暂无挂件</view>
    <view wx:for="{{charms}}" wx:key="id" class="library-row {{item.is_active ? '' : 'inactive'}}" data-id="{{item.id}}" bindtap="onEditCharm">
      <image class="library-charm" src="{{item.image_url}}" mode="aspectFit" /><view class="library-copy"><text>{{item.name}}</text><text>{{item.is_active ? '已启用' : '已停用'}}</text></view><van-icon name="arrow" color="#87a2b2" />
    </view>
  </block>
</view>
