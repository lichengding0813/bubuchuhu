page {
  min-height: 100%;
  background: #f3f8fb;
}

.admin-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.state-panel {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7893a4;
}

.state-title { margin-bottom: 14rpx; color: #244d66; font-size: 32rpx; font-weight: 600; }
.state-copy { font-size: 25rpx; }

.primary,
.secondary {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.primary { background: #4baadd; color: #fff; }
.primary.compact { min-height: 72rpx; margin-top: 26rpx; padding: 0 28rpx; }
.secondary { border: 2rpx solid #75b9dc; background: #fff; color: #357da3; }
.disabled { opacity: .46; }

.top-actions { margin-bottom: 34rpx; }
.new-wall { width: 100%; min-height: 96rpx; box-shadow: 0 12rpx 24rpx rgba(55, 143, 189, .16); }
.asset-actions { margin-top: 16rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }

.section-head {
  margin: 0 6rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #24516d;
  font-size: 31rpx;
  font-weight: 650;
}

.section-head text:last-child { color: #89a1af; font-size: 23rpx; font-weight: 400; }
.asset-head { margin-top: 44rpx; }

.empty-card,
.wall-list-card,
.library-row,
.form-card {
  border: 2rpx solid rgba(149, 194, 220, .34);
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(45, 102, 134, .07);
}

.empty-card { padding: 58rpx 20rpx; color: #8ca3b0; text-align: center; font-size: 25rpx; }
.wall-list-card { margin-bottom: 20rpx; padding: 26rpx; }
.inactive { opacity: .58; }
.wall-list-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.wall-list-copy { flex: 1; min-width: 0; }
.wall-list-title,
.wall-list-subtitle { display: block; }
.wall-list-title { color: #204d68; font-size: 29rpx; font-weight: 650; }
.wall-list-subtitle { margin-top: 9rpx; color: #7d98a8; font-size: 23rpx; }

.mini-layout {
  min-height: 170rpx;
  margin: 24rpx 0 20rpx;
  padding: 16rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 26rpx;
  border-radius: 22rpx;
  background: #eaf6fb;
  box-sizing: border-box;
}
.mini-ribbon { width: 32rpx; height: 138rpx; border-radius: 3rpx; box-shadow: 0 5rpx 12rpx rgba(38, 87, 111, .18); }
.mini-charm { width: 54rpx; height: 54rpx; }
.card-footer { display: flex; align-items: center; justify-content: space-between; color: #829aa8; font-size: 23rpx; }
.edit-link { display: flex; align-items: center; gap: 6rpx; padding: 11rpx 18rpx; border-radius: 999rpx; background: #edf7fc; color: #357da3; }

.library-row {
  min-height: 116rpx;
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}
.library-ribbon { width: 42rpx; height: 84rpx; border-radius: 5rpx; background: #dcecf4; }
.library-charm { width: 70rpx; height: 70rpx; border-radius: 12rpx; background: #eef7fb; }
.library-copy { flex: 1; min-width: 0; }
.library-copy text { display: block; }
.library-copy text:first-child { overflow: hidden; color: #244f68; font-size: 26rpx; font-weight: 550; text-overflow: ellipsis; white-space: nowrap; }
.library-copy text:last-child { margin-top: 8rpx; color: #88a0ad; font-size: 21rpx; }

.editor-header {
  margin-bottom: 24rpx;
  display: grid;
  grid-template-columns: 100rpx 1fr 100rpx;
  align-items: center;
  color: #244f68;
  font-size: 32rpx;
  font-weight: 650;
  text-align: center;
}
.back-link { color: #4a97bd; font-size: 25rpx; font-weight: 450; text-align: left; }
.form-card { margin-bottom: 22rpx; padding: 28rpx; }
.form-label { display: block; margin-bottom: 12rpx; color: #2b5974; font-size: 25rpx; font-weight: 550; }

.form-input {
  width: 100%;
  height: 78rpx;
  min-height: 78rpx;
  margin-bottom: 28rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f1f7fa;
  color: #234b63;
  font-size: 26rpx;
  line-height: 78rpx;
  box-sizing: border-box;
}
.form-input.no-margin { margin-bottom: 0; }
.form-textarea { width: 100%; height: 210rpx; margin-bottom: 20rpx; padding: 20rpx 22rpx; border-radius: 18rpx; background: #f1f7fa; color: #234b63; font-size: 26rpx; box-sizing: border-box; }
.switch-line { min-height: 76rpx; display: flex; align-items: center; justify-content: space-between; color: #315b73; font-size: 25rpx; }

.section-title-row { margin-bottom: 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.section-title { color: #27546e; font-size: 29rpx; font-weight: 650; }
.section-count { margin-left: 12rpx; color: #7899ab; font-size: 23rpx; }
.mini-add { flex-shrink: 0; padding: 12rpx 18rpx; display: flex; align-items: center; gap: 5rpx; border-radius: 999rpx; background: #e9f6fc; color: #3987ad; font-size: 21rpx; }
.empty-hint { display: block; padding: 30rpx 0; color: #8da5b2; text-align: center; font-size: 23rpx; }

.asset-grid { display: grid; gap: 14rpx; }
.ribbon-grid { grid-template-columns: repeat(4, 1fr); }
.charm-grid { grid-template-columns: repeat(3, 1fr); }
.asset-card {
  position: relative;
  min-width: 0;
  min-height: 252rpx;
  padding: 16rpx 8rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: #f2f7fa;
  box-sizing: border-box;
}
.asset-card.charm-card { min-height: 218rpx; }
.asset-card.selected { border-color: #4baadd; background: #e9f6fc; }
.ribbon-thumb { width: 30rpx; height: 120rpx; border-radius: 3rpx; }
.charm-thumb { width: 76rpx; height: 76rpx; }
.asset-name { width: 100%; margin-top: 10rpx; overflow: hidden; color: #547489; font-size: 18rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.assigned-wall { width: 100%; margin-top: 4rpx; overflow: hidden; color: #8b9fa9; font-size: 16rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.asset-edit { margin-top: auto; padding: 9rpx 16rpx 2rpx; color: #3f8db3; font-size: 19rpx; }
.selected-mark { position: absolute; top: 8rpx; right: 8rpx; width: 34rpx; height: 34rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #4baadd; color: #fff; font-size: 20rpx; }

.preview-card { margin-bottom: 120rpx; }
.preview-row { min-height: 94rpx; display: flex; align-items: center; gap: 14rpx; border-bottom: 2rpx solid #edf2f5; }
.preview-row:last-child { border-bottom: 0; }
.selected-order { width: 38rpx; height: 38rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: #e5f3fa; color: #3985aa; font-size: 20rpx; }
.preview-thumb { flex-shrink: 0; }
.preview-thumb.ribbon { width: 28rpx; height: 66rpx; }
.preview-thumb.charm { width: 56rpx; height: 56rpx; }
.preview-copy { flex: 1; min-width: 0; }
.preview-copy text { display: block; }
.preview-copy text:first-child { overflow: hidden; color: #315970; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.preview-copy text:last-child { margin-top: 3rpx; color: #8aa0ad; font-size: 18rpx; }
.order-actions { display: flex; gap: 8rpx; }
.order-btn { padding: 10rpx 8rpx; color: #4389ad; font-size: 20rpx; }

.asset-form-card { display: flex; flex-direction: column; }
.upload-box { position: relative; align-self: center; margin-bottom: 34rpx; overflow: hidden; border: 2rpx dashed #9bcbe3; border-radius: 18rpx; background: #edf7fb; }
.upload-box.ribbon-upload { width: 116rpx; height: 390rpx; }
.upload-box.charm-upload { width: 240rpx; height: 240rpx; }
.upload-box > image { width: 100%; height: 100%; }
.upload-placeholder { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; color: #6f9db6; font-size: 20rpx; text-align: center; }
.uploading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: rgba(241, 249, 253, .88); color: #327da3; font-size: 22rpx; }

.bottom-save { position: fixed; z-index: 50; left: 28rpx; right: 28rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); padding: 14rpx; border-radius: 26rpx; background: rgba(243, 248, 251, .95); box-shadow: 0 -8rpx 24rpx rgba(42, 95, 124, .08); }
.bottom-save .primary { width: 100%; }
