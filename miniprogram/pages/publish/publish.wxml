<view class="publish-container">
  <!-- 顶部返回栏 -->
  <view class="nav-bar">
    <view class="back-btn" bindtap="onBackClick">
      <van-icon name="arrow-left" />
      <text>返回</text>
    </view>
    <text class="nav-title">发起活动</text>
    <view class="placeholder"></view>
  </view>

  <form catchsubmit="onSubmit">
    <!-- 基本信息卡片 -->
    <view class="form-card">
      <view class="card-title">基本信息 <text class="required-star">*</text></view>

      <!-- 活动名称 -->
      <view class="form-item">
        <view class="item-label">活动名称 <text class="required-star">*</text></view>
        <van-field value="{{name}}" bind:input="onInput" data-field="name" placeholder="请输入活动名称（最多30字）" maxlength="30" border="{{false}}" required />
      </view>

      <!-- 活动描述 -->
      <view class="form-item">
        <view class="item-label">活动描述 <text class="required-star">*</text></view>
        <van-field value="{{description}}" bind:input="onInput" data-field="description" type="textarea" placeholder="请描述活动详情" autosize border="{{false}}" required />
      </view>

      <!-- 活动时间 -->
      <view class="form-item">
        <view class="item-label">活动时间 <text class="required-star">*</text></view>
        <van-field value="{{activityTime}}" bind:click-input="onTimePickerClick" data-field="activityTime" placeholder="请选择活动时间" readonly right-icon="arrow" border="{{false}}" required />
      </view>

      <!-- 活动地点 -->
      <view class="form-item">
        <view class="item-label">活动地点 <text class="required-star">*</text></view>
        <van-field value="{{location}}" bind:input="onInput" data-field="location" placeholder="请输入活动地点" border="{{false}}" required />
      </view>
    </view>

    <!-- 出行方式卡片 -->
    <view class="form-card">
      <view class="card-title">出行方式 <text class="required-star">*</text></view>

      <view class="checkbox-group">
        <van-checkbox wx:for="{{travelOptions}}" wx:key="index" value="{{item.checked}}" data-value="{{item.value}}" bindchange="onTravelChange" shape="square">
          {{item.label}}
        </van-checkbox>
      </view>

      <!-- 大巴群二维码（只有选择大巴时显示） -->
      <view class="form-item" wx:if="{{showBusQR}}">
        <view class="item-label">大巴群二维码 <text class="required-star">*</text></view>
        <view class="upload-area" bindtap="onUploadQR" data-type="bus">
          <image wx:if="{{busQR}}" src="{{busQR}}" mode="aspectFill" class="uploaded-image"></image>
          <view wx:else class="upload-placeholder">
            <van-icon name="plus" />
            <text>上传二维码</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 集合信息卡片 -->
    <view class="form-card">
      <view class="card-title">
        集合信息 <text class="required-star">*</text>
        <view class="add-btn" bindtap="onAddMeetingPoint">
          <van-icon name="plus" /> 添加集合点
        </view>
      </view>

      <view wx:for="{{meetingPoints}}" wx:key="index" class="meeting-item">
        <view class="meeting-header">
          <text>集合点 {{index + 1}}</text>
          <van-icon name="close" bindtap="onRemoveMeetingPoint" data-index="{{index}}" wx:if="{{index > 0}}" />
        </view>
        <van-cell-group>
          <!-- 集合时间 -->
          <van-field value="{{item.time}}" bind:click-input="onMeetingTimePickerClick" data-index="{{index}}" placeholder="集合时间" readonly right-icon="arrow" />
          <!-- 集合地点 - 修复版本 -->
          <van-field value="{{item.location}}" bind:input="onMeetingLocationInput" data-index="{{index}}" placeholder="集合地点" bindconfirm="onMeetingLocationConfirm" />
        </van-cell-group>
      </view>
    </view>

    <!-- 路线信息卡片 -->
    <view class="form-card">
      <view class="card-title">路线信息 <text class="required-star">*</text></view>

      <view class="form-item">
        <view class="item-label">路线简介</view>
        <van-field value="{{route}}" bind:input="onInput" data-field="route" type="textarea" placeholder="起点 → 途径点 → 终点，行程安排等" autosize border="{{false}}" />
      </view>

      <view class="form-row">
        <view class="form-item half">
          <view class="item-label">预计里程(km)</view>
          <van-field value="{{distance}}" bind:input="onInput" data-field="distance" type="number" placeholder="例如：10" border="{{false}}" />
        </view>
        <view class="form-item half">
          <view class="item-label">累计爬升(m)</view>
          <van-field value="{{climb}}" bind:input="onInput" data-field="climb" type="number" placeholder="例如：500" border="{{false}}" />
        </view>
      </view>

      <view class="form-item">
        <view class="item-label">难度等级 <text class="required-star">*</text></view>
        <van-dropdown-menu>
          <van-dropdown-item value="{{difficulty}}" bindchange="onDifficultyChange" options="{{difficultyOptions}}" />
        </van-dropdown-menu>
      </view>
    </view>

    <!-- 报名限制卡片 -->
    <view class="form-card">
      <view class="card-title">报名限制 <text class="required-star">*</text></view>

      <view class="form-item">
        <view class="item-label">人数限制</view>
        <van-stepper value="{{maxParticipants}}" bindchange="onStepperChange" min="2" max="100" integer />
      </view>

      <!-- 报名截止时间 -->
      <view class="form-item">
        <view class="item-label">报名截止时间</view>
        <van-field value="{{deadline}}" bind:click-input="onTimePickerClick" data-field="deadline" placeholder="默认活动开始前1小时" readonly right-icon="arrow" border="{{false}}" />
      </view>
    </view>

    <!-- 发起人信息卡片 -->
    <view class="form-card">
      <view class="card-title">发起人信息 <text class="required-star">*</text></view>

      <view class="form-item">
        <view class="item-label">发起人微信号</view>
        <van-field value="{{wechat}}" bind:input="onInput" data-field="wechat" placeholder="请输入微信号" border="{{false}}" />
      </view>

      <view class="form-item">
        <view class="item-label">微信群二维码 <text class="required-star">*</text></view>
        <view class="upload-area" bindtap="onUploadQR" data-type="group">
          <image wx:if="{{groupQR}}" src="{{groupQR}}" mode="aspectFill" class="uploaded-image"></image>
          <view wx:else class="upload-placeholder">
            <van-icon name="plus" />
            <text>上传二维码</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 封面图卡片 -->
    <view class="form-card">
      <view class="card-title">封面图（可选）</view>
      <view class="upload-area" bindtap="onUploadCover">
        <image wx:if="{{cover}}" src="{{cover}}" mode="aspectFill" class="uploaded-image"></image>
        <view wx:else class="upload-placeholder">
          <van-icon name="plus" />
          <text>上传封面图</text>
        </view>
      </view>
    </view>

    <!-- 同意条款和提交按钮区域 -->
    <view class="submit-section">
      <view class="agree-wrapper">
        <van-checkbox value="{{agree}}" bindchange="onAgreeChange" shape="square">
          我已阅读并同意
        </van-checkbox>
        <text class="notice-link" bindtap="onNoticeClick">《发起者须知》</text>
      </view>

      <view class="submit-btn">
        <van-button type="info" block form-type="submit" disabled="{{!canSubmit}}">
          发起活动
        </van-button>
      </view>
    </view>

  </form>

  <!-- 日期时间选择器弹窗 -->
  <van-popup show="{{showDatePicker}}" position="bottom" custom-style="height: 60vh;" bind:close="onDateTimeCancel">
    <view class="date-picker-header">
      <text class="date-picker-title">{{currentDatePickerTitle}}</text>
      <van-icon name="close" bindtap="onDateTimeCancel" />
    </view>
    <van-datetime-picker type="datetime" value="{{currentDateTime}}" min-date="{{minDate}}" max-date="{{maxDate}}" bind:confirm="onDateTimeConfirm" bind:cancel="onDateTimeCancel" />
  </van-popup>
</view>


<!-- 发起者须知弹窗 -->
<van-popup show="{{showNotice}}" bindclose="onNoticeClose" position="bottom" round closeable close-icon="close" custom-style="height: 80%;">
  <view class="notice-popup">
    <view class="popup-title">发起者须知</view>
    <view class="popup-content">
      <text class="subtitle">最新发布日期：2026-2-21</text>
      <view class="para">
        <text>欢迎各位wmls成为活动发起者，为保障徒步活动顺利开展，维护所有参与者的合法权益，明确发起者的权利与义务，特制定本须知。请您仔细阅读并充分理解以下条款，勾选“我已阅读并同意”即视为接受本须知全部内容。</text>
      </view>

      <view class="para">
        <text>1.资质声明：您需为具备完全民事行为能力的成年人，确认自身具备相应的组织协调能力、活动路线规划能力及风险预判能力，能够承担发起活动所带来的相关责任。</text>
      </view>

      <view class="para">
        <text>2.责任界定声明：本次活动为您自行发起、自主组织的自愿性户外活动,小程序运营方仅提供活动发布、信息展示的技术服务平台，不参与活动的任何组织、策划、执行环节，不对活动过程中产生的任何人身损害、财产损失承担任何责任，所有活动相关责任均由您作为发起者自行承担。</text>
      </view>

      <view class="para">
        <text class="highlight">3.禁止营利与非法活动：在平台发起的所有徒步活动均禁止营利，活动发起者不得对参与者收取任何费用，或利用活动发起收集到的个人信息和其他数据开展任何其他商业性行为，更不得利用本平台从事任何非法活动。</text>
      </view>

      <view class="para">
        <text class="highlight">4.数据安全义务：发起者在平台中收集的参与者个人信息和其他数据不得用于活动报名统计和联络以外的其他目的，不得借此从事其他非法活动。活动发起者因发起活动收集参与者的个人信息，需确保实际取得参与者的同意，并保护参与者的个人信息，在活动结束后的7日内，删除参与者提交的前述个人信息。</text>
      </view>

      <view class="para">
        <text>5.信息真实性义务：您需保证填写的活动名称、活动时间、活动地点、路线简介、难度等级、预计里程、人数限制等所有活动信息真实、准确、完整，无任何虚假、误导性内容。若因信息不实导致参与者权益受损，您需承担相应责任。</text>
      </view>

      <view class="para">
        <text>6.风险告知义务：您需在活动描述中清晰、全面地告知参与者徒步活动可能存在的各类风险，包括但不限于中暑、蛇虫叮咬、滑倒摔伤、突发疾病、恶劣天气、路况复杂等，不得隐瞒任何关键风险信息。</text>
      </view>

      <view class="para">
        <text>7.责任承担边界：作为活动组织方，您需尽到合理的组织、协调、安全提醒义务。活动期间需做好现场人员清点、行程引导、应急协调等工作；因您故意或重大过失（如未告知重大风险等）导致参与者人身或财产损害的，需承担相应的赔偿责任。</text>
      </view>

      <view class="para">
        <text>8.资料提交要求：</text>
        <text class="highlight">为便于参与者报名活动并及时与您取得联系，</text>
        <text>请按规定提交真实有效的发起人微信号、活动微信群二维码；若活动出行方式包含大巴，还需额外提交大巴群二维码，确保参与者能及时与您取得联络，获取活动相关通知。</text>
        <text class="highlight">我们将在活动结束后的7日内，删除您的个人信息。</text>
      </view>
      <view class="para">
        <text>9.审核配合义务：活动提交后，需积极配合管理员的审核工作。若审核人员提出修改意见，您需在规定时间内完成整改；审核期间如需修改活动信息，需严格按照小程序流程操作，不得擅自篡改。</text>
      </view>
      <view class="para">
        <text>10.活动全流程管理义务：活动开展前，需确认所有参与者信息，明确集合细节并通知到位；活动开展期间，需全程关注参与者状态，及时处理突发情况；活动结束后，需在规定时间内编辑并提交活动回顾总结，包含活动开展情况、精彩瞬间等内容。</text>
      </view>
      <view class="para">
        <text class="highlight">11.知识产权：本平台及相关内容的知识产权归小程序运营方或相关权利人所有。未经授权，任何人不得擅自对相关内容进行使用、复制、传播等。</text>
      </view>
      <view class="para">
        <text>12.免责声明关联要求：若您发起的活动出行方式为自驾或高铁，需知晓活动描述字段末尾将强制包含官方《自驾/高铁行程免责声明》，该声明不可删除。若您有额外免责条款，可补充在官方声明之后，且补充条款不得与官方声明及小程序规则冲突。</text>
      </view>
      <view class="para">
        <text>13.违规处理规则:若存在发起虚假活动、隐瞒重大风险、不履行组织管理义务、提交虚假资料</text>
        <text class="highlight">和违规内容、擅自修改活动信息</text>
        <text>等违规行为，管理员有权驳回您的活动申请、强制下架已发布活动，情节严重的将限制您的活动发起权限，直至永久禁止发起活动。</text>
        <text class="highlight">因您违规造成的任何损失，将由您自行承担责任。因不可抗力导致的服务暂停等，小程序运营方不承担任何责任。</text>
      </view>
      <view class="para">
        <text class="highlight">14.因活动产生的纠纷，由您自行与相关方进行协商解决，小程序运营方不承担任何责任。
        </text>
      </view>
      <view class="para">
        <text>发起活动即视为本人已仔细阅读并充分理解本发起者须知所有条款，自愿承担发起活动相关的责任与义务，同意遵守小程序相关活动管理规定。</text>
        <text class="highlight">本须知自发布更新之日起生效。如您对以上内容有任何疑问或者希望对您提交的个人信息行使权利，请通过【】联系小程序运营方。</text>
      </view>
    </view>
  </view>
</van-popup>