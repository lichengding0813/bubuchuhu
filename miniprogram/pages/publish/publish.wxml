<view class="publish-container">
  <view class="publish-mode-card" wx:if="{{canChoosePublishMode}}">
    <view class="publish-mode-title">选择活动类型</view>
    <view class="publish-mode-options">
      <view class="publish-mode-option {{!isOfficialMode ? 'active' : ''}}" data-mode="normal" bindtap="onPublishModeChange">
        <view class="publish-mode-icon">👟</view>
        <view class="publish-mode-content">
          <text class="publish-mode-name">普通活动</text>
          <text class="publish-mode-desc">提交后进入原有审核流程</text>
        </view>
        <van-icon name="success" wx:if="{{!isOfficialMode}}" color="#4d9fd7" size="18px" />
      </view>
      <view class="publish-mode-option {{isOfficialMode ? 'active' : ''}}" data-mode="official" bindtap="onPublishModeChange">
        <image class="publish-mode-mascot" src="/images/official-badge.png" mode="aspectFit" />
        <view class="publish-mode-content">
          <text class="publish-mode-name">官方活动</text>
          <text class="publish-mode-desc">无需审核，保存后直接发布</text>
        </view>
        <van-icon name="success" wx:if="{{isOfficialMode}}" color="#4d9fd7" size="18px" />
      </view>
    </view>
  </view>
  <view class="official-publish-banner" wx:if="{{isOfficialMode}}">
    <image class="official-banner-v" src="/images/official-badge.png" mode="aspectFit" />
    <view>
      <view class="official-banner-title">官方活动</view>
      <view class="official-banner-desc">保存后直接发布，全部官方账号均可查看和修改</view>
    </view>
  </view>
  <form catchsubmit="onSubmit">
    <!-- 基本信息卡片 -->
    <view class="form-card">
      <view class="card-title">基本信息</view>

      <!-- 活动名称 -->
      <view class="form-item">
        <view class="item-label">活动名称<text class="required-star">*</text></view>
        <view class="official-name-field" wx:if="{{isOfficialMode}}">
          <text class="official-name-prefix">{{officialTitlePrefix}}</text>
          <view class="official-name-input">
            <van-field value="{{name}}" bind:input="onInput" data-field="name" placeholder="请输入活动名称" maxlength="24" border="{{false}}" />
          </view>
        </view>
        <van-field wx:else value="{{name}}" bind:input="onInput" data-field="name" placeholder="请输入活动名称（最多30字）" maxlength="30" border="{{false}}" />
        <text class="official-name-hint" wx:if="{{isOfficialMode}}">官方前缀固定展示，发布时不可删除</text>
      </view>

      <!-- 活动描述 -->
      <view class="form-item">
        <view class="item-label">活动描述<text class="required-star">*</text></view>
        <van-field value="{{description}}" bind:input="onInput" data-field="description" type="textarea" placeholder="请描述活动详情" autosize border="{{false}}" />
      </view>

      <!-- 活动时间 -->
      <view class="form-item">
        <view class="item-label">活动开始时间<text class="required-star">*</text></view>
        <van-field value="{{activityTime}}" bind:click-input="onTimePickerClick" data-field="activityTime" placeholder="请选择开始时间" readonly right-icon="arrow" border="{{false}}" />
      </view>

      <!-- 活动结束时间 -->
      <view class="form-item">
        <view class="item-label">活动结束时间<text class="required-star">*</text></view>
        <van-field value="{{endTime}}" bind:click-input="onTimePickerClick" data-field="endTime" placeholder="默认开始后12小时，可修改" readonly right-icon="arrow" border="{{false}}" />
      </view>

      <!-- 活动地点 -->
      <view class="form-item">
        <view class="item-label">活动地点<text class="required-star">*</text></view>
        <view class="location-field-row">
          <van-field value="{{location}}" bind:input="onInput" data-field="location" placeholder="请输入活动地点" border="{{false}}" />
          <view class="location-picker-btn" bindtap="onChooseActivityLocation">
            <van-icon name="location-o" size="18px" />
            <text>地图选点</text>
          </view>
        </view>
        <view wx:if="{{latitude && longitude}}" class="map-preview">
          <map latitude="{{latitude}}" longitude="{{longitude}}" markers="{{[marker]}}" style="width:100%;height:160rpx;border-radius:12rpx;" />
        </view>
      </view>
    </view>

    <!-- 出行方式卡片 -->
    <view class="form-card">
      <view class="card-title">出行方式<text class="required-star">*</text></view>

      <view class="checkbox-group">
        <van-checkbox wx:for="{{travelOptions}}" wx:key="index" value="{{item.checked}}" data-value="{{item.value}}" bindchange="onTravelChange" shape="square">
          {{item.label}}
        </van-checkbox>
      </view>
      <text class="field-hint">请至少选择一项</text>

    </view>

    <!-- 集合信息卡片 -->
    <view class="form-card">
      <view class="card-title">
        <text>集合信息<text class="required-star">*</text></text>
        <view class="add-btn" bindtap="onAddMeetingPoint">
          <van-icon name="plus" /> 添加集合点
        </view>
      </view>

      <view wx:for="{{meetingPoints}}" wx:key="index" class="meeting-item">
        <view class="meeting-header">
          <text>集合点 {{index + 1}}</text>
          <van-icon name="close" bindtap="onRemoveMeetingPoint" data-index="{{index}}" wx:if="{{index > 0}}" />
        </view>
        <van-cell-group>
          <!-- 集合时间 -->
          <van-field value="{{item.time}}" bind:click-input="onMeetingTimePickerClick" data-index="{{index}}" placeholder="集合时间 *" readonly right-icon="arrow" />
          <!-- 集合地点 - 修复版本 -->
          <view class="meeting-location-row">
            <van-field value="{{item.location}}" bind:input="onMeetingLocationInput" data-index="{{index}}" placeholder="集合地点 *" />
            <view class="meeting-map-btn" bindtap="onChooseMeetingLocation" data-index="{{index}}">
              <van-icon name="location-o" size="18px" />
            </view>
          </view>
        </van-cell-group>
      </view>
    </view>

    <!-- 路线信息卡片 -->
    <view class="form-card">
      <view class="card-title">路线信息</view>

      <view class="form-item">
        <view class="item-label">路线简介<text class="required-star">*</text></view>
        <view class="editor-toolbar">
          <view class="tool-btn {{formatStatus.bold ? 'active' : ''}}" catchtouchstart="onFormat" data-name="bold"><text class="tool-icon-bold">B</text></view>
          <view wx:for="{{fontSizeOptions}}" wx:key="value" class="tool-btn {{currentFontSize === item.value ? 'active' : ''}}" catchtouchstart="onSetFontSize" data-size="{{item.value}}">{{item.label}}</view>
          <view class="tool-btn" catchtouchstart="onInsertDivider">分割线</view>
        </view>
        <view class="editor-toolbar">
          <view wx:for="{{colorList}}" wx:key="*this" class="color-swatch-btn {{currentTextColor === item ? 'selected' : ''}}" style="background:{{item}}" catchtouchstart="onSetColor" data-color="{{item}}"></view>
        </view>
        <view class="editor-format-tip">选中文字后直接点样式；也可以先选样式再输入</view>
        <editor id="editor-route" class="ql-editor" placeholder="起点 → 途径点 → 终点，行程安排等" show-img-toolbar show-img-resize bindtouchstart="onEditorTouchStart" bind:focus="onEditorFocus" bind:blur="onEditorBlur" bind:ready="onEditorReady" bind:input="onEditorInput" bind:statuschange="onEditorStatusChange"></editor>
      </view>

      <view class="form-row">
        <view class="form-item half">
          <view class="item-label">预计里程(km)<text class="field-optional">选填</text></view>
          <van-field value="{{distance}}" bind:input="onInput" data-field="distance" type="number" placeholder="例如：10" border="{{false}}" />
        </view>
        <view class="form-item half">
          <view class="item-label">累计爬升(m)<text class="field-optional">选填</text></view>
          <van-field value="{{climb}}" bind:input="onInput" data-field="climb" type="number" placeholder="例如：500" border="{{false}}" />
        </view>
      </view>

      <view class="form-item">
        <view class="item-label">难度等级<text class="required-star">*</text></view>
        <view class="difficulty-stars">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="star {{difficulty >= item ? 'active' : ''}}" catchtap="onDifficultyTap" data-value="{{item}}">★</text>
          <text class="difficulty-text">{{difficulty}}星</text>
        </view>
      </view>
    </view>

    <!-- 报名限制卡片 -->
    <view class="form-card">
      <view class="card-title">报名限制</view>

      <view class="form-item">
        <view class="item-label">人数限制</view>
        <van-stepper value="{{maxParticipants}}" bindchange="onStepperChange" min="2" max="100" integer />
      </view>

<!-- 新增：是否强制购买保险 -->
<view class="form-item insurance-item">
  <view class="item-label">强制购买户外保险</view>
  <van-radio-group value="{{forceInsurance}}" bindchange="onForceInsuranceChange" direction="horizontal">
    <van-radio name="{{1}}">是</van-radio>
    <van-radio name="{{0}}">否</van-radio>
  </van-radio-group>
</view>
      <!-- 报名截止时间 -->
      <view class="form-item">
        <view class="item-label">报名截止时间<text class="field-optional">选填</text></view>
        <van-field value="{{deadline}}" bind:click-input="onTimePickerClick" data-field="deadline" placeholder="默认活动开始前1小时" readonly right-icon="arrow" border="{{false}}" />
      </view>
    </view>

    <!-- 发起人信息卡片 -->
    <view class="form-card">
      <view class="card-title">发起人信息</view>

      <view class="form-item">
        <view class="item-label">发起人微信号<text class="required-star">*</text></view>
        <van-field value="{{wechat}}" bind:input="onInput" data-field="wechat" placeholder="请输入微信号" border="{{false}}" />
      </view>

      <view class="form-item">
        <view class="item-label">微信群二维码<text class="required-star">*</text></view>
        <view class="upload-area" bindtap="onUploadQR" data-type="group">
          <image wx:if="{{groupQR}}" src="{{groupQR}}" mode="aspectFill" class="uploaded-image"></image>
          <view wx:else class="upload-placeholder">
            <van-icon name="plus" />
            <text>上传二维码</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 封面图卡片 -->
    <view class="form-card">
      <view class="card-title">封面图（可选）</view>
      <view class="upload-area" bindtap="onUploadCover">
        <image wx:if="{{cover}}" src="{{cover}}" mode="aspectFill" class="uploaded-image"></image>
        <view wx:else class="upload-placeholder">
          <van-icon name="plus" />
          <text>上传封面图</text>
        </view>
      </view>
    </view>

    <!-- 同意条款和提交按钮区域 -->
    <view class="submit-section">
      <view class="agree-wrapper">
        <van-checkbox value="{{agree}}" bindchange="onAgreeChange" shape="square">
          我已阅读并同意
        </van-checkbox>
        <text class="notice-link" bindtap="onNoticeClick">《发起者须知》</text>
      </view>

      <view class="submit-btn">
        <van-button type="info" block form-type="submit" disabled="{{!canSubmit}}" custom-class="publish-primary-button">
          {{isOfficialMode ? (editActivityId ? '保存官方活动' : '直接发布官方活动') : '发起活动'}}
        </van-button>
      </view>

      <view class="draft-btn" wx:if="{{!editActivityId && !isOfficialMode}}">
        <van-button type="info" plain block bindtap="onSaveDraft" custom-class="publish-secondary-button">
          暂存草稿
        </van-button>
      </view>
    </view>

  </form>

  <!-- 日期时间选择器弹窗 -->
<!-- 日期时间选择器弹窗（自定义实现） -->
<van-popup show="{{showDatePicker}}" position="bottom" custom-style="height: 50vh;" bind:close="onDateTimeCancel">
  <view class="date-picker-header">
    <text class="date-picker-title">{{currentDatePickerTitle}}</text>
    <van-icon name="close" bindtap="onDateTimeCancel" />
  </view>
  
  <view class="custom-datetime-picker">
    <picker-view 
      indicator-style="height: 40px;" 
      style="width: 100%; height: 200px;" 
      value="{{pickerValue}}" 
      bindchange="onPickerChange"
    >
      <!-- 年 -->
      <picker-view-column>
        <view wx:for="{{years}}" wx:key="index" style="text-align: center; line-height: 40px;">{{item}}年</view>
      </picker-view-column>
      <!-- 月 -->
      <picker-view-column>
        <view wx:for="{{months}}" wx:key="index" style="text-align: center; line-height: 40px;">{{item}}月</view>
      </picker-view-column>
      <!-- 日 -->
      <picker-view-column>
        <view wx:for="{{days}}" wx:key="index" style="text-align: center; line-height: 40px;">{{item}}日</view>
      </picker-view-column>
      <!-- 时 -->
      <picker-view-column>
        <view wx:for="{{hours}}" wx:key="index" style="text-align: center; line-height: 40px;">{{item}}时</view>
      </picker-view-column>
      <!-- 分（仅 00 和 30）-->
      <picker-view-column>
        <view wx:for="{{minutes}}" wx:key="index" style="text-align: center; line-height: 40px;">{{item}}分</view>
      </picker-view-column>
    </picker-view>
    
    <view class="picker-buttons">
      <van-button size="small" bindtap="onDateTimeCancel">取消</van-button>
      <van-button type="info" size="small" bindtap="onCustomDateTimeConfirm">确定</van-button>
    </view>
  </view>
</van-popup>
</view>
