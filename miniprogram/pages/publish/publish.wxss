/* pages/publish/publish.wxss */
page {
  background-color: #f0faff;
}

.publish-container {
  padding: 16px;
  padding-bottom: 40px;
}

.form-card {
  background-color: white;
  border-radius: 20px;
  padding: 20px 16px;
  margin-bottom: 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
  margin-bottom: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.required-star {
  color: #ff6b6b;
  margin-left: 2px;
}

.notice-card {
  background-color: #e3f0ff;
}

.notice-content {
  background-color: rgba(255, 255, 255, 0.6);
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
}

.notice-content text {
  display: block;
  color: #1e4d7c;
  font-size: 14px;
  line-height: 1.8;
}

.agree-checkbox {
  margin-top: 8px;
}

.form-item {
  margin-bottom: 16px;
}

.form-item:last-child {
  margin-bottom: 0;
}

.item-label {
  font-size: 15px;
  color: #2e4d73;
  margin-bottom: 8px;
  font-weight: 500;
  display: flex;
  align-items: center;
  min-height: 24px;
}

.required-star {
  color: #ff6b6b;
  margin-left: 2px;
  font-size: 16px;
  line-height: 1;
}

.form-row {
  display: flex;
  gap: 12px;
}

.form-item.half {
  flex: 1;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 16px;
}

.add-btn {
  display: flex;
  align-items: center;
  color: #5faee3;
  font-size: 14px;
  padding: 4px 8px;
  background-color: rgba(95, 174, 227, 0.1);
  border-radius: 16px;
}

.meeting-item {
  background-color: #f8fcff;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
}

.meeting-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  color: #1e4d7c;
  font-weight: 500;
}

.upload-area {
  width: 100px;
  height: 100px;
  background-color: #f0f7ff;
  border: 2px dashed #96c9ff;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5faee3;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.upload-placeholder text {
  font-size: 12px;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 10px;
}

.submit-btn {
  margin-top: 24px;
  margin-bottom: 20px;
}

.submit-btn van-button {
  --button-primary-background-color: #96c9ff;
  --button-primary-border-color: #96c9ff;
  border-radius: 30px !important;
  height: 48px !important;
  line-height: 48px !important;
  font-weight: 500 !important;
}


/* 同意条款和提交按钮区域 */
.submit-section {
  background-color: white;
  border-radius: 20px 20px 0 0;
  padding: 16px;
  margin-top: 16px;
  border: 1px solid rgba(160, 200, 255, 0.4);
  box-shadow: 0 -4px 12px rgba(0, 130, 210, 0.04);
}

.agree-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  padding: 8px 0;
}

.notice-link {
  color: #5faee3;
  text-decoration: underline;
  margin-left: 4px;
}

/* 发起者须知卡片样式调整 */
.notice-card .notice-content {
  background-color: rgba(95, 174, 227, 0.1);
  border-radius: 12px;
  padding: 12px;
  text-align: center;
  color: #1e4d7c;
}

.notice-card .notice-content text {
  color: #5faee3;
  font-weight: 500;
}

/* 弹窗样式 */
.notice-popup {
  padding: 20px;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 副标题样式 - 用于一、发起者须知等 */
.subtitle {
  font-size: 18px !important;  /* 添加 !important 强制生效 */
  font-weight: 700 !important;
  color: #1e4d7c !important;
  margin: 8px 0 16px 0 !important;  /* 增加下方间距到20px */
  display: block !important;
  background-color: #e6f7ff !important;
  padding: 8px 12px !important;
  border-radius: 8px !important;
  border-left: 4px solid #96c9ff !important;
}

/* 弹窗内容样式 - 让text组件内联显示 */
.popup-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 4px;
  font-size: 14px;
  color: #2e4d73;
  line-height: 1.8;
}

/* 让所有text组件内联显示，去除换行带来的空格 */
.popup-content text {
  display: inline;
  white-space: normal;
  word-wrap: break-word;
}

/* 高亮样式 */
.highlight {
  color: #f5222d;
  font-weight: 700;
  background-color: transparent;
}

/* 段落换行处理 */
.popup-content view {
  margin-bottom: 12px;
}

.popup-title {
  font-size: 20px;
  font-weight: 600;
  color: #1e4d7c;
  text-align: center;
  margin-bottom: 20px;
  padding-bottom: 12px;
}

.popup-countdown {
  text-align: center;
  font-size: 13px;
  color: #ff6b6b;
  margin-bottom: 12px;
  font-weight: 500;
}

/* 调整原有提交按钮样式 */
.submit-btn {
  margin-top: 0;
}

.draft-btn {
  margin-top: 12px;
  margin-bottom: 8px;
}

.draft-btn van-button {
  --button-default-color: #5faee3;
  --button-default-border-color: #5faee3;
  border-radius: 30px !important;
  height: 44px !important;
  line-height: 44px !important;
}

.date-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.date-picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* pages/profile/profile.wxss */
page {
  background-color: #e6f7ff;
  height: 100%;
  overflow-y: auto;
}

.profile-container {
  background-color: #f0faff;
  min-height: 100vh;
  padding: 20rpx 30rpx 40rpx;
}

/* 用户信息卡片 - 渐变蓝色 */
.user-card {
  background: linear-gradient(135deg, #96c9ff 0%, #5faee3 100%);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  position: relative;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 110, 200, 0.2);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  overflow: hidden;
  margin-right: 30rpx;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(0, 50, 100, 0.3);
  background-color: #b7daf9;
}

.user-avatar image, .user-avatar open-data {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0, 50, 100, 0.3);
}

.user-meta {
  font-size: 24rpx;
  opacity: 0.95;
  margin-bottom: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.user-meta text {
  background-color: rgba(255, 255, 255, 0.2);
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  color: #ffffff;
  font-size: 22rpx;
}

/* user-badge 样式 - 替换原来的 .user-badge 相关样式 */
.user-badge {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.badge-item {
  display: flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.badge-item.verified {
  background-color: rgba(70, 200, 140, 0.8);
  border: 2rpx solid rgba(70, 200, 140, 0.2);
}

.verified-icon {
  font-size: 28rpx !important;
  margin-right: 4rpx;
  color: #ffffff !important;
}

.badge-item.phone {
  background-color: rgba(100, 150, 255, 0.8);
  border: 2rpx solid rgba(100, 150, 255, 0.2);
}

.phone-icon {
  font-size: 26rpx !important;
  margin-right: 4rpx;
  color: #ffffff !important;
}

.arrow-icon {
  color: #ffffff;
  opacity: 0.9;
  font-size: 40rpx !important;
}

/* 统计数据卡片 */
.stats-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  display: flex;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 130, 210, 0.08);
  border: 2rpx solid rgba(150, 200, 255, 0.4);
}

.stat-item {
  flex: 1;
  text-align: center;
  position: relative;
  cursor: pointer;
  transition: transform 0.2s;
}

.stat-item:active {
  transform: scale(0.98);
}

.stat-item:first-child::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  height: 60%;
  width: 2rpx;
  background-color: #d0e8ff;
}

.stat-number {
  display: block;
  font-size: 52rpx;
  font-weight: 700;
  color: #1e4d7c;
  margin-bottom: 8rpx;
  line-height: 1.2;
}

.stat-label {
  font-size: 28rpx;
  color: #5f7fa3;
  font-weight: 400;
}

/* 菜单列表 */
.menu-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 130, 210, 0.08);
  border: 2rpx solid rgba(150, 200, 255, 0.4);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 30rpx;
  border-bottom: 2rpx solid #e6f0ff;
  transition: background-color 0.2s;
}

.menu-item:active {
  background-color: #f0f9ff;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  margin-right: 24rpx;
  color: #5faee3 !important;
  font-size: 40rpx !important;
}

.menu-left text {
  font-size: 30rpx;
  color: #1e4d7c;
  font-weight: 450;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-arrow {
  color: #a0c9f0 !important;
  font-size: 32rpx !important;
}

/* 红点提示 */
.menu-right .van-badge {
  background-color: #ff8a8a !important;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(255, 100, 100, 0.4);
}

/* 退出登录按钮 */
.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff !important;
  border: 2rpx solid #ffb5b5 !important;
  border-radius: 44rpx !important;
  color: #ff8080 !important;
  font-size: 32rpx !important;
  font-weight: 500 !important;
  margin-top: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 150, 150, 0.2);
  transition: all 0.2s;
}

.logout-btn:active {
  background-color: #fff5f5 !important;
  transform: scale(0.98);
}

.logout-btn::after {
  border: none;
}

/* 查看全部入口卡片 - 复用home样式 */
.view-all-card {
  background-color: #ffffffd6;
  border: 2rpx dashed #98c5f0;
  border-radius: 40rpx;
  padding: 24rpx 30rpx;
  text-align: center;
  color: #2e7eb0;
  font-size: 28rpx;
  font-weight: 500;
  margin: 20rpx 0 10rpx;
  backdrop-filter: blur(2px);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color 0.2s;
}

.view-all-card:active {
  background-color: #e8f2ff;
}

.view-all-card van-icon {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: #5e9ad9;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.loading-text {
  color: #5f7fa3;
  font-size: 28rpx;
  margin-top: 20rpx;
}

/* 空状态 */
.empty-state {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  border: 2rpx dashed #c0e0ff;
  margin: 20rpx 0;
}

.empty-icon {
  font-size: 80rpx !important;
  color: #b7daf9 !important;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #7f9fbf;
  font-size: 28rpx;
}

/* 弹窗样式 - 复用home的蓝色主题 */
.custom-dialog {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.dialog-container {
  position: relative;
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(30, 110, 180, 0.3);
  z-index: 1001;
}

.dialog-image {
  width: 50%;
  height: auto;
  display: block;
  border-radius: 32rpx;
  margin: 20rpx auto 20rpx auto;
}

.dialog-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1e4d7c;
  text-align: center;
}

.dialog-content {
  padding: 0 32rpx 24rpx;
  align-items: center;
}

.question {
  font-size: 32rpx;
  color: #2e5a8a;
  margin-bottom: 24rpx;
  text-align: center;
  font-weight: 500;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  background-color: #f0f9ff;
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #1e3e60;
  box-sizing: border-box;
  border: 2rpx solid #c0e0ff;
  transition: border-color 0.2s;
}

.dialog-input:focus {
  border-color: #5faee3;
  background-color: #ffffff;
}

.error-tip {
  color: #ff6b6b;
  font-size: 26rpx;
  margin-top: 16rpx;
  text-align: center;
  font-weight: 400;
}

.plain-text {
  font-size: 28rpx;
  color: #2e5a8a;
  text-align: center;
  padding: 20rpx 0;
}

.dialog-buttons {
  display: flex;
  border-top: 2rpx solid #d9ecff;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  cursor: pointer;
  transition: background-color 0.2s;
  font-weight: 500;
}

.dialog-btn-cancel {
  color: #7f8c8d;
  border-right: 2rpx solid #d9ecff;
  background-color: #f9fcff;
}

.dialog-btn-cancel:active {
  background-color: #e6f0fa;
}

.dialog-btn-confirm {
  color: #ffffff;
  background-color: #5faee3;
}

.dialog-btn-confirm:active {
  background-color: #4a9ad0;
}

/* 小工具类 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

/* 分割线 */
.divider {
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c0e0ff, transparent);
  margin: 30rpx 0;
}

.custom-datetime-picker {
  padding: 20rpx;
}
.picker-buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 20rpx;
}


/* 难度选择 - 左右排布 */
.difficulty-row {
  display: flex;
  align-items: center;
  gap: 12px;
}

.difficulty-label {
  margin-bottom: 0;
  white-space: nowrap;
  flex-shrink: 0;
}

.difficulty-dropdown {
  flex: 0 0 auto;
  width: 120px;
}

.difficulty-dropdown van-dropdown-menu {
  --dropdown-menu-height: 40px;
  box-shadow: none;
}

/* 强制保险单选框 - 样式修复 */
.insurance-item {
  margin-bottom: 20px;          /* 与上下表单项保持统一间距 */
}

.insurance-item .item-label {
  margin-bottom: 12px;          /* 标签与单选按钮组间距 */
  font-weight: 500;
}

/* 覆盖 van-radio-group 默认布局，确保垂直居中对齐 */
.insurance-item van-radio-group {
  display: flex;
  align-items: center;          /* 垂直居中 */
  gap: 24px;                    /* 两个选项之间的间距 */
  flex-wrap: wrap;              /* 小屏幕自动换行 */
}

/* 单个 van-radio 样式调整 */
.insurance-item van-radio {
  --radio-label-margin: 0 0 0 8px;   /* 文字与圆圈间距 */
  --radio-label-color: #2e4d73;      /* 文字颜色匹配表单主题 */
  --radio-label-font-size: 15px;     /* 与 item-label 字体大小一致 */
  --radio-size: 18px;                /* 圆圈大小 */
  --radio-checked-icon-color: #5faee3; /* 选中时的蓝色 */
}

/* 提示文字样式（与表单通用提示统一） */
.insurance-tip {
  margin-top: 12px;
  font-size: 13px;
  color: #7f9fbf;
  display: flex;
  align-items: center;
  gap: 6px;
  background-color: #f0f9ff;
  padding: 8px 12px;
  border-radius: 8px;
}