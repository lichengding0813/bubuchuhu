/* pages/publish/publish.wxss */
page {
  background-color: #f0faff;
}

.publish-container {
  padding: 16px;
  padding-bottom: 40px;
}

.publish-mode-card {
  padding: 16px;
  margin-bottom: 14px;
  border: 1px solid rgba(160, 200, 255, 0.45);
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.07);
}

.publish-mode-title {
  margin-bottom: 11px;
  color: #1e4d7c;
  font-size: 16px;
  font-weight: 600;
}

.publish-mode-options {
  display: flex;
  gap: 10px;
}

.publish-mode-option {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 8px;
  padding: 12px 10px;
  border: 1px solid #dbeaf5;
  border-radius: 14px;
  box-sizing: border-box;
  background: #f9fcff;
}

.publish-mode-option.active {
  border-color: #72b7e6;
  background: #eff8ff;
  box-shadow: inset 0 0 0 1px rgba(77, 159, 215, 0.12);
}

.publish-mode-icon,
.publish-mode-mascot {
  flex-shrink: 0;
  width: 28px;
  height: 28px;
}

.publish-mode-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
}

.publish-mode-content {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.publish-mode-name {
  color: #285b83;
  font-size: 13px;
  font-weight: 600;
}

.publish-mode-desc {
  margin-top: 2px;
  color: #8aa1b5;
  font-size: 9px;
  line-height: 1.35;
}

.official-publish-banner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(47, 128, 197, 0.22);
  border-radius: 20rpx;
  background: linear-gradient(135deg, #e8f5ff 0%, #f7fbff 100%);
}

.official-banner-v {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
}

.official-banner-title {
  color: #1f5f96;
  font-size: 28rpx;
  font-weight: 600;
}

.official-banner-desc {
  margin-top: 4rpx;
  color: #6d8eaa;
  font-size: 22rpx;
  line-height: 1.4;
}

.official-name-field {
  display: flex;
  min-height: 44px;
  align-items: center;
  overflow: hidden;
  border: 1px solid #d9e9f5;
  border-radius: 12px;
  background: #fff;
}

.official-name-prefix {
  flex-shrink: 0;
  padding-left: 13px;
  color: #2f80b9;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}

.official-name-input {
  min-width: 0;
  flex: 1;
}

.official-name-hint {
  display: block;
  margin-top: 6px;
  color: #8aa1b5;
  font-size: 11px;
}

.form-card {
  background-color: white;
  border-radius: 20px;
  padding: 20px 16px;
  margin-bottom: 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
  margin-bottom: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.required-star {
  color: #ff6b6b;
  margin-left: 2px;
}

.notice-card {
  background-color: #e3f0ff;
}

.notice-content {
  background-color: rgba(255, 255, 255, 0.6);
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
}

.notice-content text {
  display: block;
  color: #1e4d7c;
  font-size: 14px;
  line-height: 1.8;
}

.agree-checkbox {
  margin-top: 8px;
}

.form-item {
  margin-bottom: 16px;
}

.form-item:last-child {
  margin-bottom: 0;
}

.item-label {
  font-size: 15px;
  color: #2e4d73;
  margin-bottom: 8px;
  font-weight: 500;
  display: flex;
  align-items: center;
  min-height: 24px;
}

.required-star {
  color: #ff6b6b;
  margin-left: 2px;
  font-size: 16px;
  line-height: 1;
}

.field-optional {
  margin-left: 6px;
  font-size: 12px;
  color: #9e9e9e;
  background-color: #f5f5f5;
  padding: 1px 6px;
  border-radius: 4px;
  font-weight: 400;
}

.field-hint {
  display: block;
  font-size: 12px;
  color: #9e9e9e;
  margin-top: -8px;
}

.form-row {
  display: flex;
  gap: 12px;
}

.form-item.half {
  flex: 1;
}

.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 16px;
}

.add-btn {
  display: flex;
  align-items: center;
  color: #5faee3;
  font-size: 14px;
  padding: 4px 8px;
  background-color: rgba(95, 174, 227, 0.1);
  border-radius: 16px;
}

.meeting-item {
  background-color: #f8fcff;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 12px;
}

.meeting-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
  color: #1e4d7c;
  font-weight: 500;
}

.upload-area {
  width: 100px;
  height: 100px;
  background-color: #f0f7ff;
  border: 2px dashed #96c9ff;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5faee3;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.upload-placeholder text {
  font-size: 12px;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 10px;
}

.location-field-row,
.meeting-location-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.location-field-row van-field,
.meeting-location-row van-field {
  flex: 1;
  min-width: 0;
}

.location-picker-btn,
.meeting-map-btn {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #3f91c9;
  border: 1px solid rgba(95, 174, 227, 0.42);
  background: #eef8fe;
}

.location-picker-btn {
  gap: 4px;
  min-width: 92px;
  height: 40px;
  padding: 0 10px;
  border-radius: 13px;
  box-sizing: border-box;
  font-size: 12px;
  font-weight: 600;
}

.meeting-map-btn {
  width: 40px;
  height: 40px;
  margin-right: 8px;
  border-radius: 12px;
}

.submit-btn {
  margin-top: 24px;
  margin-bottom: 20px;
}

.submit-btn van-button {
  --button-primary-background-color: #96c9ff;
  --button-primary-border-color: #96c9ff;
  border-radius: 30px !important;
  height: 48px !important;
  line-height: 48px !important;
  font-weight: 500 !important;
}


/* 同意条款和提交按钮区域 */
.submit-section {
  background-color: white;
  border-radius: 20px 20px 0 0;
  padding: 16px;
  margin-top: 16px;
  border: 1px solid rgba(160, 200, 255, 0.4);
  box-shadow: 0 -4px 12px rgba(0, 130, 210, 0.04);
}

.agree-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16px;
  padding: 8px 0;
}

.notice-link {
  color: #5faee3;
  text-decoration: underline;
  margin-left: 4px;
}

/* 发起者须知卡片样式调整 */
.notice-card .notice-content {
  background-color: rgba(95, 174, 227, 0.1);
  border-radius: 12px;
  padding: 12px;
  text-align: center;
  color: #1e4d7c;
}

.notice-card .notice-content text {
  color: #5faee3;
  font-weight: 500;
}

/* 弹窗样式 */
.notice-popup {
  padding: 20px;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 副标题样式 - 用于一、发起者须知等 */
.subtitle {
  font-size: 18px !important;  /* 添加 !important 强制生效 */
  font-weight: 700 !important;
  color: #1e4d7c !important;
  margin: 8px 0 16px 0 !important;  /* 增加下方间距到20px */
  display: block !important;
  background-color: #e6f7ff !important;
  padding: 8px 12px !important;
  border-radius: 8px !important;
  border-left: 4px solid #96c9ff !important;
}

/* 弹窗内容样式 - 让text组件内联显示 */
.popup-content {
  flex: 1;
  overflow-y: auto;
  padding: 0 4px;
  font-size: 14px;
  color: #2e4d73;
  line-height: 1.8;
}

/* 让所有text组件内联显示，去除换行带来的空格 */
.popup-content text {
  display: inline;
  white-space: normal;
  word-wrap: break-word;
}

/* 高亮样式 */
.highlight {
  color: #f5222d;
  font-weight: 700;
  background-color: transparent;
}

/* 段落换行处理 */
.popup-content view {
  margin-bottom: 12px;
}

.popup-title {
  font-size: 20px;
  font-weight: 600;
  color: #1e4d7c;
  text-align: center;
  margin-bottom: 20px;
  padding-bottom: 12px;
}

.popup-countdown {
  text-align: center;
  font-size: 13px;
  color: #ff6b6b;
  margin-bottom: 12px;
  font-weight: 500;
}

/* 调整原有提交按钮样式 */
.submit-btn {
  margin-top: 0;
}

.draft-btn {
  margin-top: 12px;
  margin-bottom: 8px;
}

.draft-btn van-button {
  --button-default-color: #5faee3;
  --button-default-border-color: #5faee3;
  border-radius: 30px !important;
  height: 44px !important;
  line-height: 44px !important;
}

.publish-primary-button,
.publish-secondary-button {
  overflow: hidden;
  width: 100% !important;
  height: 48px !important;
  border-radius: 24px !important;
  font-size: 15px !important;
  font-weight: 600 !important;
  line-height: 48px !important;
}

.publish-primary-button {
  --button-info-background-color: #4d9fd7;
  --button-info-border-color: #4d9fd7;
}

.publish-secondary-button {
  color: #4d9fd7 !important;
  border-color: #77b7e2 !important;
  background: #fff !important;
}

.date-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.date-picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.custom-datetime-picker {
  padding: 20rpx;
}
.picker-buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 20rpx;
  padding: 20rpx;
}


/* 难度星级选择 */
.difficulty-stars {
  display: flex;
  align-items: center;
  gap: 4px;
}

.difficulty-stars .star {
  font-size: 28px;
  color: #ddd;
  line-height: 1;
}

.difficulty-stars .star.active {
  color: #ffc107;
}

.difficulty-text {
  margin-left: 8px;
  font-size: 14px;
  color: #5f7fa3;
}

/* 强制保险单选框 - 样式修复 */
.insurance-item {
  margin-bottom: 20px;
}

/* ====== 富文本编辑器工具栏 ====== */
.editor-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background-color: #f5faff;
  border-radius: 12px 12px 0 0;
  border: 1px solid #d8e8f5;
  border-bottom: none;
}

.editor-toolbar + .editor-toolbar {
  border-radius: 0;
  border-top: none;
  padding-top: 4px;
}

.tool-picker {
  flex-shrink: 0;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6px 10px;
  font-size: 13px;
  color: #5f7fa3;
  background-color: #fff;
  border-radius: 8px;
  border: 1px solid #e0e8f0;
  min-width: 32px;
  white-space: nowrap;
  flex-shrink: 0;
}

.tool-btn.active {
  background-color: #5faee3;
  color: #fff;
  border-color: #5faee3;
}

.tool-icon-bold {
  font-weight: 700;
  font-size: 14px;
}

.color-swatch-btn {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid #ddd;
  flex-shrink: 0;
}

.color-swatch-btn.selected {
  border-color: #5faee3;
  box-shadow: 0 0 0 2px rgba(95, 174, 227, 0.3);
}

.editor-format-tip {
  padding: 4px 12px 8px;
  color: #7f9fbf;
  font-size: 12px;
  line-height: 1.4;
  background-color: #f5faff;
  border-right: 1px solid #d8e8f5;
  border-left: 1px solid #d8e8f5;
}

.ql-editor {
  width: 100%;
  min-height: 200rpx;
  padding: 16px 12px;
  font-size: 15px;
  line-height: 1.6;
  background-color: #fff;
  border-radius: 0 0 12px 12px;
  border: 1px solid #d8e8f5;
  border-top: none;
  box-sizing: border-box;
}

.insurance-item .item-label {
  margin-bottom: 12px;          /* 标签与单选按钮组间距 */
  font-weight: 500;
}

/* 覆盖 van-radio-group 默认布局，确保垂直居中对齐 */
.insurance-item van-radio-group {
  display: flex;
  align-items: center;          /* 垂直居中 */
  gap: 24px;                    /* 两个选项之间的间距 */
  flex-wrap: wrap;              /* 小屏幕自动换行 */
}

/* 单个 van-radio 样式调整 */
.insurance-item van-radio {
  --radio-label-margin: 0 0 0 8px;   /* 文字与圆圈间距 */
  --radio-label-color: #2e4d73;      /* 文字颜色匹配表单主题 */
  --radio-label-font-size: 15px;     /* 与 item-label 字体大小一致 */
  --radio-size: 18px;                /* 圆圈大小 */
  --radio-checked-icon-color: #5faee3; /* 选中时的蓝色 */
}

/* 提示文字样式（与表单通用提示统一） */
.insurance-tip {
  margin-top: 12px;
  font-size: 13px;
  color: #7f9fbf;
  display: flex;
  align-items: center;
  gap: 6px;
  background-color: #f0f9ff;
  padding: 8px 12px;
  border-radius: 8px;
}
