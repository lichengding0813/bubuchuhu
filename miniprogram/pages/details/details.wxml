<view class="detail-container">
  <!-- 活动封面图 -->
  <view class="cover-section">
    <image class="cover-image" src="{{activityDetail.cover}}" mode="aspectFill" bindtap="previewCoverImage" data-src="{{activityDetail.cover}}"></image>
    <view class="cover-tag" wx:if="{{activityDetail.status}}">{{activityDetail.status}}</view>
  </view>

  <!-- 活动基本信息卡片 -->
  <view class="info-card">
    <view class="activity-title-row">
      <view class="activity-title activity-title-with-brand">
        <text class="activity-title-text">{{activityDetail.name}}</text>
      </view>
      <view class="official-title-badge official-chip" wx:if="{{activityDetail.isOfficial}}">
        <image class="official-mascot official-mascot--tiny" src="/images/official-badge.png" mode="aspectFit" />
        <text>官方</text>
      </view>
    </view>
    <view class="activity-meta">
      <view class="meta-item">
        <van-icon name="clock-o" />
        <text>{{activityDetail.time}}<text wx:if="{{activityDetail.endTime}}"> 至 {{activityDetail.endTime}}</text></text>
      </view>
      <view class="meta-item {{activityDetail.latitude != null ? 'clickable-location' : ''}}" bindtap="openActivityLocation">
        <van-icon name="location-o" />
        <text>{{activityDetail.location}}</text>
      </view>
    </view>
    <view class="activity-stats">
      <view class="stat-item">
        <text class="stat-label">难度</text>
        <text class="stat-value">{{activityDetail.difficulty}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">里程</text>
        <text class="stat-value">{{activityDetail.distance}}km</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">爬升</text>
        <text class="stat-value">{{activityDetail.climb}}m</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">{{activityDetail.rawStatus === 4 ? '参与人数' : '剩余名额'}}</text>
        <text class="stat-value">{{activityDetail.rawStatus === 4 ? activityDetail.participantCount + '人' : activityDetail.remainCount + '/' + activityDetail.totalCount}}</text>
      </view>
    </view>
  </view>

  <!-- 发起人信息卡片 -->
  <view class="info-card">
    <view class="card-title">发起人信息</view>
    <view class="organizer-info">
      <view class="organizer-avatar-wrap">
        <view class="organizer-avatar">
          <image src="{{activityDetail.creatorAvatar}}" mode="aspectFill"></image>
        </view>
        <image class="organizer-avatar-v" wx:if="{{activityDetail.isOfficial}}" src="/images/official-badge.png" mode="aspectFit" />
      </view>
      <view class="organizer-detail">
        <view class="organizer-name-row">
          <text class="organizer-name">{{activityDetail.organizer}}</text>
        </view>
        <text class="organizer-wechat">微信号：{{activityDetail.wechat}}</text>
      </view>
    </view>
    <!-- <view class="qr-section">
      <view class="qr-item">
        <text class="qr-label">活动群</text>
        <image class="qr-image" src="{{activityDetail.groupQR}}" mode="aspectFill" bindtap="previewQRCode" data-url="{{activityDetail.groupQR}}"></image>
      </view>
    </view> -->
  </view>



  <!-- 活动详情卡片 -->
  <view class="info-card">
    <view class="card-title">活动详情</view>
    <view class="travel-options">
      <view class="travel-tag" wx:for="{{activityDetail.travel}}" wx:key="*this" wx:for-item="item">
        <text wx:if="{{item === 'bus'}}">🚌 大巴</text>
        <text wx:elif="{{item === 'train'}}">🚄 高铁</text>
        <text wx:elif="{{item === 'self'}}">🚗 自驾</text>
      </view>
    </view>
    <view class="detail-content">
      <text class="detail-text">{{activityDetail.description}}</text>
    </view>
  </view>

  <!-- 天气预报 -->
  <view class="info-card weather-card" wx:if="{{weatherLoading || (weather.daily && weather.daily.length > 0) || weatherMessage}}">
    <view class="card-title">天气预报<text wx:if="{{weather.city}}"> · {{weather.city}}</text></view>
    <view class="weather-state" wx:if="{{weatherLoading}}"><van-loading size="18px">天气加载中...</van-loading></view>
    <scroll-view wx:elif="{{weather.daily && weather.daily.length > 0}}" scroll-x class="weather-scroll" enable-flex>
      <view class="weather-day" wx:for="{{weather.daily}}" wx:key="date">
        <text class="weather-date">{{item.date.length > 5 ? item.date.slice(5) : item.date}}</text>
        <van-icon name="{{item.icon}}" size="28px" color="#5faee3" />
        <text class="weather-text">{{item.text_day}}</text>
        <text class="weather-temp">{{item.low}}° ~ {{item.high}}°</text>
      </view>
    </scroll-view>
    <view class="weather-state weather-error" wx:else>{{weatherMessage}}</view>
  </view>

  <!-- 路线信息卡片 -->
  <view class="info-card" style="margin-bottom: 120rpx;">
    <view class="card-title">路线信息</view>
    <view class="route-info">
      <rich-text class="route-text" nodes="{{activityDetail.route}}"></rich-text>
    </view>

    <!-- 集合点列表 - 新增 -->
    <view class="meeting-points-section" wx:if="{{activityDetail.meetingPoints && activityDetail.meetingPoints.length > 0}}">
      <view class="section-subtitle">集合点信息</view>
      <view class="meeting-points-list">
        <view class="meeting-point-item" wx:for="{{activityDetail.meetingPoints}}" wx:key="_key" wx:for-index="idx">
          <view class="meeting-point-order">集合点 {{idx + 1}}</view>
          <view class="meeting-point-detail">
            <view class="meeting-point-time">
              <van-icon name="clock-o" size="14px" />
              <text>{{item.meeting_time || item.time}}</text>
            </view>
            <view class="meeting-point-location {{item.latitude != null ? 'clickable-location' : ''}}" bindtap="openMeetingLocation" data-index="{{idx}}">
              <van-icon name="location-o" size="14px" />
              <text>{{item.location}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="route-meta">
      <text>报名截止：{{activityDetail.deadline}}</text>
    </view>
  </view>

  <!-- 详情页右下角悬浮抽奖卡 -->
  <view class="lottery-float {{!lotteryInfo.can_draw && lotteryInfo.phase !== 'not_started' ? 'lottery-exhausted' : ''}}" wx:if="{{hasLottery}}" catchtap="onLotteryClick">
    <view class="lottery-float-header">
      <view class="lottery-float-title"><text class="lottery-wheel-icon">🎡</text><text>{{lotteryInfo.lottery_name || '活动抽奖'}}</text></view>
      <text class="lottery-live-tag {{lotteryInfo.phase === 'not_started' ? 'waiting' : ''}}">{{lotteryInfo.phase === 'not_started' ? '未开始' : '进行中'}}</text>
    </view>
    <view class="lottery-countdown-row">
      <text class="lottery-countdown-label">{{lotteryCountdownLabel}}</text>
      <text class="lottery-countdown-value">{{lotteryCountdown}}</text>
    </view>
    <scroll-view class="lottery-prize-scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{lotteryInfo.prizes && lotteryInfo.prizes.length}}">
      <view class="lottery-prize-list">
        <view class="lottery-prize-item" wx:for="{{lotteryInfo.prizes}}" wx:key="id">
          <image class="lottery-prize-image" wx:if="{{item.image_url}}" src="{{item.image_url}}" mode="aspectFill" />
          <view class="lottery-prize-placeholder" wx:else>🎁</view>
          <text class="lottery-prize-name">{{item.tier_name}}</text>
          <text class="lottery-prize-quantity">{{item.quantity}}份 · {{item.probability}}%</text>
        </view>
      </view>
    </scroll-view>
    <view class="lottery-float-action">{{lotteryActionText}} <van-icon name="arrow" size="12px" /></view>
  </view>

  <!-- 抽奖弹窗 -->
  <lottery-popup show="{{showLotteryPopup}}" lotteryInfo="{{lotteryInfo}}" bind:close="onLotteryClose" bind:drawn="onLotteryDrawn" />

  <!-- 底部固定区域 -->
  <view class="bottom-fixed">
    <!-- 已报名：直接显示按钮，不需要折叠 -->
    <block wx:if="{{isRegistered}}">
      <view class="submit-btn-group">
        <van-button type="info" block bindtap="onViewRegistration">已报名，查看报名信息</van-button>
        <van-button plain type="default" block bindtap="onCancelSignUpClick" disabled="{{activityDetail.activityStarted}}" custom-class="cancel-btn">{{activityDetail.activityEnded ? '活动已结束' : activityDetail.activityStarted ? '活动已开始' : '取消报名'}}</van-button>
      </view>
    </block>

    <!-- 未报名：折叠式 -->
    <block wx:else>
      <!-- 折叠/展开切换栏 -->
      <view class="bottom-toggle" bindtap="toggleBottom" wx:if="{{!activityDetail.registrationClosed && !activityDetail.activityEnded}}">
        <view class="toggle-left">
          <van-icon name="{{bottomExpanded ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#5faee3" />
          <text class="toggle-text">{{bottomExpanded ? '收起' : '报名选项'}}</text>
          <view class="toggle-status" wx:if="{{!bottomExpanded}}">
            <text wx:if="{{canSignUp}}" class="status-ready">已就绪</text>
            <text wx:else class="status-pending">待同意须知</text>
          </view>
        </view>
        <text class="toggle-hint" wx:if="{{!bottomExpanded}}">点击展开</text>
      </view>

      <!-- 可折叠内容区 -->
      <view class="bottom-collapsible {{bottomExpanded ? 'expanded' : 'collapsed'}}" wx:if="{{!activityDetail.registrationClosed && !activityDetail.activityEnded}}">
        <view class="collapsible-inner">
          <!-- 同意条款区域 -->
          <view class="agree-section">
            <view class="agree-item">
              <van-checkbox value="{{agreeNotice}}" bindchange="onAgreeNoticeChange" shape="square" size="18px">
                <text class="agree-text">我已阅读并同意</text>
              </van-checkbox>
              <text class="notice-link" bindtap="onNoticeClick" data-type="participant">《报名参与者须知》</text>
            </view>

            <view class="agree-item" wx:if="{{activityDetail.travel && activityDetail.travel[0] === 'bus'}}">
              <van-checkbox value="{{agreeBus}}" bindchange="onAgreeBusChange" shape="square" size="18px">
                <text class="agree-text">我已阅读并同意</text>
              </van-checkbox>
              <text class="notice-link" bindtap="onNoticeClick" data-type="bus">《大巴行程免责声明》</text>
            </view>

            <view class="agree-item" wx:if="{{activityDetail.travel && (activityDetail.travel[0] === 'train'|| activityDetail.travel[1] === 'train' || activityDetail.travel[0] === 'self' || activityDetail.travel[1] === 'self' || activityDetail.travel[2] === 'self')}}">
              <van-checkbox value="{{agreeSelf}}" bindchange="onAgreeSelfChange" shape="square" size="18px">
                <text class="agree-text">我已阅读并同意</text>
              </van-checkbox>
              <text class="notice-link" bindtap="onNoticeClick" data-type="self">《自驾/高铁行程免责声明》</text>
            </view>
          </view>

          <!-- 同行人选择 -->
          <view class="companion-section" wx:if="{{activityDetail.rawStatus === 1 || activityDetail.rawStatus === 3}}">
            <view class="companion-label">
              <text class="companion-title">同行人数</text>
              <text class="companion-hint">不含本人，最多3人</text>
            </view>
            <van-stepper value="{{companionCount}}" min="0" max="{{maxCompanion}}" integer button-size="28px" bindchange="onCompanionChange" />
          </view>

          <!-- 保险提示 -->
          <view class="insurance-notice" wx:if="{{activityDetail.is_force_insurance == 1}}">
            <van-icon name="warning-o" size="14px" color="#e6a23c" />
            <text>参与本活动需要自行购买户外保险</text>
          </view>
        </view>
      </view>

      <!-- 报名按钮（始终显示） -->
      <view class="submit-btn">
        <van-button type="info" block bindtap="onSignUpClick" disabled="{{!canSignUp}}">
          <text wx:if="{{activityDetail.activityEnded}}">活动已结束</text>
          <text wx:elif="{{activityDetail.registrationClosed}}">活动报名已截止</text>
          <text wx:else>立即报名（{{companionCount + 1}}人）</text>
        </van-button>
      </view>
    </block>
  </view>

  <!-- 报名成功弹窗 -->
  <van-popup show="{{showSuccessPopup}}" bindclose="onSuccessPopupClose" round closeable close-icon="close" custom-style="width: 80%; max-width: 320px;">
    <view class="success-popup">
      <view class="success-icon">
        <van-icon name="checked" size="48px" color="#52c41a" />
      </view>
      <view class="success-title">报名成功</view>
      <view class="success-subtitle">请及时加入活动群联系发起人</view>
      
      <view class="companion-reminder" wx:if="{{registeredCompanionCount > 0}}">
        <van-icon name="friends-o" size="20px" color="#ff9800" />
        <view class="companion-reminder-text">
          <text class="companion-reminder-title">您报名时选择了 {{registeredCompanionCount}} 位同行人</text>
          <text class="companion-reminder-desc">请告知同行人活动信息，并将其拉入下方活动群</text>
        </view>
      </view>

      <view class="success-qr" wx:if="{{activityDetail.groupQR}}" bindtap="onPreviewGroupQR">
        <text class="success-label">活动群二维码</text>
        <image class="success-qr-image" src="{{activityDetail.groupQR}}" mode="aspectFit" />
        <text class="success-hint">点击查看大图，长按识别加群</text>
      </view>

      <view class="success-wechat" wx:if="{{activityDetail.wechat}}">
        <text class="success-label">发起人微信号</text>
        <view class="wechat-row">
          <text class="wechat-id">{{activityDetail.wechat}}</text>
          <van-button size="mini" type="info" plain custom-class="copy-wechat-btn" bindtap="onCopyWechat">复制</van-button>
        </view>
      </view>

      <view class="success-reminder-tip">活动开始前2天、抽奖开始时可收到微信提醒</view>
      <van-button type="info" block bindtap="onSubscribeActivityReminders" custom-class="success-close-btn">开启活动提醒</van-button>
      <van-button type="info" block bindtap="onSuccessPopupClose" custom-class="success-close-btn">我知道了</van-button>
    </view>
  </van-popup>
</view>
