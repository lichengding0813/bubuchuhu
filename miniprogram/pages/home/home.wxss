/* pages/home/home.wxss */
page {
  min-height: 100%;
  background: #f4f8fb;
  color: #173f63;
}

.home-page {
  min-height: 100vh;
  padding-bottom: 40px;
}

/* 品牌视觉区 */
.hero-shell {
  padding: 12px 14px 30px;
  background: linear-gradient(180deg, #e5f5ff 0%, #f4f8fb 100%);
}

.banner-section {
  position: relative;
}

.banner-image {
  width: 100%;
  overflow: hidden;
  border-radius: 22px;
  background: #d9ecf8;
  box-shadow: 0 12px 28px rgba(60, 123, 166, 0.14);
}

.banner-image image {
  display: block;
  width: 100%;
}

.banner-about {
  position: absolute;
  right: 12px;
  bottom: 12px;
  display: flex;
  align-items: center;
  gap: 3px;
  padding: 6px 10px;
  border: 1px solid rgba(255, 255, 255, 0.78);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.88);
  color: #315f80;
  font-size: 11px;
  box-shadow: 0 4px 12px rgba(36, 82, 112, 0.12);
}

/* 双快捷入口 */
.quick-actions {
  display: flex;
  gap: 12px;
  margin-top: -10px;
  padding: 0 16px 8px;
}

.quick-action {
  display: flex;
  flex: 1;
  min-width: 0;
  align-items: center;
  padding: 13px 10px;
  border-radius: 18px;
  box-sizing: border-box;
  box-shadow: 0 8px 20px rgba(44, 91, 124, 0.09);
}

.publish-action {
  color: #fff;
  background: linear-gradient(135deg, #65b9ec 0%, #3e8dcc 100%);
}

.calendar-action {
  border: 1px solid rgba(153, 190, 216, 0.38);
  color: #244f6d;
  background: #fff;
}

.quick-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  margin-right: 8px;
  border-radius: 13px;
}

.publish-icon {
  background: rgba(255, 255, 255, 0.2);
}

.calendar-icon {
  color: #4b9bd2;
  background: #eaf6fd;
}

.quick-copy {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.quick-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 1.45;
  white-space: nowrap;
}

.quick-arrow {
  flex-shrink: 0;
  margin-left: 3px;
  opacity: 0.65;
}

/* 活动发现与筛选 */
.activity-explore {
  padding-top: 8px;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 14px 18px 12px;
}

.section-title {
  margin-top: 0;
  color: #163f5d;
  font-size: 22px;
  font-weight: 700;
  line-height: 1.3;
}

.official-filter {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 7px 11px;
  border: 1px solid rgba(95, 174, 227, 0.32);
  border-radius: 16px;
  color: #5484a7;
  background: #fff;
  font-size: 11px;
  box-shadow: 0 4px 12px rgba(55, 106, 141, 0.06);
}

.official-filter.active {
  border-color: #4d9fd7;
  color: #fff;
  background: #4d9fd7;
}

.official-filter .official-mascot {
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
}

.mini-official-v {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  color: #fff;
  background: #5faee3;
  font-size: 9px;
  font-weight: 700;
}

.official-filter.active .mini-official-v {
  color: #4d9fd7;
  background: #fff;
}

.home-tabs {
  display: flex;
  gap: 4px;
  margin: 0 16px 16px;
  padding: 4px;
  border-radius: 18px;
  background: #e8eff5;
}

.home-tab {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 5px;
  padding: 10px 8px;
  border-radius: 14px;
  color: #7892a5;
  font-size: 14px;
  line-height: 1.2;
}

.home-tab.active {
  color: #234e6c;
  background: #fff;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(47, 90, 120, 0.09);
}

.tab-count {
  min-width: 15px;
  padding: 1px 5px;
  border-radius: 9px;
  box-sizing: border-box;
  color: #5d819b;
  background: #dce9f2;
  font-size: 9px;
  text-align: center;
}

.home-tab.active .tab-count {
  color: #fff;
  background: #67adde;
}

/* 活动列表 */
.list-section {
  padding: 0 16px;
}

.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 220px;
  color: #6e93ad;
}

.empty-container {
  display: flex;
  min-height: 220px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 28px 20px;
  border: 1px solid rgba(164, 196, 217, 0.3);
  border-radius: 24px;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 8px 22px rgba(46, 91, 122, 0.06);
}

.empty-icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82px;
  height: 82px;
  margin-bottom: 16px;
  border-radius: 50%;
  background: #edf6fb;
}

.empty-title {
  color: #426780;
  font-size: 15px;
  font-weight: 600;
}

.empty-hint {
  margin-top: 7px;
  color: #9aabb6;
  font-size: 12px;
}

.load-more {
  padding: 16px 0 22px;
  color: #92a6b4;
  text-align: center;
}

.load-more-text {
  font-size: 11px;
}

/* 活动卡片 */
.activity-card {
  position: relative;
  display: flex;
  gap: 13px;
  overflow: hidden;
  margin-bottom: 14px;
  padding: 12px;
  border: 1px solid rgba(157, 191, 214, 0.3);
  border-radius: 20px;
  box-sizing: border-box;
  background: #fff;
  box-shadow: 0 8px 22px rgba(44, 89, 120, 0.075);
  transition: transform 0.15s ease;
}

.activity-card:active {
  transform: scale(0.99);
}

.card-left {
  display: flex;
  flex: 0 0 98px;
  width: 98px;
  height: 104px;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 15px;
  background: linear-gradient(145deg, #e1f2fb 0%, #c8e4f4 100%);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.default-cover {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8px;
  color: #6993ae;
  background: linear-gradient(145deg, #eaf6fc 0%, #cae7f6 100%);
  font-size: 12px;
}

.default-cover-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-right {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.activity-name {
  display: -webkit-box;
  overflow: hidden;
  padding-right: 2px;
  color: #173f5c;
  font-size: 16px;
  font-weight: 600;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.activity-name.has-official-corner {
  padding-right: 64px;
}

.activity-name .activity-title-text {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 5px;
  margin-top: 8px;
}

.info-item {
  display: flex;
  min-width: 0;
  align-items: center;
  color: #738d9f;
  font-size: 11.5px;
  line-height: 1.35;
}

.info-item van-icon {
  flex-shrink: 0;
  margin-right: 5px;
  color: #79aace;
}

.info-item text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: auto;
  padding-top: 8px;
}

.card-meta {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
}

.meta-pill {
  padding: 3px 8px;
  border-radius: 12px;
  font-size: 9.5px;
  line-height: 1.35;
  white-space: nowrap;
}

.difficulty-pill {
  color: #a86627;
  background: #fff2df;
}

.capacity-pill {
  color: #4c83a8;
  background: #eaf5fc;
}

.capacity-pill.warning {
  color: #bf5c56;
  background: #fff0ee;
}

.status-badge {
  flex-shrink: 0;
  padding: 4px 9px;
  border-radius: 14px;
  color: #b56625;
  background: #fff0da;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
}

.status-badge.ongoing {
  color: #347ba9;
  background: #e1f2fd;
}

.status-badge.registered-badge {
  color: #35815a;
  background: #e2f5e9;
}

.status-badge.closed,
.status-badge.cancelled {
  color: #ac5651;
  background: #fbe8e7;
}

.status-badge.ended {
  color: #7b8992;
  background: #edf0f2;
}

.official-corner {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px 4px 5px;
  border-radius: 14px;
  color: #fff;
  background: linear-gradient(135deg, #62b3e8 0%, #327fbd 100%);
  font-size: 10px;
  font-weight: 600;
  box-shadow: 0 3px 9px rgba(42, 113, 163, 0.22);
}

.corner-v {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  color: #438bc1;
  background: #fff;
  font-size: 8px;
  font-weight: 700;
}

/* 首张活动使用沉浸式精选卡片 */
.featured-card {
  display: block;
  overflow: hidden;
  padding: 0;
  border-radius: 24px;
}

.featured-card .card-left {
  width: 100%;
  height: 190px;
  border-radius: 0;
}

.featured-card .card-right {
  padding: 15px 16px 16px;
}

.featured-card .activity-name {
  padding-right: 0;
  font-size: 18px;
  line-height: 1.4;
}

.featured-card .card-info {
  flex-flow: row wrap;
  gap: 7px 16px;
  margin-top: 9px;
}

.featured-card .info-item {
  max-width: 100%;
  font-size: 12px;
}

.featured-card .card-footer {
  padding-top: 12px;
}

.featured-card .official-corner {
  top: 14px;
  right: 14px;
}

.ended-card {
  opacity: 0.82;
}

.ended-card .cover-image {
  filter: grayscale(28%);
}

/* 回到顶部 */
.scroll-top-btn {
  position: fixed;
  right: 20px;
  bottom: 100px;
  z-index: 50;
  display: flex;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(108, 166, 205, 0.25);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 7px 20px rgba(35, 82, 113, 0.16);
}

/* ========== 自定义弹窗样式（蓝色主题） ========== */
.custom-dialog {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
}

.dialog-container {
  position: relative;
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(30, 110, 180, 0.3);
  z-index: 1001;
}

/* 弹窗顶部图片 */
.dialog-image {
  width: 50%;
  height: auto;
  display: block;
  border-radius: 32rpx;
  margin: 20rpx auto 20rpx auto;
}

.dialog-title {
  padding: 24rpx 24rpx 8rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1e4d7c;  /* 深蓝色标题 */
  text-align: center;
}

.dialog-content {
  padding: 0 32rpx 24rpx;
  align-items: center;
}

.question {
  font-size: 32rpx;
  color: #2e5a8a;
  margin-bottom: 24rpx;
  text-align: center;
  font-weight: 500;
}

.dialog-input {
  width: 100%;
  height: 80rpx;
  background-color: #f0f9ff;  /* 浅蓝色背景 */
  border-radius: 40rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  color: #1e3e60;
  box-sizing: border-box;
  border: 2rpx solid #c0e0ff;
  transition: border-color 0.2s;
}

.dialog-input:focus {
  border-color: #5faee3;  /* 聚焦时边框变深蓝 */
  background-color: #ffffff;
}

.error-tip {
  color: #ff6b6b;
  font-size: 26rpx;
  margin-top: 16rpx;
  text-align: center;
  font-weight: 400;
}

.plain-text {
  font-size: 28rpx;
  color: #2e5a8a;
  text-align: center;
  padding: 20rpx 0;
}

.lock-contact {
  color: #8aa1b5;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

.dialog-buttons {
  display: flex;
  border-top: 2rpx solid #d9ecff;
}

.dialog-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  cursor: pointer;
  transition: background-color 0.2s;
  font-weight: 500;
}

.dialog-btn-cancel {
  color: #7f8c8d;
  border-right: 2rpx solid #d9ecff;
  background-color: #f9fcff;
}

.dialog-btn-cancel:active {
  background-color: #e6f0fa;
}

.dialog-btn-confirm {
  color: #ffffff;
  background-color: #5faee3;  /* 蓝色确认按钮 */
}

.dialog-btn-confirm:active {
  background-color: #4a9ad0;
}

/* ========== 黑名单全屏遮罩 ========== */
.blacklist-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  z-index: 999;
  pointer-events: auto;
}
