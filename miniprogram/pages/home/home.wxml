<view class="home-page">
  <!-- 品牌视觉区 -->
  <view class="hero-shell">
    <view class="banner-section" bindtap="onAboutClick">
      <view class="banner-image">
        <image src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/banner.jpg" mode="widthFix" />
      </view>
      <view class="banner-about">
        <text>关于我们</text>
        <van-icon name="arrow" size="12px" />
      </view>
    </view>

  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="quick-action publish-action" bindtap="onPublishClick">
      <view class="quick-icon publish-icon">
        <van-icon name="plus" size="20px" />
      </view>
      <view class="quick-copy">
        <text class="quick-title">发起活动</text>
      </view>
      <van-icon name="arrow" size="15px" class="quick-arrow" />
    </view>

    <view class="quick-action calendar-action" bindtap="goToCalendar">
      <view class="quick-icon calendar-icon">
        <van-icon name="calendar-o" size="20px" />
      </view>
      <view class="quick-copy">
        <text class="quick-title">活动日历</text>
      </view>
      <van-icon name="arrow" size="15px" class="quick-arrow" />
    </view>
  </view>

  <!-- 活动发现 -->
  <view class="activity-explore">
    <view class="section-heading">
      <text class="section-title">发现活动</text>
    </view>

    <view class="home-tabs ui-tabs">
      <view class="home-tab ui-tab {{currentTab === 'ongoing' ? 'active' : ''}}" bindtap="switchTab" data-tab="ongoing">
        <text>近期活动</text>
        <text class="tab-count" wx:if="{{ongoingCount > 0}}">{{ongoingCount}}</text>
      </view>
      <view class="home-tab ui-tab {{currentTab === 'ended' ? 'active' : ''}}" bindtap="switchTab" data-tab="ended">
        <text>往期活动</text>
        <text class="tab-count" wx:if="{{endedCount > 0}}">{{endedCount}}</text>
      </view>
    </view>

    <view class="activity-filter-row">
      <view class="activity-filters">
        <view wx:if="{{currentTab === 'ongoing'}}" class="activity-filter {{filterAvailable ? 'active' : ''}}" bindtap="onToggleAvailable">可报名</view>
        <view class="activity-filter {{filterOfficial ? 'active' : ''}}" bindtap="onToggleOfficial">
          <image class="official-mascot official-mascot--tiny" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
          <text>官方</text>
        </view>
        <picker mode="selector" range="{{difficultyOptions}}" range-key="label" value="{{filterDifficultyIndex}}" bindchange="onDifficultyChange">
          <view class="activity-filter {{filterDifficulty !== '' ? 'active' : ''}}">
            <text>{{difficultyOptions[filterDifficultyIndex].label}}</text>
            <van-icon name="arrow-down" size="10px" />
          </view>
        </picker>
        <picker mode="date" fields="month" value="{{filterActivityMonth}}" bindchange="onActivityMonthChange">
          <view class="activity-filter {{filterActivityMonth ? 'active' : ''}}">
            <text>{{filterActivityMonthLabel || '月份'}}</text>
            <van-icon name="arrow-down" size="10px" />
          </view>
        </picker>
        <view class="activity-filter reset" wx:if="{{filterAvailable || filterOfficial || filterDifficulty !== '' || filterActivityMonth}}" bindtap="onResetActivityFilters">重置</view>
      </view>
    </view>
  </view>

  <!-- 活动列表 -->
  <view class="list-section">
    <ui-state wx:if="{{activityList.length === 0}}" loading="{{isLoading}}" error="{{loadError}}" empty="{{!isLoading && !loadError}}" empty-text="{{filterAvailable || filterDifficulty !== '' || filterActivityMonth ? '没有符合筛选的活动' : (filterOfficial ? '暂无官方活动' : '暂无活动')}}" icon="todo-list-o" bind:retry="onRetry" />
    <block wx:if="{{activityList.length}}">
      <view wx:for="{{activityList}}" wx:for-index="cardIndex" wx:key="id" class="activity-card {{cardIndex === 0 ? 'featured-card' : ''}} {{currentTab === 'ended' ? 'ended-card' : ''}}" data-id="{{item.id}}" bindtap="onActivityClick">
        <view class="card-left">
          <image class="cover-image" src="{{item.coverUrl}}" mode="aspectFill" wx:if="{{item.coverUrl}}" />
          <view class="default-cover" wx:else>
            <view class="default-cover-icon">
              <van-icon name="photo-o" size="{{cardIndex === 0 ? '40px' : '28px'}}" color="#7da9c8" />
            </view>
            <text wx:if="{{cardIndex === 0}}">一步步走过当时心愿</text>
          </view>
        </view>

        <view class="official-corner official-chip" wx:if="{{item.isOfficial}}">
          <image class="official-mascot official-mascot--tiny" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
          <text>官方</text>
        </view>

        <view class="card-right">
          <view class="activity-name activity-title-with-brand {{item.isOfficial ? 'has-official-corner' : ''}}">
            <text class="activity-title-text">{{item.name}}</text>
          </view>

          <view class="card-info">
            <view class="info-item">
              <van-icon name="clock-o" />
              <text>{{item.time}}</text>
            </view>
            <view class="info-item">
              <van-icon name="location-o" />
              <text>{{item.location}}</text>
            </view>
          </view>

          <view class="card-footer">
            <view class="card-meta">
              <text class="meta-pill difficulty-pill">{{item.difficulty}}</text>
              <text class="meta-pill capacity-pill {{item.remainCount < 5 ? 'warning' : ''}}" wx:if="{{!item.isEnded}}">余 {{item.remainCount}} / {{item.totalCount}}</text>
              <text class="meta-pill capacity-pill" wx:else>参与 {{item.participantCount}} 人</text>
            </view>
            <text class="status-badge {{item.has_registered && currentTab === 'ongoing' ? 'registered-badge' : item.statusClass}}">{{item.statusBadge}}</text>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{!isLoading && !loadError}}">
        <text wx:if="{{hasMore}}" class="load-more-text">继续上滑，发现更多</text>
        <text wx:else class="load-more-text">— 已经看到最后啦 —</text>
      </view>
      <ui-state loading="{{isLoading}}" error="{{loadError}}" compact bind:retry="onRetry" />
    </block>
  </view>
</view>

<!-- 回到顶部浮窗 -->
<view class="scroll-top-btn" wx:if="{{showScrollTop}}" bindtap="onScrollToTop">
  <van-icon name="back-top" size="20" color="#5faee3" />
</view>

<!-- ========== 验证题与提交确认 ========== -->
<verify-dialog show="{{showVerifyDialog}}" question="{{verifyQuestion}}" question-idx="{{verifyQuestionIdx}}" question-image="{{verifyQuestionImage}}" user-openid="{{userInfo.openId}}" bind:result="onVerificationResult" />

<!-- ========== 黑名单全屏遮罩 + 锁定弹窗 ========== -->
<view class="blacklist-mask" wx:if="{{isBlacklisted}}" catchtouchmove="preventTouchMove" bindtap="onMaskTap"></view>

<view class="custom-dialog" wx:if="{{showLockedDialog}}">
  <view class="dialog-mask" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-container">
    <view class="dialog-title">账户已锁定</view>
    <view class="dialog-content">
      <view class="plain-text">由于多次验证失败，您的账户已被锁定。</view>
      <view class="lock-contact">如有疑问，请联系微信：Galaxy79215</view>
    </view>
    <view class="dialog-buttons">
      <view class="dialog-btn dialog-btn-confirm" bindtap="onLockedConfirm">知道了</view>
    </view>
  </view>
</view>

<!-- 抽奖弹窗 -->
<lottery-popup show="{{showLotteryPopup}}" lotteryInfo="{{lotteryInfo}}" bind:close="onLotteryClose" bind:drawn="onLotteryDrawn" />
