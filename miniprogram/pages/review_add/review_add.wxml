<view class="new-container">
  <view class="form-card source-card" wx:if="{{mode === 'add'}}">
    <view class="card-title">
      <text>关联官方活动</text>
      <text class="required-tag">必选</text>
    </view>

    <view class="ui-select-trigger" bindtap="openActivityPicker">
      <text>{{selectedActivity ? selectedActivity.name : '请选择官方活动'}}</text><van-icon name="arrow-down" size="14px" />
    </view>
  </view>

  <view class="form-card">
    <view class="card-title">
      <text>回顾信息</text>
      <text class="imported-tip" wx:if="{{mode === 'add' && selectedActivity}}">已自动带入，可修改</text>
    </view>
    <view class="edit-field">
      <view class="edit-label">活动名称</view>
      <input class="edit-input" model:value="{{form.name}}" data-field="name" bindinput="onInput" placeholder="请输入活动名称" />
    </view>
    <view class="edit-field">
      <view class="edit-label">活动时间</view>
      <input class="edit-input" model:value="{{form.time}}" data-field="time" bindinput="onInput" placeholder="2025.03.20" />
    </view>
    <view class="edit-field">
      <view class="edit-label">活动地点</view>
      <input class="edit-input" model:value="{{form.location}}" data-field="location" bindinput="onInput" placeholder="杭州·西湖" />
    </view>
    <view class="edit-field">
      <view class="edit-label">难度</view>
      <input class="edit-input" model:value="{{form.difficulty}}" data-field="difficulty" bindinput="onInput" placeholder="中等" />
    </view>
    <view class="edit-row">
      <view class="edit-field half">
        <view class="edit-label">里程 (km)</view>
        <input class="edit-input" model:value="{{form.distance}}" data-field="distance" bindinput="onInput" type="digit" placeholder="0" />
      </view>
      <view class="edit-field half">
        <view class="edit-label">爬升 (m)</view>
        <input class="edit-input" model:value="{{form.climb}}" data-field="climb" bindinput="onInput" type="digit" placeholder="0" />
      </view>
    </view>
    <view class="edit-field">
      <view class="edit-label">参与人数</view>
      <input class="edit-input" model:value="{{form.participants}}" data-field="participants" bindinput="onInput" type="number" placeholder="0" />
    </view>
  </view>

  <view class="form-card">
    <view class="card-title">封面图</view>
    <view class="edit-field">
      <view class="edit-label">人合照</view>
      <view class="upload-area" bindtap="chooseCover" data-type="cover">
        <image wx:if="{{form.cover}}" src="{{form.cover}}" mode="aspectFill" class="uploaded-image"></image>
        <view wx:else class="upload-placeholder">
          <van-icon name="plus" /> 上传图片
        </view>
      </view>
    </view>
    <view class="edit-field">
      <view class="edit-label">卜合照</view>
      <view class="upload-area" bindtap="chooseCover" data-type="cover2">
        <image wx:if="{{form.cover2}}" src="{{form.cover2}}" mode="aspectFill" class="uploaded-image"></image>
        <view wx:else class="upload-placeholder">
          <van-icon name="plus" /> 上传图片
        </view>
      </view>
    </view>
    <view class="edit-field">
      <view class="edit-label">公益记录</view>
      <view class="upload-area" bindtap="chooseCover" data-type="cover3">
        <image wx:if="{{form.cover3}}" src="{{form.cover3}}" mode="aspectFill" class="uploaded-image"></image>
        <view wx:else class="upload-placeholder">
          <van-icon name="plus" /> 上传图片
        </view>
      </view>
    </view>
  </view>

  <view class="form-card">
    <view class="card-title">活动总结</view>
    <!-- 富文本工具栏 -->
    <view class="editor-toolbar">
      <view class="tool-btn {{formatStatus.bold ? 'active' : ''}}" catchtouchstart="onFormat" data-name="bold"><text class="tool-icon-bold">B</text></view>
      <view wx:for="{{fontSizeOptions}}" wx:key="value" class="tool-btn {{currentFontSize === item.value ? 'active' : ''}}" catchtouchstart="onSetFontSize" data-size="{{item.value}}">{{item.label}}</view>
      <view class="tool-btn" catchtouchstart="onInsertDivider">分割线</view>
    </view>
    <view class="editor-toolbar">
      <view wx:for="{{colorList}}" wx:key="*this" class="color-swatch-btn {{currentTextColor === item ? 'selected' : ''}}" style="background:{{item}}" catchtouchstart="onSetColor" data-color="{{item}}"></view>
    </view>

    <!-- 编辑器 -->
    <editor id="editor" class="ql-editor" placeholder="请输入活动总结" show-img-toolbar show-img-resize bindtouchstart="onEditorTouchStart" bind:focus="onEditorFocus" bind:blur="onEditorBlur" bind:ready="onEditorReady" bind:input="onEditorInput" bind:statuschange="onEditorStatusChange"></editor>
  </view>

  <view class="form-card">
    <view class="card-title">照片墙</view>
    <view class="photo-grid-form">
      <view wx:for="{{form.photos}}" wx:key="index" class="photo-item-form">
        <image src="{{item.url}}" mode="aspectFill" class="photo-img"></image>
        <van-icon name="delete" size="18" color="#ff4444" class="del-icon" bindtap="removePhoto" data-index="{{index}}" />
      </view>
      <view class="add-photo-btn" bindtap="addPhoto">+</view>
    </view>
  </view>

  <van-button type="info" block round loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit" custom-class="submit-btn">{{mode === 'edit' ? '保存修改' : '立即创建'}}</van-button>
</view>

<official-activity-picker show="{{showActivityPicker}}" options="{{officialActivities}}" selected-id="{{sourceActivityId || 0}}" loading="{{loadingActivities}}" error="{{activitiesError}}" empty-text="暂无可创建回顾的官方活动" bind:select="onSelectOfficialActivity" bind:close="closeActivityPicker" bind:retry="loadOfficialActivities" />
