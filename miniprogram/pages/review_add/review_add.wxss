/* pages/review_add/review_add.wxss */
page {
  background-color: #f0faff;
  padding-bottom: 60px;
}
/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 100rpx 16px 12px 16px;
  background-color: #f0faff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.new-container {
  padding: 0 16px 40px 16px;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 0;
  color: #1e4d7c;
  font-size: 16px;
}

.back-btn van-icon {
  margin-right: 4px;
  font-size: 18px;
}

.nav-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
}

.placeholder {
  width: 60px;
}

/* 表单卡片 */
.form-card {
  background-color: white;
  border-radius: 20px;
  padding: 20px 16px;
  margin-bottom: 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
  margin-bottom: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.required-star {
  color: #ff6b6b;
  margin-left: 4px;
}

/* ========== 新增：编辑模式下输入框样式 ========== */
.edit-field {
  margin-bottom: 16px;
}

.edit-label {
  font-size: 14px;
  color: #1e4d7c;
  font-weight: 500;
  margin-bottom: 6px;
}

.edit-input {
  width: 100%;
  background: #fafeff;
  border: 1px solid #e2edf7;
  border-radius: 12px;
  padding: 12px;           /* 上下左右内边距一致 */
  font-size: 14px;
  line-height: 1.4;        /* 明确行高，避免截断 */
  color: #134579;
  box-sizing: border-box;
  min-height: 44px;        /* 保证最小高度足够显示单行文本 */
  height: auto;            /* 高度自适应内容 */
}
.edit-input:focus {
  border-color: #5faee3;
}


.edit-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  background-color: #fafeff;
  color: #134579;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* ====== 富文本编辑器工具栏（顶部内联） ====== */
.editor-toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background-color: #f5faff;
  border-radius: 12px 12px 0 0;
  border: 1px solid #d8e8f5;
  border-bottom: none;
}

/* 第二行工具栏（颜色行）去掉顶部圆角和边框 */
.editor-toolbar + .editor-toolbar {
  border-radius: 0;
  border-top: none;
  padding-top: 4px;
}

.tool-picker {
  flex-shrink: 0;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 6px 10px;
  font-size: 13px;
  color: #5f7fa3;
  background-color: #fff;
  border-radius: 8px;
  border: 1px solid #e0e8f0;
  min-width: 32px;
  white-space: nowrap;
  flex-shrink: 0;
}

.tool-btn.active {
  background-color: #5faee3;
  color: #fff;
  border-color: #5faee3;
}

.tool-icon-bold {
  font-weight: 700;
  font-size: 14px;
}

.tool-vdivider {
  width: 1px;
  height: 24px;
  background-color: #d0dce8;
  margin: 0 4px;
  flex-shrink: 0;
}

.color-swatch-btn {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid #ddd;
  flex-shrink: 0;
}

.color-swatch-btn.selected {
  border-color: #5faee3;
  box-shadow: 0 0 0 2px rgba(95, 174, 227, 0.3);
}

/* 编辑器主体 */
.ql-editor {
  width: 100%;
  min-height: 300rpx;
  padding: 16px 12px;
  font-size: 15px;
  line-height: 1.6;
  background-color: #fff;
  border-radius: 0 0 12px 12px;
  border: 1px solid #d8e8f5;
  border-top: none;
  box-sizing: border-box;
}



.edit-row {
  display: flex;
  gap: 12px;
}

.edit-field.half {
  flex: 1;
}
/* ========== 新增样式结束 ========== */

/* 上传区域 */
.upload-area {
  width: 100px;
  height: 100px;
  background-color: #f0f7ff;
  border: 2px dashed #96c9ff;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #5faee3;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}

.upload-placeholder text {
  font-size: 12px;
}

.uploaded-image {
  width: 100%;
  height: 100%;
  border-radius: 10px;
}

/* 照片墙 */
.photo-grid-form {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 8px;
}

.photo-item-form {
  position: relative;
  width: calc(30.33% - 8px);
  aspect-ratio: 1 / 1;
  border-radius: 12px;
  overflow: hidden;
  background: #f0faff;
  border: 1px solid #e2edf7;
}

.photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.del-icon {
  position: absolute;
  top: 6px;
  right: 6px;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  padding: 4px;
  color: white !important;
}

.add-photo-btn {
  width: calc(30.33% - 8px);
  aspect-ratio: 1 / 1;
  background: #fafeff;
  border: 1px dashed #b7daf9;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #5faee3;
}

/* 提交按钮区域 */
.submit-section {
  background-color: white;
  border-radius: 20px 20px 0 0;
  padding: 16px;
  margin-top: 16px;
  border: 1px solid rgba(160, 200, 255, 0.4);
  box-shadow: 0 -4px 12px rgba(0, 130, 210, 0.04);
}

.submit-btn {
  margin-top: 0;
  overflow: hidden;
  height: 48px !important;
  border-radius: 24px !important;
  font-weight: 600 !important;
  --button-info-background-color: #4d9fd7;
  --button-info-border-color: #4d9fd7;
}

.submit-btn van-button {
  border-radius: 24px !important;
  height: 48px !important;
  line-height: 48px !important;
  font-weight: 600 !important;
}

/* 日期选择器头部 */
.date-picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.date-picker-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

/* 添加按钮样式 */
.add-btn {
  display: flex;
  align-items: center;
  color: #5faee3;
  font-size: 14px;
  padding: 4px 8px;
  background-color: rgba(95, 174, 227, 0.1);
  border-radius: 16px;
}
/* 官方活动导入 */
.source-card {
  border-color: rgba(78, 158, 214, 0.34);
  background: linear-gradient(145deg, #f3faff 0%, #ffffff 70%);
}

.required-tag {
  padding: 4px 9px;
  border-radius: 12px;
  color: #fff;
  background: #4d9fd7;
  font-size: 10px;
  font-weight: 500;
}

.source-trigger,
.selected-source {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px;
  border: 1px solid #d8eaf6;
  border-radius: 16px;
  background: #fff;
  box-sizing: border-box;
}

.source-trigger-icon,
.selected-source-placeholder {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border-radius: 14px;
  background: #eaf6fd;
}

.source-trigger-copy,
.selected-source-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.source-trigger-title {
  color: #215777;
  font-size: 14px;
  font-weight: 600;
}

.source-trigger-desc {
  margin-top: 4px;
  color: #8aa1b2;
  font-size: 10.5px;
  line-height: 1.45;
}

.selected-source-cover {
  flex-shrink: 0;
  width: 58px;
  height: 58px;
  border-radius: 14px;
  background: #eaf3f8;
}

.selected-source-title {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
  color: #1c4d70;
  font-size: 14px;
  font-weight: 600;
}

.selected-source-title > text:last-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.official-v {
  display: inline-flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  color: #fff;
  background: #4d9fd7;
  font-size: 9px;
  font-weight: 700;
}

.selected-source-meta,
.selected-source-hint {
  overflow: hidden;
  margin-top: 4px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selected-source-meta {
  color: #6c899d;
  font-size: 11px;
}

.selected-source-hint {
  color: #4d9fd7;
  font-size: 10px;
}

.imported-tip {
  color: #6c9fbe;
  font-size: 10.5px;
  font-weight: 400;
}

.field-help {
  margin: -1px 0 8px;
  color: #7898ae;
  font-size: 10.5px;
}

/* 官方活动选择器 */
.source-picker {
  height: 100%;
  padding: 22px 16px 0;
  box-sizing: border-box;
  background: #f6f9fb;
}

.source-picker-header {
  display: flex;
  padding: 0 36px 14px 2px;
  flex-direction: column;
}

.source-picker-title {
  color: #173f5c;
  font-size: 19px;
  font-weight: 700;
}

.source-picker-subtitle {
  margin-top: 4px;
  color: #8a9eac;
  font-size: 11px;
}

.source-search {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 42px;
  padding: 0 14px;
  margin-bottom: 12px;
  border: 1px solid #dfeaf1;
  border-radius: 21px;
  box-sizing: border-box;
  background: #fff;
}

.source-search-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  color: #28536f;
  font-size: 13px;
}

.source-picker-loading,
.source-picker-empty {
  display: flex;
  height: calc(74vh - 150px);
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #829dad;
  font-size: 13px;
}

.source-picker-empty {
  gap: 10px;
}

.source-picker-empty-hint {
  color: #a4b3bd;
  font-size: 10.5px;
}

.source-list {
  height: calc(74vh - 150px);
}

.source-list-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 12px;
  margin-bottom: 10px;
  border: 1px solid rgba(166, 197, 217, 0.34);
  border-radius: 17px;
  background: #fff;
  box-shadow: 0 5px 14px rgba(45, 90, 120, 0.055);
}

.source-list-cover,
.source-list-placeholder {
  flex-shrink: 0;
  width: 62px;
  height: 62px;
  border-radius: 13px;
  background: #e9f4fa;
}

.source-list-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.source-list-info {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.source-list-title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7px;
}

.source-list-title {
  flex: 1;
  overflow: hidden;
  color: #214b67;
  font-size: 13.5px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-status {
  flex-shrink: 0;
  padding: 3px 7px;
  border-radius: 10px;
  color: #4280a8;
  background: #e7f4fc;
  font-size: 9px;
}

.source-list-meta,
.source-list-stats {
  overflow: hidden;
  margin-top: 5px;
  color: #7890a1;
  font-size: 10.5px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-list-stats {
  color: #91a4b0;
}
