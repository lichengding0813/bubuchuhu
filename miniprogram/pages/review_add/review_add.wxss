/* ========== 新增：编辑模式下输入框样式 ========== */
.edit-field {
  margin-bottom: 16px;
}

.edit-label {
  font-size: 14px;
  color: #1e4d7c;
  font-weight: 500;
  margin-bottom: 6px;
}

.edit-input {
  width: 100%;
  background: #fafeff;
  border: 1px solid #e2edf7;
  border-radius: 12px;
  padding: 12px;           /* 上下左右内边距一致 */
  font-size: 14px;
  line-height: 1.4;        /* 明确行高，避免截断 */
  color: #134579;
  box-sizing: border-box;
  min-height: 44px;        /* 保证最小高度足够显示单行文本 */
  height: auto;            /* 高度自适应内容 */
}
.edit-input:focus {
  border-color: #5faee3;
}


.edit-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
  background-color: #fafeff;
  color: #134579;
  border-radius: 16rpx;
  box-sizing: border-box;
  font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
}

/* ====== 富文本编辑器底部固定工具栏 ====== */
.editor-toolbar-fixed {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background-color: #fff;
  box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.08);
  padding-bottom: env(safe-area-inset-bottom);
  transform: translateY(100%);
  transition: transform 0.25s ease;
  opacity: 0;
  pointer-events: none;
}

.editor-toolbar-fixed.show {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.tool-picker {
  flex-shrink: 0;
}

.editor-toolbar-inner {
  display: flex;
  flex-wrap: nowrap;
  overflow-x: auto;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  -webkit-overflow-scrolling: touch;
}

.editor-toolbar-inner::-webkit-scrollbar {
  display: none;
}

.tool-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  padding: 6px 10px;
  font-size: 13px;
  color: #5f7fa3;
  background-color: #f5faff;
  border-radius: 8px;
  border: 1px solid #e0e8f0;
  min-width: 32px;
  white-space: nowrap;
  flex-shrink: 0;
}

.tool-btn.active {
  background-color: #5faee3;
  color: #fff;
  border-color: #5faee3;
}

.tool-icon-bold {
  font-weight: 700;
  font-size: 14px;
}

.tool-vdivider {
  width: 1px;
  height: 24px;
  background-color: #d0dce8;
  margin: 0 4px;
  flex-shrink: 0;
}

.tool-icon-size {
  font-size: 13px;
}

.color-btn {
  display: flex;
  align-items: center;
  gap: 4px;
}

.color-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid #ddd;
}

/* 子面板（字号/颜色） */
.sub-panel {
  display: flex;
  gap: 10px;
  padding: 8px 12px 10px;
  border-top: 1px solid #eef2f6;
  align-items: center;
}

.sub-panel-item {
  padding: 6px 14px;
  font-size: 13px;
  color: #5f7fa3;
  background-color: #f5faff;
  border-radius: 8px;
  border: 1px solid #e0e8f0;
}

.sub-panel-item.selected {
  background-color: #5faee3;
  color: #fff;
  border-color: #5faee3;
}

.color-swatch {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 2px solid #ddd;
}

.color-swatch.selected {
  border-color: #5faee3;
  box-shadow: 0 0 0 2px rgba(95, 174, 227, 0.3);
}

/* 编辑器主体 */
.ql-editor {
  width: 100%;
  min-height: 300rpx;
  padding: 16px 12px;
  font-size: 15px;
  line-height: 1.6;
  background-color: #fff;
  border-radius: 12px;
  border: 1px solid #d8e8f5;
  box-sizing: border-box;
}



.edit-row {
  display: flex;
  gap: 12px;
}

.edit-field.half {
  flex: 1;
}
