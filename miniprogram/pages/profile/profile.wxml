<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card" bindtap="onLoginClick">
    <view class="user-avatar-wrap">
      <view class="user-avatar">
        <open-data type="userAvatarUrl" wx:if="{{!userInfo.avatarUrl}}"></open-data>
        <image src="{{userInfo.avatarUrl}}" wx:else mode="aspectFill"></image>
      </view>
      <image class="profile-official-v" wx:if="{{userInfo.isAdmin === 1 || userInfo.isOfficial === 1}}" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
    </view>
    <view class="user-info">
      <view class="user-name-row">
        <text class="user-name">{{userInfo.nickName || '点击登录'}}</text>
      </view>
      <!-- 在用户信息卡片中的 user-badge 部分 -->
      <view class="user-badge" wx:if="{{userInfo.isLogin}}">
        <view class="badge-item verified" wx:if="{{userInfo.verified}}">
          <van-icon name="passed" class="verified-icon" />
          <text>已认证</text>
        </view>
        <view class="badge-item" wx:else>
          <text>未认证</text>
        </view>
        <view class="badge-item phone" wx:if="{{userInfo.phoneNumber}}">
          <van-icon name="phone-o" class="phone-icon" />
          <text>已绑定</text>
        </view>
        <view class="badge-item official" wx:if="{{userInfo.isAdmin === 1 || userInfo.isOfficial === 1}}">
          <text>{{userInfo.isAdmin === 1 ? '超级管理员' : '官方账号'}}</text>
        </view>
      </view>
    </view>
    <!-- <van-icon name="arrow" class="arrow-icon" /> -->
  </view>

  <!-- 统计数据 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="goToCreatedActivities">
      <text class="stat-number">{{stats.created}}</text>
      <text class="stat-label">我发起的</text>
    </view>
    <view class="stat-item" bindtap="goToJoinedActivities">
      <text class="stat-number">{{stats.joined}}</text>
      <text class="stat-label">我报名的</text>
    </view>
  </view>

  <!-- 收藏中心：飘带墙与成就中心并列，各占一半 -->
  <view class="collection-card">
    <view class="collection-entry ribbon-collection" data-url="/pages/ribbon-wall/ribbon-wall" bindtap="onCollectionEntryTap">
      <view class="collection-visual ribbon-visual">
        <view class="mini-ribbon-strip strip-one"></view>
        <view class="mini-ribbon-strip strip-two"></view>
        <view class="mini-ribbon-strip strip-three"></view>
      </view>
      <text class="collection-title">我的飘带墙</text>
      <text class="collection-count">{{ribbonLitCount}} / {{ribbonTotal || 0}} 已点亮</text>
      <view class="collection-arrow"><van-icon name="arrow" size="14px" /></view>
    </view>
    <view class="collection-entry achievement-collection" data-url="/pages/achievement-center/achievement-center" bindtap="onCollectionEntryTap">
      <view class="collection-visual achievement-visual"><text>★</text></view>
      <text class="collection-title">成就中心</text>
      <text class="collection-count">{{achievementUnlocked}} / {{achievementTotal || 6}} 已获得</text>
      <view class="collection-arrow"><van-icon name="arrow" size="14px" /></view>
    </view>
  </view>

  <!-- 菜单列表 -->
  <view class="menu-list">
    <block wx:for="{{menuList}}" wx:key="index">
      <view wx:if="{{item.isDivider}}" class="menu-divider"></view>
      <view wx:else class="menu-item" data-index="{{index}}" bindtap="onMenuClick">
        <view class="menu-left">
          <van-icon name="{{item.icon}}" class="menu-icon" />
          <text>{{item.text}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-right-text" wx:if="{{item.rightText}}">{{item.rightText}}</text>
          <view class="menu-badge" wx:if="{{item.showRedDot}}">{{item.badgeCount}}</view>
          <van-icon name="arrow" class="menu-arrow" />
        </view>
      </view>
    </block>
  </view>

  <!-- 底部版本号 -->
  <view class="version-section">
    <view class="version-toggle" bindtap="goToUpdateLog">
      <text class="version-text">当前版本 v{{appVersion}}</text>
      <van-icon name="arrow" size="14" color="#999" />
    </view>
  </view>
</view>

<!-- ========== 验证题与提交确认 ========== -->
<verify-dialog show="{{showVerifyDialog}}" question="{{verifyQuestion}}" question-idx="{{verifyQuestionIdx}}" question-image="{{verifyQuestionImage}}" user-openid="{{userInfo.openId}}" bind:result="onVerificationResult" />

<!-- ========== 黑名单全屏遮罩 + 锁定弹窗 ========== -->
<view class="blacklist-mask" wx:if="{{isBlacklisted}}" catchtouchmove="preventTouchMove" bindtap="onMaskTap"></view>
<view class="custom-dialog" wx:if="{{showLockedDialog}}">
  <view class="dialog-mask" catchtouchmove="preventTouchMove"></view>
  <view class="dialog-container">
    <view class="dialog-title">账户已锁定</view>
    <view class="dialog-content">
      <view class="plain-text">{{lockedMessage}}</view>
      <view class="lock-contact">如有疑问，请联系微信：Galaxy79215</view>
    </view>
    <view class="dialog-buttons">
      <view class="dialog-btn dialog-btn-confirm" bindtap="onLockedConfirm">知道了</view>
    </view>
  </view>
</view>
