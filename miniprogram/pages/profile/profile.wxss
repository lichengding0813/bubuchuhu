/* pages/profile/profile.wxss */
page {
  background-color: #f0faff;
}

.profile-container {
  padding: 16px;
}

.user-card {
  display: flex;
  align-items: center;
  background-color: white;
  border-radius: 20px;
  padding: 20px 16px;
  margin-bottom: 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.user-avatar {
  width: 60px;
  height: 60px;
  border-radius: 30px;
  overflow: hidden;
  margin-right: 16px;
  background-color: #e3f0ff;
}

.user-avatar image, .user-avatar open-data {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 18px;
  font-weight: 600;
  color: #134579;
  margin-bottom: 4px;
}

.user-desc {
  font-size: 13px;
  color: #5f7fa3;
}

.arrow-icon {
  color: #96c9ff;
  font-size: 16px;
}

.stats-card {
  display: flex;
  background-color: white;
  border-radius: 20px;
  padding: 20px 0;
  margin-bottom: 16px;
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-number {
  font-size: 22px;
  font-weight: 600;
  color: #1e4d7c;
  margin-bottom: 4px;
}

.stat-label {
  font-size: 12px;
  color: #5f7fa3;
}

.menu-list {
  background-color: white;
  border-radius: 20px;
  padding: 8px 0;
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #e6f0ff;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  margin-right: 12px;
  color: #5faee3;
  font-size: 18px;
}

.menu-left text {
  font-size: 15px;
  color: #2e4d73;
}

.menu-arrow {
  color: #96c9ff;
  font-size: 14px;
}
