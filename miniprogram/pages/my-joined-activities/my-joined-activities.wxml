<view class="hike-stats-card">
  <view class="hike-stats-row" wx:if="{{!statsError}}">
    <view class="hike-stat"><text class="hike-stat-number">{{statsReady ? hikeStats.total_activities : '—'}}</text><text class="hike-stat-label">累计活动</text></view>
    <view class="hike-stat"><text class="hike-stat-number">{{statsReady ? hikeStats.total_distance : '—'}}</text><text class="hike-stat-label">累计里程(km)</text></view>
    <view class="hike-stat"><text class="hike-stat-number">{{statsReady ? hikeStats.total_climb : '—'}}</text><text class="hike-stat-label">累计爬升(m)</text></view>
  </view>
  <ui-state wx:if="{{statsError}}" error="{{statsError}}" compact bind:retry="loadHikeStats" />
</view>

<view class="list-section">
  <view class="section-header">
    <text class="section-title">我报名的活动</text>
    <view class="filter-tabs ui-tabs">
      <text class="tab ui-tab {{currentTab === 'ongoing' ? 'active' : ''}}" bindtap="switchTab" data-tab="ongoing">进行中 {{ongoingCount}}</text>
      <text class="tab ui-tab {{currentTab === 'ended' ? 'active' : ''}}" bindtap="switchTab" data-tab="ended">已结束 {{endedCount}}</text>
    </view>
  </view>

  <ui-state loading="{{isLoading}}" error="{{loadError}}" empty="{{currentList.length === 0}}" empty-text="{{currentTab === 'ongoing' ? '暂无进行中活动' : '暂无已结束活动'}}" icon="todo-list-o" bind:retry="loadData" />
  <block wx:if="{{!isLoading && !loadError}}">
  <!-- 活动卡片 -->
  <view wx:for="{{currentList}}" wx:key="id" class="activity-card" bindtap="onActivityClick" data-id="{{item.activity_id}}">
    <view class="card-header">
      <view class="activity-name activity-title-with-brand">
        <text class="activity-title-text">{{item.name}}</text>
      </view>
      <view class="official-badge official-chip" wx:if="{{item.is_official == 1}}">
        <image class="official-mascot official-mascot--tiny" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
        <text>官方</text>
      </view>
      <view wx:if="{{item.activity_status === 5}}" class="status-badge ended">已取消</view>
    </view>

    <view class="card-content">
      <view class="info-row">
        <van-icon name="user-o" />
        <text>发起人：{{item.creator_name || '未知'}}</text>
        <image class="official-mascot official-mascot--tiny" wx:if="{{item.is_official == 1}}" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
      </view>
      <view class="info-row">
        <van-icon name="clock-o" />
        <text>活动时间：{{item.activity_time_formatted}}</text>
      </view>
      <view class="info-row">
        <van-icon name="location-o" />
        <text>地点：{{item.location}}</text>
      </view>
      <view class="info-row">
        <van-icon name="certificate" />
        <text>需要购买保险：{{item.is_force_insurance === 1 ? '是' : '否'}}</text>
      </view>
    </view>

    <view class="card-footer">
      <button class="detail-btn" data-id="{{item.activity_id}}" catchtap="onActivityClick">查看详情</button>
    </view>
  </view>
  </block>
</view>
