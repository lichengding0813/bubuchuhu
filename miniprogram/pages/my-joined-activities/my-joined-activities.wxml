<wxs module="activityUtil" src="../../utils/activity.wxs" />

<!-- 统计卡片（可选，直接显示进行中/已结束数量） -->
<view class="stats-section">
  <view class="stat-card">
    <view class="stat-number">{{ongoingCount}}</view>
    <view class="stat-label">进行中</view>
  </view>
  <view class="stat-card">
    <view class="stat-number">{{endedCount}}</view>
    <view class="stat-label">已结束</view>
  </view>
</view>

<!-- 活动列表 -->
<view class="list-section">
  <view class="section-header">
    <text class="section-title">我报名的活动</text>
    <view class="filter-tabs">
      <text class="tab {{currentTab === 'ongoing' ? 'active' : ''}}" bindtap="switchTab" data-tab="ongoing">进行中</text>
      <text class="tab {{currentTab === 'ended' ? 'active' : ''}}" bindtap="switchTab" data-tab="ended">已结束</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{isLoading}}" class="loading-container">
    <van-loading size="40px" vertical>加载中...</van-loading>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{currentList.length === 0}}" class="empty-container">
    <van-icon name="todo-list-o" size="80" color="#ccc" />
    <text class="empty-text">暂无{{currentTab === 'ongoing' ? '进行中' : '已结束'}}活动</text>
  </view>

  <!-- 活动卡片 -->
  <view wx:for="{{currentList}}" wx:key="id" class="activity-card" bindtap="onActivityClick" data-id="{{item.activity_id}}">
    <view class="card-header">
      <view class="activity-name activity-title-with-brand">
        <image class="activity-brand-mascot" wx:if="{{activityUtil.hasBubuchuhuPrefix(item.name)}}" src="/images/official-badge.png" mode="aspectFit" />
        <text class="activity-title-text">{{item.name}}</text>
      </view>
      <view class="official-badge official-chip" wx:if="{{item.is_official == 1}}">
        <image class="official-mascot official-mascot--tiny" src="/images/official-badge.png" mode="aspectFit" />
        <text>官方</text>
      </view>
      <!-- <view class="status-badge {{item.activity_status === 3 ? 'ongoing' : 'ended'}}">
        {{item.activity_status === 3 ? '进行中' : '已结束'}}
      </view> -->
    </view>

    <view class="card-content">
      <view class="info-row">
        <van-icon name="user-o" />
        <text>发起人：{{item.creator_name || '未知'}}</text>
        <image class="official-mascot official-mascot--tiny" wx:if="{{item.is_official == 1}}" src="/images/official-badge.png" mode="aspectFit" />
      </view>
      <view class="info-row">
        <van-icon name="clock-o" />
        <text>活动时间：{{item.activity_time_formatted}}</text>
      </view>
      <view class="info-row">
        <van-icon name="location-o" />
        <text>地点：{{item.location}}</text>
      </view>
      <view class="info-row">
        <van-icon name="certificate" />
        <text>需要购买保险：{{item.is_force_insurance === 1 ? '是' : '否'}}</text>
      </view>
    </view>

    <view class="card-footer">
      <button class="detail-btn" data-id="{{item.activity_id}}" catchtap="onActivityClick">查看详情</button>
    </view>
  </view>
</view>
