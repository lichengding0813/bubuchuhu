/* pages/my-joined-activities/my-joined-activities.wxss */
page {
  background-color: #e6f7ff;
  height: 100%;
  overflow-y: auto;
}

/* 统计卡片区域 */
.stats-section {
  display: flex;
  padding: 32px 16px;
  gap: 12px;
  margin-bottom: 16px;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #ffffff 0%, #f5faff 100%);
  border-radius: 16px;
  padding: 16px;
  text-align: center;
  box-shadow: 0 4px 12px rgba(0, 110, 200, 0.08);
  border: 1px solid rgba(95, 174, 227, 0.2);
}

.stat-number {
  font-size: 32px;
  font-weight: bold;
  color: #5faee3;
  line-height: 1.2;
}

.stat-label {
  font-size: 14px;
  color: #7a9ec2;
  margin-top: 8px;
}

/* 列表区域 */
.list-section {
  padding: 0 16px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding: 0 4px;
}

.section-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
  position: relative;
  padding-left: 12px;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4px;
  bottom: 4px;
  width: 4px;
  background-color: #5faee3;
  border-radius: 4px;
}

.filter-tabs {
  display: flex;
  gap: 12px;
}

.tab {
  font-size: 14px;
  color: #7a9ec2;
  padding: 4px 8px;
  border-radius: 20px;
  transition: all 0.2s;
}

.tab.active {
  color: #5faee3;
  background-color: #e3f0ff;
  font-weight: 500;
}

/* 加载状态 */
.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60px 0;
}

.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
}

.empty-text {
  color: #7a9ec2;
  font-size: 14px;
  margin-top: 16px;
}

/* 活动卡片 */
.activity-card {
  background-color: white;
  border-radius: 18px;
  margin-bottom: 14px;
  padding: 16px;
  box-shadow: 0 4px 12px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #e8f0f8;
}

.activity-name {
  font-size: 16px;
  font-weight: 600;
  color: #134579;
  flex: 1;
}

.official-badge {
  padding: 4px 10px;
  border-radius: 20px;
  color: #fff;
  background-color: #2f80c5;
  font-size: 12px;
  font-weight: 500;
}

.inline-official-v {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  margin-left: 4px;
  border-radius: 50%;
  color: #fff;
  background-color: #2f80c5;
  font-size: 9px;
  font-weight: 700;
}

/* 状态徽章 - 进行中/已结束 */
.status-badge {
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 500;
}

.status-badge.ongoing {
  background-color: #e3f0ff;
  color: #5faee3;
}

.status-badge.ended {
  background-color: #f5f5f5;
  color: #9e9e9e;
}

/* 卡片内容 */
.card-content {
  margin-bottom: 16px;
}

.info-row {
  display: flex;
  align-items: flex-start;
  font-size: 13px;
  color: #5f7fa3;
  margin-bottom: 8px;
  line-height: 1.4;
}

.info-row van-icon {
  margin-right: 8px;
  font-size: 14px;
  color: #77b0e0;
  flex-shrink: 0;
  margin-top: 2px;
}

/* 卡片底部按钮 */
.card-footer {
  margin-top: 8px;
}

.detail-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  height: 36px;
  padding: 0;
  line-height: 1;
  background: linear-gradient(135deg, #5faee3 0%, #4a9ad0 100%);
  color: white;
  border-radius: 30px;
  font-size: 14px;
  font-weight: 500;
  border: none;
}

.detail-btn::after {
  border: none;
}

.detail-btn:active {
  background: linear-gradient(135deg, #4a9ad0 0%, #3a8abe 100%);
}

/* 强制保险标识（可选，若需要单独样式） */
.insurance-badge {
  display: inline-flex;
  align-items: center;
  background-color: #f0f9ff;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 11px;
  color: #5faee3;
  margin-left: 8px;
}
