/* pages/about/about.wxss */
page {
  background-color: #f0faff;
}

.about-container {
  min-height: 90vh;
  padding-bottom: 30px;
  background-color: #f4f8fb;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  padding-top: calc(12px + constant(safe-area-inset-top));
  padding-top: calc(12px + env(safe-area-inset-top));
  background-color: #f4f8fb;
  position: sticky;
  top: 0;
  z-index: 100;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 8px 0;
  color: #1e4d7c;
  font-size: 16px;
}

.back-btn van-icon {
  margin-right: 4px;
  font-size: 18px;
}

.nav-title {
  font-size: 18px;
  font-weight: 600;
  color: #1e4d7c;
}

.placeholder {
  width: 60px;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30px 0 10px 0;
}

.logo-circle {
  width: 80px;
  height: 80px;
  border-radius: 40px;
  background: linear-gradient(145deg, #96c9ff, #b3dcff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12px;
  box-shadow: 0 6px 16px rgba(0, 140, 233, 0.2);
}

.logo-text {
  font-size: 40px;
}

.app-name {
  font-size: 24px;
  font-weight: 700;
  color: #1e4d7c;
  margin-bottom: 4px;
}

.app-slogan {
  font-size: 14px;
  color: #5f7fa3;
  letter-spacing: 2px;
}

/* 内容卡片 */
.content-card {
  background-color: white;
  border-radius: 20px;
  padding: 15px 15px;
  margin-top: 10px;
  box-shadow: 0 -4px 20px rgba(0, 130, 210, 0.08);
  border: 1px solid rgba(160, 200, 255, 0.4);
}

.content-card image {
  width: 100%;
}

/* 副标题样式 */
.subtitle {
  font-size: 20px;
  font-weight: 700;
  color: #1e4d7c;
  margin: 0 0 24px 0 !important;
  display: block !important;
  background-color: #e6f7ff;
  padding: 12px 16px !important;
  border-radius: 12px;
  border-left: 6px solid #96c9ff;
  text-align: center;
}

/* 段落样式 */
.para {
  margin-bottom: 24px;
  font-size: 15px;
  line-height: 1.8;
  color: #2e4d73;
  word-break: break-word;
}

.para text {
  display: inline;
  white-space: normal;
}

/* 高亮样式 */
.highlight {
  color: #f5222d !important;
  font-weight: 600 !important;
  background-color: transparent !important;
}

/* 最后一行的特殊样式 */
/* 最后一行的对话气泡布局 */
.final-message {
  margin: 10px 0;
  padding: 0;
  background: transparent;
  border: none;
  width: 100%;
}

.final-message.left {
  display: flex;
  justify-content: flex-start;
}

.final-message.right {
  display: flex;
  justify-content: flex-end;
}

.message-bubble {
  max-width: 70%;
  padding: 12px 18px;
  border-radius: 20px;
  position: relative;
  word-break: break-word;
  display: inline-block;
}

.final-message.left .message-bubble {
  background-color: #e6f7ff;
  border: 1px solid #96c9ff;
  border-bottom-left-radius: 4px;
}

.final-message.right .message-bubble {
  background-color: #fff9e6;
  border: 1px solid #ffd966;
  border-bottom-right-radius: 4px;
}

.message-bubble .big-text {
  font-size: 16px;
  font-weight: 600;
  color: #1e4d7c;
  display: inline;
  background: none;
  padding: 0;
  border: none;
  white-space: normal;
  line-height: 1.5;
}

/* 添加小三角形，更像气泡 */
.final-message.left .message-bubble::after {
  content: '';
  position: absolute;
  left: -8px;
  bottom: 8px;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 0 10px 10px 0;
  border-color: transparent #e6f7ff transparent transparent;
  filter: drop-shadow(-1px 1px 0 #96c9ff);
}

.final-message.right .message-bubble::after {
  content: '';
  position: absolute;
  right: -8px;
  bottom: 8px;
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10px 10px 0 0;
  border-color: #fff9e6 transparent transparent transparent;
  filter: drop-shadow(1px 1px 0 #ffd966);
}

/* 分隔线 */
.divider {
  height: 1px;
  background: linear-gradient(to right, transparent, #96c9ff, transparent);
  margin: 30px 0 20px 0;
}

/* 联系方式 */
.contact-section {
  margin-bottom: 24px;
}

.contact-title {
  font-size: 16px;
  font-weight: 600;
  color: #1e4d7c;
  margin-bottom: 16px;
  display: block;
}

.contact-item {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  padding: 8px 12px;
  background-color: #f8fcff;
  border-radius: 30px;
  color: #2e4d73;
}

.contact-item van-icon {
  margin-right: 10px;
  color: #96c9ff;
  font-size: 18px;
}

/* 版本信息 */
.version-info {
  text-align: center;
  color: #a0c4e2;
  font-size: 12px;
  margin-top: 10px;
}
