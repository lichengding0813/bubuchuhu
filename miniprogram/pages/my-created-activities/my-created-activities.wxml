<!-- 统计卡片 -->
<view class="stats-section">
  <view class="stat-card">
    <view class="stat-number">{{approvedCount}}</view>
    <view class="stat-label">已通过</view>
  </view>
  <view class="stat-card">
    <view class="stat-number">{{pendingCount}}</view>
    <view class="stat-label">待审核</view>
  </view>
  <view class="stat-card">
    <view class="stat-number">{{draftCount}}</view>
    <view class="stat-label">草稿箱</view>
  </view>
</view>

<!-- 活动列表 -->
<view class="list-section">
  <view class="section-header">
    <text class="section-title">我的活动</text>
    <view class="filter-tabs ui-tabs">
      <text class="tab ui-tab {{currentTab === 'approved' ? 'active' : ''}}" bindtap="switchTab" data-tab="approved">已通过</text>
      <text class="tab ui-tab {{currentTab === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-tab="pending">待审核</text>
      <text class="tab ui-tab {{currentTab === 'draft' ? 'active' : ''}}" bindtap="switchTab" data-tab="draft">草稿箱</text>
    </view>
  </view>

  <ui-state loading="{{currentTab === 'draft' ? draftLoading : isLoading}}" error="{{currentTab === 'draft' ? draftError : loadError}}" empty="{{currentTab === 'draft' ? draftList.length === 0 : activityList.length === 0}}" empty-text="{{currentTab === 'draft' ? '暂无草稿' : '暂无活动'}}" bind:retry="onRetry" />
  <block wx:if="{{currentTab === 'draft' ? !draftLoading && !draftError : !isLoading && !loadError}}">
  <!-- 草稿箱列表 -->
  <block wx:if="{{currentTab === 'draft'}}">
    <view wx:for="{{draftList}}" wx:key="id" class="activity-card draft-card">
      <view class="card-header">
        <view class="activity-name activity-title-with-brand">
          <text class="activity-title-text">{{item.name || '未命名活动'}}</text>
        </view>
        <view class="card-badges">
          <view class="official-badge official-chip" wx:if="{{item.is_official == 1}}">
            <image class="official-mascot official-mascot--tiny" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
            <text>官方</text>
          </view>
          <view class="status-badge draft">草稿</view>
        </view>
      </view>

      <view class="card-content">
        <view class="info-row" wx:if="{{item.activity_time}}">
          <van-icon name="clock-o" />
          <text>活动时间：{{item.activity_time_formatted}}</text>
        </view>
        <view class="info-row" wx:if="{{item.location}}">
          <van-icon name="location-o" />
          <text>地点：{{item.location}}</text>
        </view>
        <view class="info-row">
          <van-icon name="underway-o" />
          <text>最后编辑：{{item.updated_at_formatted}}</text>
        </view>
        <view class="info-row">
          <van-icon name="certificate" />
          <text>需要购买保险：{{item.is_force_insurance === 1 ? '是' : '否'}}</text>
        </view>
      </view>

      <view class="card-footer">
        <button class="edit-btn" data-id="{{item.id}}" catchtap="onEditDraft">编辑草稿</button>
        <button class="delete-btn" data-id="{{item.id}}" catchtap="onDeleteDraft">删除</button>
      </view>
    </view>
  </block>

  <!-- 活动卡片 -->
  <block wx:else>
    <view wx:for="{{activityList}}" wx:key="id" class="activity-card" bindtap="onActivityClick" data-id="{{item.id}}">
      <view class="card-header">
        <view class="activity-name activity-title-with-brand">
          <text class="activity-title-text">{{item.name}}</text>
        </view>
        <view class="card-badges">
          <view class="official-badge official-chip" wx:if="{{item.is_official == 1}}">
            <image class="official-mascot official-mascot--tiny" src="cloud://prod-3gktwx67d1dd1e76.7072-prod-3gktwx67d1dd1e76-1392222183/official-badge.png" mode="aspectFit" />
            <text>官方</text>
          </view>
          <view class="status-badge {{item.status === 0 ? 'pending' : (item.status === 1 ? 'approved' : (item.status === 2 ? 'rejected' : (item.status === 3 ? 'ongoing' : 'ended')))}}">
            {{item.status === 0 ? '待审核' : (item.status === 1 ? '已通过' : (item.status === 2 ? '已驳回' : (item.status === 3 ? '进行中' : (item.status === 5 ? '已取消' : '已结束'))))}}
          </view>
        </view>
      </view>

      <view class="card-content">
        <view class="info-row">
          <van-icon name="clock-o" />
          <text>活动时间：{{item.activity_time_formatted}}</text>
        </view>
        <view class="info-row">
          <van-icon name="location-o" />
          <text>地点：{{item.location}}</text>
        </view>
        <view class="info-row">
          <van-icon name="user-o" />
          <text>{{item.status === 4 ? '参与人数：' + item.participant_count : '报名人数：' + item.participant_count + ' / ' + item.max_participants}}</text>
        </view>
        <view class="info-row">
          <van-icon name="certificate" />
          <text>需要购买保险：{{item.is_force_insurance === 1 ? '是' : '否'}}</text>
        </view>
      </view>

      <!-- 驳回原因（仅驳回状态显示） -->
      <view class="reject-reason-section" wx:if="{{item.status === 2 && item.reject_reason}}">
        <view class="reject-reason">
          <van-icon name="warning-o" size="14" color="#ff6b6b" />
          <text class="reject-reason-label">驳回原因：</text>
          <text class="reject-reason-text">{{item.reject_reason}}</text>
        </view>
      </view>

      <!-- 卡片底部按钮区域 -->
      <view class="card-footer">
        <block wx:if="{{item.status === 0}}">
          <button class="detail-btn" data-id="{{item.id}}" catchtap="onActivityClick">查看详情</button>
          <button class="edit-btn" data-id="{{item.id}}" catchtap="onEditActivity">编辑信息</button>
          <button class="delete-btn" data-id="{{item.id}}" catchtap="onWithdraw">撤回</button>
        </block>

        <block wx:elif="{{item.status === 2}}">
          <button class="edit-btn" data-id="{{item.id}}" catchtap="onEditActivity">编辑信息</button>
        </block>

        <block wx:elif="{{item.status === 1 || item.status === 3}}">
          <button class="delete-btn" data-id="{{item.id}}" catchtap="onCancelActivity" disabled="{{cancellingActivityId !== null}}" loading="{{cancellingActivityId === item.id}}">取消活动</button>
          <button class="edit-btn" data-id="{{item.id}}" catchtap="onEditActivity">编辑信息</button>
          <button class="participants-btn" data-id="{{item.id}}" catchtap="onViewParticipants">报名人员</button>
        </block>

        <block wx:else>
          <button class="detail-btn" data-id="{{item.id}}" catchtap="onActivityClick">查看详情</button>
        </block>
      </view>
    </view>
  </block>
  </block>
</view>
