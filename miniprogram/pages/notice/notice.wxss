page {
  background-color: #f0faff;
}

.notice-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.custom-nav {
  flex-shrink: 0;
  background-color: #e6f7ff;
  display: flex;
  align-items: center;
}

.custom-nav-back {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.custom-nav-title {
  flex: 1;
  height: 44px;
  line-height: 44px;
  font-size: 17px;
  font-weight: 600;
  color: #1e4d7c;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.custom-nav-placeholder {
  width: 44px;
  height: 44px;
  flex-shrink: 0;
}

.notice-container {
  flex: 1;
  min-height: 0;
  padding: 20px 16px;
  box-sizing: border-box;
}

.notice-footer {
  flex-shrink: 0;
  padding: 12px 16px;
  padding-bottom: calc(12px + constant(safe-area-inset-bottom));
  padding-bottom: calc(12px + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.04);
  border-top: 1px solid #e8f0f8;
}

.notice-back-btn {
  border-radius: 8px !important;
  height: 46px !important;
  line-height: 46px !important;
  font-weight: 500 !important;
}

.notice-back-btn.van-button--disabled {
  --button-info-background-color: #c4d4e6;
  --button-info-border-color: #c4d4e6;
  --button-disabled-opacity: 1;
  color: #ffffff;
}

.notice-back-btn:not(.van-button--disabled) {
  --button-info-background-color: #1989fa;
  --button-info-border-color: #1989fa;
}

.notice-container text {
  display: inline;
  white-space: normal;
  word-wrap: break-word;
}

.notice-container .para {
  margin-bottom: 20px;
  word-break: break-word;
}

.subtitle {
  font-size: 18px;
  font-weight: 700;
  color: #1e4d7c;
  margin: 16px 0 20px 0 !important;
  display: block !important;
  background-color: #e6f7ff;
  padding: 8px 12px !important;
  border-radius: 8px;
  border-left: 4px solid #96c9ff;
}

.subtitle-light {
  font-size: 16px;
  font-weight: 600;
  color: #2e4d73;
  margin: 12px 0 12px 0 !important;
  display: block !important;
  padding-left: 8px;
  border-left: 3px solid #96c9ff;
}

.highlight {
  color: #f5222d !important;
  font-weight: 700 !important;
  background-color: transparent !important;
}

.notice-bottom-spacer {
  height: 40px;
}

/* 下拉提示悬浮条 */
.scroll-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-shrink: 0;
  padding: 10px 0;
  background: linear-gradient(180deg, rgba(240,250,255,0.95), rgba(255,255,255,0.98));
  border-top: 1px solid rgba(95,174,227,0.15);
  font-size: 13px;
  color: #5faee3;
  opacity: 1;
  transition: opacity 0.3s ease;
}

.scroll-hint.hidden {
  opacity: 0;
  pointer-events: none;
}
