<!-- 活动日历 -->
<view class="calendar-container">
  <!-- 月份切换 -->
  <view class="month-header">
    <view class="month-arrow" bindtap="prevMonth"><van-icon name="arrow-left" /></view>
    <text class="month-title">{{year}}年{{month}}月</text>
    <view class="month-arrow" bindtap="nextMonth"><van-icon name="arrow-right" /></view>
  </view>

  <!-- 星期表头 -->
  <view class="week-header">
    <text wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="week-day">{{item}}</text>
  </view>

  <!-- 日期网格 -->
  <view class="date-grid">
    <view wx:for="{{days}}" wx:key="*this" class="date-cell {{item.isEmpty ? 'empty' : ''}} {{item.isToday ? 'today' : ''}} {{item.hasActivity ? 'has-activity' : ''}}" bindtap="{{item.isEmpty ? '' : 'onDateTap'}}" data-date="{{item.dateStr}}">
      <text class="date-num">{{item.day}}</text>
      <view class="date-dot" wx:if="{{item.hasActivity}}"></view>
    </view>
  </view>

  <!-- 当天活动列表 -->
  <view class="day-activities" wx:if="{{selectedDate}}">
    <view class="day-title">{{selectedDate}} 活动</view>
    <view wx:if="{{dayActivities.length === 0}}" class="empty-text">当天暂无活动</view>
    <view wx:for="{{dayActivities}}" wx:key="id" class="day-card" bindtap="onActivityClick" data-id="{{item.id}}">
      <text class="day-name">{{item.name}}</text>
      <text class="day-location">{{item.location}}</text>
    </view>
  </view>
</view>
